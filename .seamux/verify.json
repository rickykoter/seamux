{ "recipes": [
  { "id": "scrub", "kind": "test",
    "run": "python3 tools/scrub_check.py",
    "match": ["**"], "default": true },
  { "id": "plugin-validate", "kind": "test",
    "run": "claude plugin validate . && for p in deep-plan restack bash-guard crew seamux-mods; do claude plugin validate \"$p\" || exit 1; done",
    "match": [".claude-plugin/**", "*/.claude-plugin/**", "*/hooks/hooks.json", "*/hooks/*.tsx"], "default": true },
  { "id": "deep-plan-probe", "kind": "test",
    "run": "node deep-plan/probe.mjs",
    "match": ["deep-plan/*.mjs", "deep-plan/lib/**", "deep-plan/hooks/**", "deep-plan/bin/**",
              "deep-plan/examples/**", "deep-plan/verify/**"], "default": true },
  { "id": "restack-probe", "kind": "test",
    "run": "node restack/probe.mjs",
    "match": ["restack/*.mjs", "restack/lib/**", "restack/hooks/**", "restack/bin/**"], "default": true },
  { "id": "board-probe", "kind": "test",
    "run": "node crew/board/board_probe.mjs",
    "match": ["crew/board/**", "crew/bin/crew-color", "crew/bin/crew-overlay", "crew/config/**"], "default": true },
  { "id": "typesafe-probe", "kind": "test",
    "run": "python3 crew/hooks/typesafe_probe.py",
    "match": ["crew/hooks/typesafe.py", "crew/hooks/asked.py", "crew/hooks/typesafe_probe.py"], "default": true },
  { "id": "sidebar-render", "kind": "test",
    "run": "python3 crew/tools/render_probe.py crew/sidebars/crew.swift \"${TMPDIR:-/tmp}/crew-sidebar-ir.json\"",
    "match": ["crew/sidebars/**", "crew/tools/render_probe.py"], "default": true,
    "note": "needs the cmux app installed: it renders through the app's interpreter worker, and fails only when nothing renders" },
  { "id": "seamux-mods-test", "kind": "test",
    "run": "claude plugin test seamux-mods",
    "match": ["seamux-mods/**"], "default": true },
  { "id": "seamux-mods-tsc", "kind": "test",
    "run": "cp -R \"$(ls -d ~/.claude/plugins/cache/seamux/seamux-mods/*/ | sort -V | tail -1).claude-plugin/types\" seamux-mods/.claude-plugin/ && npx -y -p typescript@5 tsc -p seamux-mods",
    "match": ["seamux-mods/**"], "default": true }
] }
