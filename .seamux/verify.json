{ "recipes": [
  { "id": "scrub", "kind": "test",
    "run": "python3 tools/scrub_check.py",
    "match": ["**"], "default": true },
  { "id": "plugin-validate", "kind": "test",
    "run": "claude plugin validate . && for p in deep-plan restack bash-guard crew seamux-mods lookout; do claude plugin validate \"$p\" || exit 1; done",
    "match": [".claude-plugin/**", "*/.claude-plugin/**", "*/hooks/hooks.json", "*/hooks/*.tsx"], "default": true },
  { "id": "deep-plan-probe", "kind": "test",
    "run": "node deep-plan/probe.mjs",
    "match": ["deep-plan/*.mjs", "deep-plan/lib/**", "deep-plan/hooks/**", "deep-plan/bin/**",
              "deep-plan/examples/**", "deep-plan/verify/**"], "default": true },
  { "id": "restack-probe", "kind": "test",
    "run": "node restack/probe.mjs",
    "match": ["restack/*.mjs", "restack/lib/**", "restack/hooks/**", "restack/bin/**"], "default": true },
  { "id": "lookout-probe", "kind": "test",
    "run": "node lookout/probe.mjs",
    "match": ["lookout/*.mjs", "lookout/lib/**", "lookout/hooks/**", "lookout/bin/**", "lookout/page/**"], "default": true },
  { "id": "board-probe", "kind": "test",
    "run": "node crew/board/board_probe.mjs",
    "match": ["crew/board/**", "crew/bin/crew-color", "crew/bin/crew-overlay", "crew/config/**"], "default": true },
  { "id": "typesafe-probe", "kind": "test",
    "run": "python3 crew/hooks/typesafe_probe.py",
    "match": ["crew/hooks/typesafe.py", "crew/hooks/asked.py", "crew/hooks/typesafe_probe.py"], "default": true },
  { "id": "family-sync", "kind": "test",
    "run": "python3 crew/tools/family_sync_probe.py",
    "match": ["crew/bin/crew-sync", "crew/bin/crew-color", "crew/tools/family_sync_probe.py",
              "crew/tools/fakecmux.py", "deep-plan/tools/family-fixture.sh"], "default": true },
  { "id": "family-live", "kind": "e2e", "tier": "expensive",
    "run": "bash deep-plan/tools/live-family.sh",
    "match": ["deep-plan/hooks/**", "deep-plan/lib/family.mjs", "deep-plan/tools/**"], "default": false,
    "note": "two short headless Claude sessions (haiku): proves the family hooks reach a real model; needs claude logged in. Name it in a deliverable's checks when hook delivery changes" },
  { "id": "sidebar-render", "kind": "test",
    "run": "python3 crew/tools/render_probe.py crew/sidebars/crew.swift \"${TMPDIR:-/tmp}/crew-sidebar-ir.json\"",
    "match": ["crew/sidebars/**", "crew/tools/render_probe.py"], "default": true,
    "note": "needs the cmux app installed: it renders through the app's interpreter worker, and fails only when nothing renders" },
  { "id": "seamux-mods-test", "kind": "test",
    "run": "claude plugin test seamux-mods",
    "match": ["seamux-mods/**"], "default": true },
  { "id": "skill-evals-probe", "kind": "test",
    "run": "python3 tools/skill_evals_probe.py",
    "match": ["tools/skill_evals.py", "tools/skill_evals_probe.py"], "default": true },
  { "id": "skill-lint-probe", "kind": "test",
    "run": "python3 tools/skill_lint_probe.py",
    "match": ["tools/skill_lint.py", "tools/skill_lint_probe.py"], "default": true },
  { "id": "skill-lint", "kind": "test",
    "run": "python3 tools/skill_lint.py",
    "match": ["*/SKILL.md", "*/references/**", "tools/skill_lint.py", ".github/workflows/**"], "default": true,
    "note": "every plugin's root SKILL.md and references at once, as CI runs it" },
  { "id": "evals-deep-plan", "kind": "test", "tier": "expensive",
    "run": "python3 tools/skill_evals.py compare deep-plan --model opus --model haiku",
    "match": ["deep-plan/SKILL.md", "deep-plan/references/**", "deep-plan/evals/**"], "default": false,
    "note": "claude plugin eval against the committed baseline in deep-plan/evals/baseline; costs real model spend and needs claude logged in" },
  { "id": "evals-restack", "kind": "test", "tier": "expensive",
    "run": "python3 tools/skill_evals.py compare restack --model opus --model haiku",
    "match": ["restack/SKILL.md", "restack/references/**", "restack/evals/**"], "default": false,
    "note": "claude plugin eval against the committed baseline in restack/evals/baseline; costs real model spend and needs claude logged in" },
  { "id": "evals-lookout", "kind": "test", "tier": "expensive",
    "run": "python3 tools/skill_evals.py compare lookout --model opus --model haiku",
    "match": ["lookout/SKILL.md", "lookout/references/**", "lookout/evals/**"], "default": false,
    "note": "claude plugin eval against the committed baseline in lookout/evals/baseline; costs real model spend and needs claude logged in" },
  { "id": "seamux-mods-tsc", "kind": "test",
    "run": "cp -R \"$(ls -d ~/.claude/plugins/cache/seamux/seamux-mods/*/ | sort -V | tail -1).claude-plugin/types\" seamux-mods/.claude-plugin/ && npx -y -p typescript@5 tsc -p seamux-mods",
    "match": ["seamux-mods/**"], "default": true }
] }
