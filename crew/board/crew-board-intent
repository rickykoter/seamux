class Handler(http.server.BaseHTTPRequestHandler):
    def send_header(self, keyword, value):
        super().send_header(keyword, value)
        # Every page says who may frame it, as the Rust server's do: this
        # server itself and the seamux app, not any site.
        if keyword.lower() == "content-type" and str(value).lower().startswith("text/html"):
            port = self.server.server_address[1]
            super().send_header("Content-Security-Policy", "frame-ancestors " + " ".join(
                ["'self'", "http://127.0.0.1:%d" % port, "http://localhost:%d" % port, "tauri://localhost", "tauri:"] +
                parent_origins()[1:]))

    server_version = "crew-board-intent"
    token = ""

    def log_message(self, *_args):
        pass                      # our own log() is the record; stderr is noise

    def _reply(self, code, body=b""):
        self.send_response(code)
        # The page is served from file://, so its origin is "null" and even a
        # simple GET is cross-origin. Without this the fetch is blocked before
        # it is sent. A GET with no custom headers needs no preflight.
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if body:
            self.wfile.write(body)

    def _json(self, code, obj):
        """A JSON reply WITHOUT the open CORS header _reply sends: review data is
        for the page this server served, not for any origin that asks."""
        body = json.dumps(obj).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _review_get(self, rest, token):
        if rest.endswith(".json"):
            if not secrets.compare_digest(token, self.token):
                log("DENY bad token on /review json from %s" % self.client_address[0])
                return self._json(403, {"error": "bad token"})
            page = review_path(rest[:-len(".json")], ".json")
            if not page:
                return self._json(404, {"error": "no such review"})
            with open(page, "rb") as fh:
                body = fh.read()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            return self.wfile.write(body)
        page = review_path(rest, ".html")
        if not page:
            return self._json(404, {"error": "no such review"})
        try:
            html = open(page, encoding="utf-8", errors="replace").read()
        except OSError as exc:
            return self._json(500, {"error": str(exc)})
        boot = REVIEW_JS.replace("__TOKEN__", self.token).replace("__ID__", rest)
        i = html.rfind("</body>")
        html = html[:i] + boot + html[i:] if i >= 0 else html + boot
        body = html.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        return self.wfile.write(body)

    def _host_ok(self):
        """Refuse any Host but this server's own loopback name and port. DNS
        rebinding points attacker.example at 127.0.0.1, which makes its page
        same-origin with this server; the served pages embed the token, so that
        page could read one. The Host header still names attacker.example."""
        port = self.server.server_address[1]
        if self.headers.get("Host") in ("127.0.0.1:%d" % port, "localhost:%d" % port):
            return True
        log("DENY host %r" % self.headers.get("Host"))
        self._json(403, {"error": "unknown host"})
        return False

    def do_POST(self):
        if not self._host_ok():
            return
        u = urllib.parse.urlparse(self.path)
        if not (u.path.startswith("/review/") or u.path in ("/artifacts/keep", "/artifacts/publish")):
            return self._json(404, {"error": "no such path"})
        body = self._post_body(u.path)
        if body is None:
            return
        if u.path == "/artifacts/keep":
            return self._keep(body)
        if u.path == "/artifacts/publish":
            rid = body.get("id")
            if isinstance(rid, bool) or not isinstance(rid, int):
                return self._json(400, {"error": "bad id"})
            try:
                ok, detail = publish_artifact(rid)
            except Exception as exc:
                ok, detail = False, "publish failed: %s" % exc
            log("%s artifacts publish %s: %s" % ("OK  " if ok else "FAIL", rid, detail))
            return self._json(200 if ok else 400, {"ok": ok, "detail": detail})
        rid = u.path[len("/review/"):]
        if not review_path(rid, ".json"):
            return self._json(404, {"error": "no such review"})
        code, out = review_apply(rid, body)
        log("%s review %s %s %s" % ("OK  " if code == 200 else "FAIL", rid, body.get("op"), out.get("error", out.get("item", ""))))
        return self._json(code, out)

    def _post_body(self, path):
        """Every POST's guards, in order: an Origin that is this server's own,
        a JSON body under the cap, and the token inside it. Returns the body,
        or None after replying with the refusal."""
        port = self.server.server_address[1]
        if self.headers.get("Origin") not in ("http://127.0.0.1:%d" % port, "http://localhost:%d" % port):
            log("DENY POST %s from origin %r" % (path, self.headers.get("Origin")))
            self._json(403, {"error": "cross-origin request refused"})
            return None
        ctype = (self.headers.get("Content-Type") or "").split(";")[0].strip().lower()
        if ctype != "application/json":
            self._json(415, {"error": "JSON only"})
            return None
        try:
            length = int(self.headers.get("Content-Length") or "-1")
        except ValueError:
            length = -1
        if length < 0:
            self._json(411, {"error": "length required"})
            return None
        if length > REVIEW_MAX_BODY:
            self.close_connection = True
            self._json(413, {"error": "too large"})
            return None
        try:
            body = json.loads(self.rfile.read(length) or b"{}")
        except ValueError:
            self._json(400, {"error": "not JSON"})
            return None
        if not isinstance(body, dict):
            self._json(400, {"error": "not a JSON object"})
            return None
        if not secrets.compare_digest(str(body.get("t") or ""), self.token):
            log("DENY bad token on POST %s from %s" % (path, self.client_address[0]))
            self._json(403, {"error": "bad token"})
            return None
        return body

    def _keep(self, body):
        """POST /artifacts/keep {t, id} | {t, ws, all: true}. A row id or a
        workspace; never a path."""
        try:
            if body.get("all") is True:
                ws = body.get("ws")
                if not isinstance(ws, str) or not ws:
                    return self._json(400, {"error": "no workspace"})
                res = artifacts.keep_all(ws)
                log("OK   artifacts keep all %s: %d kept, %d refused" % (
                    ws, sum(1 for r in res if r["ok"]), sum(1 for r in res if not r["ok"])))
                return self._json(200, {"ok": True, "results": res})
            rid = body.get("id")
            if isinstance(rid, bool) or not isinstance(rid, int):
                return self._json(400, {"error": "bad id"})
            res = artifacts.keep(rid)
        except Exception as exc:
            log("FAIL artifacts keep: %s" % exc)
            return self._json(500, {"error": "keep failed: %s" % exc})
        log("%s artifacts keep %s: %s" % ("OK  " if res["ok"] else "FAIL", rid, res.get("path") or res.get("why")))
        return self._json(200 if res["ok"] else 400, res)

    def _plan(self, slug):
        """Serve a plan's live surface, with its buttons wired.

        The HTML on disk renders every control `disabled`, because as a file it
        genuinely cannot act -- it has no origin and no token. Serving is what
        makes it live, so the transport is injected here rather than written into
        the file: the generator emits meaning (data-a, data-n) and the server
        supplies the ability.
        """
        page = plan_asset(slug)
        if not page:
            return self._reply(404, b'{"error":"no such plan page"}')
        try:
            html = open(page, encoding="utf-8", errors="replace").read()
        except OSError as exc:
            return self._reply(500, json.dumps({"error": str(exc)}).encode())
        # The markdown source is linked from the pages too. Served as text, which
        # is what opening it as a file did.
        if page.endswith(".md"):
            body = html.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            return self.wfile.write(body)
        # A review page inlines mermaid as 3.4MB of base64, because as a lone
        # shareable file it has to. Served from an origin that already hosts
        # mermaid, that copy is pure weight -- so it is swapped for the shared URL
        # on the way out. The file on disk is untouched, which matters: the review
        # page is what `--rehydrate` must reproduce byte for byte.
        html, swapped = MERMAID_DATA.subn('src="/mermaid.min.js"', html, count=1)
        boot = PLAN_JS.replace("__TOKEN__", self.token).replace("__SLUG__", slug)
        if "</body>" in html:
            html = html.replace("</body>", boot + "</body>", 1)
        else:
            html += boot
        body = html.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        # Never cached: the tracker rewrites this file on every transition, and a
        # cached plan surface is a plan surface that lies.
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        return self.wfile.write(body)

    def do_GET(self):
        if not self._host_ok():
            return
        u = urllib.parse.urlparse(self.path)
        q = urllib.parse.parse_qs(u.query)
        one = lambda k: (q.get(k) or [""])[0]

        if u.path == "/board":
            try:
                html = open(BOARD_HTML, encoding="utf-8", errors="replace").read()
                scripts = ("<script>\n" + open(RENDER_JS, encoding="utf-8").read() + "\n</script>\n" +
                           "<script>\n" + open(INTENT_JS, encoding="utf-8").read() + "\n</script>\n")
            except OSError as exc:
                return self._json(500, {"error": str(exc)})
            boot = scripts + BOARD_JS.replace("__TOKEN__", self.token).replace(
                "__PORT__", str(self.server.server_address[1])).replace(
                "__PARENTS__", json.dumps(parent_origins()))
            html = html.replace("</body>", boot + "</body>", 1) if "</body>" in html else html + boot
            body = html.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            return self.wfile.write(body)

        if u.path == "/board/events":
            if not secrets.compare_digest(one("t"), self.token):
                log("DENY bad token on /board/events from %s" % self.client_address[0])
                return self._json(403, {"error": "bad token"})
            # A reader that stops reading (a suspended tab) ends its stream after
            # 30s of a blocked write, rather than holding the worker up for ever.
            self.connection.settimeout(30)
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            q = BOARD_FEED.subscribe()
            try:
                self.wfile.write(b"retry: 3000\n\n")
                self.wfile.flush()
                while True:
                    line = BOARD_FEED.wait(q, 15)
                    if line is None:
                        self.wfile.write(b": ping\n\n")
                    else:
                        self.wfile.write(("event: state\ndata: %s\n\n" % line).encode("utf-8"))
                    self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError, OSError):
                pass
            finally:
                BOARD_FEED.unsubscribe(q)
            return

        if u.path == "/health":
            return self._reply(200, b'{"ok":true}')

        # One cached copy for every plan page, instead of 3.4MB of base64 in each.
        # Unauthenticated on purpose: it is a public library file, the token is for
        # things that DO something, and requiring it here would mean putting the
        # token in a <script src> and therefore in the page's URL bar.
        if u.path == "/mermaid.min.js":
            try:
                body = open(dp_engine.mermaid(), "rb").read()
            except OSError:
                return self._reply(404, b'{"error":"no vendored mermaid"}')
            self.send_response(200)
            self.send_header("Content-Type", "text/javascript; charset=utf-8")
            self.send_header("Cache-Control", "public, max-age=31536000, immutable")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            return self.wfile.write(body)

        if u.path == "/usage":
            try:
                tmpl = open(USAGE_TMPL, encoding="utf-8").read()
            except OSError as exc:
                return self._reply(500, json.dumps({"error": str(exc)}).encode())
            # The template is read per request on purpose: editing the dashboard
            # should not need a server restart. Only the script's placeholder is
            # filled (the header comment names it too), and < > & are \u-escaped:
            # a workspace title holding "</script>" must not end the data block.
            data = (json.dumps(usage_data()).replace("<", "\\u003c")
                    .replace(">", "\\u003e").replace("&", "\\u0026"))
            body = tmpl.replace(USAGE_SLOT, USAGE_SLOT.replace("__DATA__", data)).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            return self.wfile.write(body)

        if u.path.startswith("/plan/"):
            return self._plan(u.path[len("/plan/"):])

        if u.path == "/plan-stamp":
            page = plan_asset(one("slug"))
            try:
                mt = int(os.path.getmtime(page)) if page else 0
            except OSError:
                mt = 0
            return self._reply(200, json.dumps({"mtime": mt}).encode())

        if u.path == "/open":
            if not secrets.compare_digest(one("t"), self.token):
                log("DENY bad token on /open from %s" % self.client_address[0])
                return self._reply(403, b'{"error":"bad token"}')
            ok, detail = open_file(one("slug"), one("path"))
            log("%s open %s" % ("OK  " if ok else "FAIL", detail))
            return self._reply(200 if ok else 500,
                               json.dumps({"ok": ok, "detail": detail}).encode())

        if u.path.startswith("/review/"):
            return self._review_get(u.path[len("/review/"):], one("t"))

        if u.path.startswith("/ask/"):
            page = ask_path(u.path[len("/ask/"):], ".html")
            if not page:
                return self._reply(404, b'{"error":"no such ask"}')
            try:
                html = open(page, encoding="utf-8", errors="replace").read()
            except OSError as exc:
                return self._reply(500, json.dumps({"error": str(exc)}).encode())
            html, _ = MERMAID_DATA.subn('src="/mermaid.min.js"', html, count=1)
            boot = ASK_JS.replace("__TOKEN__", self.token).replace("__ID__", u.path[len("/ask/"):])
            html = html.replace("</body>", boot + "</body>", 1) if "</body>" in html else html + boot
            body = html.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            return self.wfile.write(body)

        if u.path == "/answer":
            if not secrets.compare_digest(one("t"), self.token):
                log("DENY bad token on /answer from %s" % self.client_address[0])
                return self._reply(403, b'{"error":"bad token"}')
            ok, delivered, detail = answer(one("id"), one("n"))
            log("%s answer %s: %s" % ("OK  " if ok else "FAIL", one("id"), detail))
            return self._reply(200 if ok else 400,
                               json.dumps({"ok": ok, "delivered": delivered, "detail": detail}).encode())

        if u.path == "/inc":
            if not secrets.compare_digest(one("t"), self.token):
                log("DENY bad token on /inc from %s" % self.client_address[0])
                return self._reply(403, b'{"error":"bad token"}')
            ok, detail = increment(one("slug"), one("n"), one("a"), one("why"))
            log("%s inc %s" % ("OK  " if ok else "FAIL", detail))
            return self._reply(200 if ok else 500,
                               json.dumps({"ok": ok, "detail": detail}).encode())

        # The Wake. The page itself carries the token, like /plan/ and /review/;
        # the Host check keeps a rebound page from reading it, and the data and
        # open routes answer without an open CORS header.
        if u.path == "/artifacts":
            try:
                html = wake_page(one("ws"), self.token)
            except OSError as exc:
                return self._json(500, {"error": str(exc)})
            body = html.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            return self.wfile.write(body)

        if u.path == "/artifacts/data":
            if not secrets.compare_digest(one("t"), self.token):
                log("DENY bad token on /artifacts/data from %s" % self.client_address[0])
                return self._json(403, {"error": "bad token"})
            try:
                return self._json(200, wake_data(one("ws"), one("q"), one("kind")))
            except Exception as exc:          # a locked or missing db is a message, not a dropped socket
                log("FAIL artifacts data: %s" % exc)
                return self._json(500, {"error": "the artifact store could not be read: %s" % exc})

        if u.path == "/artifacts/open":
            if not secrets.compare_digest(one("t"), self.token):
                log("DENY bad token on /artifacts/open from %s" % self.client_address[0])
                return self._json(403, {"error": "bad token"})
            try:
                ok, detail = open_artifact(one("id"), self.server.server_address[1], one("s"))
            except Exception as exc:
                ok, detail = False, "could not open: %s" % exc
            log("%s artifacts open %s: %s" % ("OK  " if ok else "FAIL", one("id"), detail))
            return self._json(200 if ok else 400, {"ok": ok, "detail": detail})

        if u.path != "/do":
            return self._reply(404, b'{"error":"no such path"}')

        # Constant-time compare: this is a secret, and a timing oracle on a
        # local port is still an oracle.
        if not secrets.compare_digest(one("t"), self.token):
            log(f"DENY bad token from {self.client_address[0]}")
            return self._reply(403, b'{"error":"bad token"}')

        action, rid, extra = one("a"), one("r"), one("x")
        if action not in ACTIONS:
            return self._reply(400, b'{"error":"unknown action"}')

        row = targets().get(rid) or {}
        if not row and action != "sync":
            return self._reply(404, b'{"error":"unknown row"}')

        ok, detail = act(action, row, extra)
        log(f"{'OK  ' if ok else 'FAIL'} {action} {detail}")
        return self._reply(200 if ok else 500,
                           json.dumps({"ok": ok, "detail": detail}).encode())


def free_port():
    """Prefer the pinned port, then last time's, so a restart does not orphan the page.

    The pin (`CREW_INTENT_PORT`, default 7345) exists for the web Dock: a
    dock.json browser control carries a literal URL, so the /usage tab is only
    as durable as this port. The pin is first preference, not a guarantee --
    if something else holds it, the fallbacks below still bring the server up
    and the next push re-injects whatever port we landed on.

    The page holds whatever port it was last pushed with. A new port means every
    click is a silent no-op until the next push re-injects it -- up to a full
    listener tick of a board that looks fine and does nothing. Rebinding the same
    port makes the common case (server restarts, page stays open) seamless, and a
    push still corrects the page if the old port has been taken by something else.
    """
    candidates = []
    try:
        candidates.append(int(os.environ.get("CREW_INTENT_PORT", "") or 7345))
    except ValueError:
        candidates.append(7345)
    try:
        with open(PORT_FILE) as fh:
            candidates.append(int(fh.read().strip()))
    except (OSError, ValueError):
        pass
    for want in candidates:
        try:
            probe = socket.socket()
            probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            probe.bind(("127.0.0.1", want))
            probe.close()
            return want
        except OSError:
            continue
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    return port


class LocalServer(http.server.ThreadingHTTPServer):
    """ThreadingHTTPServer without the reverse-DNS lookup in server_bind.

    HTTPServer.server_bind calls socket.getfqdn() on the bind address only to
    fill server_name, which nothing here reads. On a host whose resolver
    stalls on 127.0.0.1 -- GitHub's macOS runners, found by the board probe's
    faulthandler dump -- that call never returns, and the server hangs before
    it listens or writes its port file.
    """
    allow_reuse_address = True

    def server_bind(self):
        socketserver.TCPServer.server_bind(self)
        self.server_name, self.server_port = self.server_address[:2]


def serve(background=False):
    """Start the server. Returns (port, token). Idempotent-ish: a live server on
    the recorded port is left alone and its token reused."""
    os.makedirs(STATE_DIR, exist_ok=True)

    existing = current()
    if existing:
        return existing

    # Reuse the existing token for the same reason the port is reused: the page
    # holds both, and rotating either one turns every click into a 403 until the
    # next push. The file is mode 0600, so persisting it concedes nothing to
    # anything that could not already read it. Delete it to force a fresh one.
    token = ""
    try:
        if os.stat(TOKEN_FILE).st_mode & 0o077 == 0:
            with open(TOKEN_FILE) as fh:
                token = fh.read().strip()
    except OSError:
        pass
    token = token or secrets.token_urlsafe(24)
    port = free_port()
    Handler.token = token
    httpd = LocalServer(("127.0.0.1", port), Handler)

    # Write the token first and tightly. The port file is public knowledge; the
    # token is the actual credential. The open mode applies only on create, so a
    # file left loose (the case that discarded the old token) is tightened here.
    fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(token)
    with open(PORT_FILE, "w") as fh:
        fh.write(str(port))

    log(f"listening on 127.0.0.1:{port}")
    if background:
        threading.Thread(target=httpd.serve_forever, daemon=True).start()
        return port, token
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    return port, token


def current():
    """(port, token) of a server that is actually answering, else None."""
    try:
        with open(PORT_FILE) as fh:
            port = int(fh.read().strip())
        with open(TOKEN_FILE) as fh:
            token = fh.read().strip()
    except (OSError, ValueError):
        return None
    try:
        s = socket.create_connection(("127.0.0.1", port), timeout=0.4)
        s.close()
        return port, token
    except OSError:
        return None


def plan_root(slug):
    """The worktree a plan guards, straight from its state file.

    Read rather than asked of deep_plan.mjs: this runs on a click, and a node
    process per click to learn one string is a tax on the only interaction here
    that has to feel instant.
    """
    if not SLUG_OK.match(slug or ""):
        return None
    try:
        with open(os.path.join(DP_STATE, slug + ".json")) as fh:
            return (json.load(fh) or {}).get("root") or None
    except (OSError, ValueError):
        return None


def open_file(slug, rel):
    """Open one file from a plan in VS Code, in that plan's worktree.

    Hands off to bin/crew-code-open, which is the same thing cmux's own Cmd-click
    uses (it is wired as app.preferredEditor) -- so a path clicked on the plan
    surface lands in exactly the window a path clicked in a terminal would, with
    the right branch's Source Control beside it.

    The page proposes a RELATIVE path and the root comes from the tracker, so a
    page cannot name a file outside the worktree it belongs to. Containment is
    checked on the resolved path, which also settles symlinks.
    """
    root = plan_root(slug)
    if not root:
        return False, "no worktree recorded for " + (slug or "?")
    rel = urllib.parse.unquote(rel or "").strip()
    if not rel or os.path.isabs(rel):
        return False, "not a relative path"
    # `file.rb:42` (evidence refs, stack traces) rides through to VS Code's
    # --goto; containment and existence are checked on the bare path.
    m = re.match(r"^(.*?)((?::\d+){1,2})$", rel)
    bare, line_suffix = (m.group(1), m.group(2)) if m else (rel, "")
    base = os.path.realpath(root)
    target = os.path.realpath(os.path.join(base, bare))
    if target != base and not target.startswith(base + os.sep):
        return False, "outside the worktree"
    if not os.path.exists(target):
        # Common and worth saying plainly: half the declared files are "(new)".
        return False, "not created yet: " + bare
    ok = run(["bash", CODE_OPEN, target + line_suffix])
    return ok, ("opened " + rel) if ok else ("crew-code-open refused " + rel)


def _crew_local():
    """Machine-local settings, from the overlay dir rather than the environment.

    An env var is not a durable home for "which billing model is this account".
    The status line is spawned by Claude Code and the intent server by three
    different parents (`crew apply`, `crew-listen`, `crew-board`); none of them
    source a shell rc, so a value exported in a terminal reaches some of them,
    sometimes. It was worse than that in practice: the server inherited the
    variable from the apply that spawned it and looked correct, until the next
    respawn silently reverted the page to a framing this account does not have.

    The overlay dir is durable -- outside $DEST, so install.sh cannot replace it
    -- and is where the rest of this machine's own answers already live.
    Environment still wins, for a one-off.
    """
    base = os.environ.get("CREW_LOCAL") or os.path.join(
        os.path.expanduser("~"), ".config", "cmux", "crew-local")
    try:
        with open(os.path.join(base, "config.json"), encoding="utf-8") as fh:
            cfg = json.load(fh)
        return cfg if isinstance(cfg, dict) else {}
    except (OSError, ValueError):
        return {}


def _billing_mode():
    cfg = _crew_local()
    raw = os.environ.get("CREW_BILLING") or cfg.get("billing") or ""
    return str(raw).strip().lower()


def _month_budget():
    raw = os.environ.get("CREW_MONTH_BUDGET", "")
    if not raw:
        raw = _crew_local().get("monthBudget", "")
    try:
        return float(raw or 0)
    except (TypeError, ValueError):
        return 0.0


def _env_budget(name):
    try:
        return int(os.environ.get(name, "") or 0)
    except ValueError:
        return 0


def usage_data(days=21):
    """Everything the usage dashboard shows, from ccusage. Never computed here.

    Windows and budgets, not dollars: on a subscription the constraint is the
    5h usage window (and the week), so everything is tokens against a BUDGET.
    Budgets are `CREW_BLOCK_BUDGET` / `CREW_WEEK_BUDGET` when set, else the
    largest window/week on record — ccusage's own `--token-limit max` idea.
    Token basis is ccusage's totalTokens (cache reads included) on BOTH sides
    of every ratio, so the percentage is at least honest about its own unit.
    """
    exe = shutil.which("ccusage")
    if not exe:
        return {"error": "ccusage is not installed — npm i -g ccusage"}

    # crew's published-price overrides, when there are any (pricing.py); [] --
    # ccusage's own prices, exactly as before -- otherwise or on any failure.
    try:
        sys.path.insert(0, HERE)
        import pricing as _pricing
        cfg = _pricing.config_args()
    except Exception:
        cfg = []

    def ask(args):
        try:
            p = subprocess.run([exe] + args + cfg + ["--json"], capture_output=True,
                               text=True, timeout=45)
            return json.loads(p.stdout) if p.returncode == 0 and p.stdout.strip() else None
        except Exception:
            return None

    out = {}

    # Models ccusage reported tokens for but could not price count as $0, so
    # any dollar figure covering them is a floor. Each figure carries its own
    # list, and the page marks it "+" -- never a silently low number.
    def unpriced_of(row):
        return sorted({b.get("modelName") or "?" for b in (row or {}).get("modelBreakdowns") or []
                       if isinstance(b, dict) and b.get("missingPricing")})

    # One blocks call carries both the active window and the history the
    # default budget derives from, so the two cannot disagree.
    blocks = [b for b in ((ask(["blocks"]) or {}).get("blocks") or [])
              if not b.get("isGap")]
    block_budget = _env_budget("CREW_BLOCK_BUDGET") or max(
        (b.get("totalTokens") or 0 for b in blocks), default=0)
    # Window length comes from the block's own bounds, not a hardcoded 5 --
    # `ccusage blocks --session-length` is a real option, and a page that says
    # "5h window" over a 3h block is lying in the one place you would look.
    def _window_minutes(x):
        try:
            iso = datetime.datetime.fromisoformat
            s = iso((x.get("startTime") or "").replace("Z", "+00:00"))
            e = iso((x.get("endTime") or "").replace("Z", "+00:00"))
            return max(0, round((e - s).total_seconds() / 60))
        except Exception:
            return 0

    out["windowMinutes"] = next((m for m in (_window_minutes(x) for x in reversed(blocks)) if m), 300)

    b = next((x for x in blocks if x.get("isActive")), None)
    if b:
        proj = b.get("projection") or {}
        out["block"] = {
            "tokens": b.get("totalTokens") or 0,
            "budget": block_budget,
            "projected": proj.get("totalTokens") or 0,
            "remainingMinutes": proj.get("remainingMinutes") or 0,
            "burnPerMinute": (b.get("burnRate") or {}).get("tokensPerMinute") or 0,
            "entries": b.get("entries") or 0,
            "models": b.get("models") or [],
            "active": True,
            # ISO bounds so the page can compute the countdown itself. The
            # snapshot is rendered once and the tab can sit open for hours, so a
            # server-side remainingMinutes is stale the moment it is written.
            "startTime": b.get("startTime") or "",
            "endTime": b.get("endTime") or "",
            "windowMinutes": _window_minutes(b) or out["windowMinutes"],
        }
    out["blockBudget"] = block_budget
    out["budgetSource"] = ("env" if _env_budget("CREW_BLOCK_BUDGET")
                           else "largest 5h window on record")

    daily = ask(["daily"]) or {}
    rows = [r for r in (daily.get("daily") or []) if r.get("period")]
    rows.sort(key=lambda r: r["period"])
    out["daily"] = [{"period": r["period"], "tokens": r.get("totalTokens") or 0,
                     "cost": r.get("totalCost") or 0, "unpriced": unpriced_of(r)}
                    for r in rows[-days:]]

    weekly = ask(["weekly"]) or {}
    wrows = [r for r in (weekly.get("weekly") or []) if r.get("week") or r.get("period")]
    for r in wrows:
        r["_p"] = r.get("week") or r.get("period")
    wrows.sort(key=lambda r: r["_p"])
    if wrows:
        week_budget = _env_budget("CREW_WEEK_BUDGET") or max(
            (r.get("totalTokens") or 0 for r in wrows), default=0)
        cur = wrows[-1]
        models = {}
        for m in cur.get("modelBreakdowns") or []:
            name = (m.get("modelName") or m.get("model") or "?").replace("claude-", "")
            # Same basis as the week total (cache included), or the models list
            # reads as a rounding error under the hero figure.
            models[name] = models.get(name, 0) + (m.get("totalTokens") or sum(
                m.get(k) or 0 for k in ("inputTokens", "outputTokens",
                                        "cacheCreationTokens", "cacheReadTokens")))
        out["week"] = {
            "label": "week of " + str(cur["_p"]),
            "tokens": cur.get("totalTokens") or 0,
            "cost": cur.get("totalCost") or 0,
            "unpriced": unpriced_of(cur),
            "budget": week_budget,
            "models": [{"name": k, "tokens": v}
                       for k, v in sorted(models.items(), key=lambda kv: -kv[1])],
        }

    # Which constraint this account actually has. On usage-based billing the 5h
    # window is not a limit -- you are billed, not throttled -- so the month is
    # the thing to lead with. Anything but CREW_BILLING=usage keeps the
    # subscription framing, so an install that sets nothing is unchanged.
    usage_billing = _billing_mode() == "usage"
    out["billing"] = "usage" if usage_billing else "subscription"

    if usage_billing:
        # Only fetched in this mode: it is another ~1s ccusage call, and the
        # subscription framing has no use for it.
        monthly = ask(["monthly"]) or {}
        now = datetime.datetime.now()
        period = now.strftime("%Y-%m")
        cur_m = next((r for r in (monthly.get("monthly") or [])
                      if r.get("period") == period), None)
        mbudget = _month_budget()
        days_in = calendar.monthrange(now.year, now.month)[1]
        spent = (cur_m or {}).get("totalCost") or 0
        out["month"] = {
            "label": now.strftime("%B %Y"),
            "spent": spent,
            "unpriced": unpriced_of(cur_m),
            "budget": mbudget,
            "daysElapsed": now.day,
            "daysInMonth": days_in,
            # Spend-per-elapsed-day across the whole month. Suppressed on day 1:
            # one day extended over a month is noise wearing a number's clothes.
            "projected": (spent / now.day * days_in) if now.day > 1 else 0,
        }

    # Per-workspace dollars — the page's one deliberate exception to
    # tokens-only, read from the same costs cache the board rows use
    # (~5min TTL) so the two surfaces cannot disagree. Workspace names come
    # from the collector's targets snapshot; anything unattributable is
    # simply absent, and any failure just omits the section.
    try:
        sys.path.insert(0, HERE)
        import costs as _costs
        by_cwd = {v["cwd"]: v.get("name") or os.path.basename(v["cwd"])
                  for v in targets().values() if v.get("cwd")}
        cm = _costs.costs_for(list(by_cwd))
        rows_c = [{"name": by_cwd[c], "today": round(v["today"], 2),
                   "week": round(v["week"], 2),
                   "unpricedToday": v.get("unpricedToday") or [],
                   "unpriced": v.get("unpriced") or []}
                  for c, v in cm.items()
                  if v.get("week") or v.get("today") or v.get("unpriced")]
        if rows_c:
            out["costs"] = sorted(rows_c, key=lambda r: -r["week"])
    except Exception:
        pass

    # Cache re-writes — aggregated from the per-session facts files the Stop
    # hook writes (cache-facts contract; nothing here reads a transcript).
    # Tokens-only, like the rest of the page. Any failure omits the section.
    try:
        import glob as _glob
        import time as _time
        now_s = _time.time()
        day_ago, week_ago = now_s - 86400, now_s - 7 * 86400
        facts_dir = os.path.join(os.path.expanduser("~"), ".cache",
                                 "cmux-crew", "cache-facts")
        t_day = t_week = n_day = n_week = 0
        causes, sessions = {}, []
        for fp in _glob.glob(os.path.join(facts_dir, "*.json")):
            try:
                with open(fp, encoding="utf-8") as fh:
                    f = json.load(fh)
            except (OSError, ValueError):
                continue
            s_tok = s_n = 0
            for b in f.get("breaks") or []:
                try:
                    at = datetime.datetime.fromisoformat(
                        str(b.get("ts")).replace("Z", "+00:00")).timestamp()
                except (TypeError, ValueError):
                    continue
                tok = b.get("recachedTokens") or 0
                if at > week_ago:
                    t_week += tok
                    n_week += 1
                    s_tok += tok
                    s_n += 1
                    c = b.get("cause") or "unknown"
                    causes[c] = causes.get(c, 0) + 1
                if at > day_ago:
                    t_day += tok
                    n_day += 1
            if s_tok:
                sid = os.path.basename(fp)[:-len(".json")]
                sessions.append({"name": f.get("label") or sid[:8],
                                 "tokens": s_tok, "breaks": s_n})
        if n_week:
            sessions.sort(key=lambda s: -s["tokens"])
            out["cache"] = {
                "today": {"breaks": n_day, "tokens": t_day},
                "week": {"breaks": n_week, "tokens": t_week},
                "causes": dict(sorted(causes.items(), key=lambda kv: -kv[1])),
                "sessions": sessions[:5],
            }
    except Exception:
        pass
    return out


def selftest():
    """Offline checks on the two things that break silently.

        python3 crew-board-intent --selftest

    Route resolution and the mermaid swap have both regressed once. Neither
    announces itself: a broken internal link is a 404 nobody clicks until they
    want the review of record, and a swap that stops matching just makes pages
    4.8MB again. No server or cmux needed -- this reads the real plans directory.
    """
    import glob
    ok = bad = 0

    def check(name, cond, detail=""):
        nonlocal ok, bad
        if cond:
            ok += 1
            print("  ok   %s" % name)
        else:
            bad += 1
            print("  FAIL %s%s" % (name, (" — " + detail) if detail else ""))

    working = sorted(glob.glob(os.path.join(PLANS, "*.working.html")))
    review = sorted(glob.glob(os.path.join(PLANS, "*.review.html")))
    if not review:
        print("  --   no plans on this machine; route checks skipped")
    else:
        slug = os.path.basename(review[0])[: -len(".review.html")]
        check("a bare slug resolves to a page", bool(plan_asset(slug)))
        check("<slug>.review.html resolves — the way back to the review of record",
              plan_asset(slug + ".review.html") == os.path.realpath(
                  os.path.join(PLANS, slug + ".review.html")))
        md = os.path.join(PLANS, slug + ".md")
        if os.path.exists(md):
            check("<slug>.md resolves", bool(plan_asset(slug + ".md")))
        sub = glob.glob(os.path.join(PLANS, "*.cutover", "*.epic.html"))
        if sub:
            rel = os.path.relpath(sub[0], PLANS)
            check("a link into a .cutover subdirectory resolves", bool(plan_asset(rel)))

    # Nothing outside the plans directory, and nothing in it that pages do not link to.
    for probe in ("../deep-plan/keys/x.key.json", "../../.ssh/id_rsa",
                  "%2e%2e%2fetc%2fpasswd", "/etc/passwd",
                  "a.cutover/../../deep-plan/keys/x.key.json"):
        check("refused: %s" % probe, plan_asset(probe) is None)
    js = sorted(glob.glob(os.path.join(PLANS, "*.json")))
    if js:
        check("refused: a .json artifact in the plans directory",
              plan_asset(os.path.basename(js[0])) is None)

    # The swap is what keeps a served plan at ~100KB instead of ~4.8MB.
    # Whole file, not a prefix: the boot script is emitted AFTER the page body, so
    # a truncated read finds nothing and reports a broken swap that works fine.
    # (This check failed on its first run for exactly that reason.)
    inlined = None
    for f in review + working:
        if MERMAID_DATA.search(open(f, encoding="utf-8", errors="replace").read()):
            inlined = f
            break
    if inlined:
        check("the mermaid swap still matches a real page", True,
              "inline <script src=data:...> format changed; served pages would be ~4.8MB")
    else:
        print("  --   no inlined page found; swap check skipped")

    # /open hands a path to VS Code, so its refusals matter more than its successes.
    # Only the refusal paths are exercised: the success path launches an editor,
    # which a selftest has no business doing.
    slugs = [os.path.basename(f)[: -len(".json")]
             for f in glob.glob(os.path.join(DP_STATE, "*.json"))
             if not f.endswith(".pre-repair.json")]
    tracked = next((sl for sl in slugs if plan_root(sl)), None)
    if tracked:
        for probe, why in ((("../../../etc/passwd"), "traversal"),
                           ("/etc/passwd", "absolute"),
                           ("a/../../../../etc/passwd", "traversal through a subdir"),
                           ("does/not/exist-" + secrets.token_hex(4) + ".rb", "missing file")):
            ok_, detail = open_file(tracked, probe)
            check("/open refuses %s" % why, ok_ is False, detail)
        check("/open refuses an unknown plan", open_file("no-such-plan-xyz", "a.rb")[0] is False)
    else:
        print("  --   no tracked plan with a root; /open checks skipped")

    # The spend dashboard is a template plus injected JSON; both halves can rot
    # independently. ccusage itself is not run here -- it takes a second and this
    # is a lint, not a smoke test.
    try:
        tmpl = open(USAGE_TMPL, encoding="utf-8").read()
        check("the usage template has its data placeholder", USAGE_SLOT in tmpl)
        check("...and a table twin for the chart", 'id="tbl"' in tmpl)
        check("...and does not reuse a board status colour for the series",
              "#e69875" in tmpl and "#dfa000" not in tmpl and "#e67e80" not in tmpl,
              "gold and red are 'needs you' and 'broken' on the board")
        # The window card has two views and a 60s reload, so the choice has to
        # round-trip through storage or it resets under the viewer every minute.
        check("...and the window card offers both views",
              'id="vtoggle"' in tmpl and 'id="blockbody"' in tmpl)
        check("...and remembers which one, across the 60s reload",
              "crew.usage.blockView" in tmpl and "localStorage" in tmpl)
        check("...and counts down from the block's end time, not a served number",
              "endTime" in tmpl and "leftMin" in tmpl,
              "a snapshot's remainingMinutes is stale the moment it is written")
        check("...and reads its window length from the data, not a hardcoded 5h",
              "windowMinutes" in tmpl and "winLabel" in tmpl,
              "ccusage blocks --session-length is a real option")
        # Usage-based billing has no window limit to be a share of, so the page
        # has to be able to lead with the month and speak dollars throughout.
        # A page that mixes units invites comparing two different measures.
        check("...and leads with the month on usage-based billing",
              'D.billing === "usage"' in tmpl and "D.month" in tmpl)
        # The cache card is presence-guarded: no facts files, no card — the
        # guard string is the contract with usage_data()'s "cache" key.
        check("...and renders cache re-writes only when facts exist",
              "D.cache" in tmpl and "cache-facts" in tmpl)
        # A model ccusage cannot price counts as $0. A dollar figure covering
        # one is a floor, and a page that prints it bare reads as exact.
        check("...and marks a dollar figure ccusage could not fully price",
              "plus(" in tmpl and "unpricedNote(" in tmpl and ".unpriced" in tmpl,
              "usage_data() hands each figure an `unpriced` list")
        check("...and carries one unit per mode, not tokens beside dollars",
              "var money = " in tmpl and "fmtVal" in tmpl,
              "daily bars, the axis, the table twin and the tooltip all follow it")
    except OSError as exc:
        check("the usage template is readable", False, str(exc))

    # Billing mode has to survive a respawn. This server is started by three
    # different parents and none of them source a shell rc, so reading it only
    # from the environment meant it inherited the value from whichever process
    # happened to spawn it -- correct until the next restart, then silently not.
    # Asked of _billing_mode itself, with the env var unset and a config file in
    # a temp CREW_LOCAL: grepping this file for a name would match the check.
    import tempfile
    saved_env = {k: os.environ.get(k) for k in ("CREW_LOCAL", "CREW_BILLING")}
    try:
        tmpcfg = tempfile.mkdtemp(prefix="crew-local-selftest-")
        with open(os.path.join(tmpcfg, "config.json"), "w") as fh:
            json.dump({"billing": "selftest-mode"}, fh)
        os.environ["CREW_LOCAL"] = tmpcfg
        os.environ.pop("CREW_BILLING", None)
        check("billing mode is read from a file, not just the environment",
              _billing_mode() == "selftest-mode",
              "an inherited env var reverts on the next respawn")
        shutil.rmtree(tmpcfg, ignore_errors=True)
    finally:
        for k, v in saved_env.items():
            if v is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = v
    try:
        cfgdir = os.environ.get("CREW_LOCAL") or os.path.join(
            os.path.expanduser("~"), ".config", "cmux", "crew-local")
        cfgp = os.path.join(cfgdir, "config.json")
        if os.path.exists(cfgp):
            json.load(open(cfgp, encoding="utf-8"))
            check("...and this machine's crew-local/config.json parses", True)
        else:
            check("...and no config.json here, so the default applies", True)
    except (OSError, ValueError) as exc:
        check("crew-local/config.json is readable JSON", False, str(exc))

    # `crew apply` now bounces this server whenever it is behind the installed
    # code, so token and port reuse across a restart stopped being a nicety: an
    # already-pushed board holds both, and rotating either turns every chip into
    # a 403 until the next push. Lint the two lines that guarantee it.
    try:
        me = open(__file__, encoding="utf-8").read()
        # Built from fragments so the needle is not itself in this file -- a
        # literal would match its own source and pass no matter what serve()
        # does. (The first version of this check did exactly that.)
        reuse = "token = token " + "or secrets.token_urlsafe"
        mode = "st_mode & " + "0o077"
        check("a restart reuses the persisted token",
              reuse in me and mode in me,
              "crew apply restarts this server; a fresh token 403s every chip")
    except OSError as exc:
        check("crew-board-intent is readable", False, str(exc))
    # The port: free_port() must take the pin when it is free. Asked of the
    # function with a pin known to be free, not of this file's text.
    saved_pin = os.environ.get("CREW_INTENT_PORT")
    try:
        s = socket.socket()
        s.bind(("127.0.0.1", 0))
        pin = s.getsockname()[1]
        s.close()
        os.environ["CREW_INTENT_PORT"] = str(pin)
        check("...and the port, via the pin", free_port() == pin,
              "a moved port orphans the URLs already in the pushed page")
    finally:
        if saved_pin is None:
            os.environ.pop("CREW_INTENT_PORT", None)
        else:
            os.environ["CREW_INTENT_PORT"] = saved_pin
    check("ccusage is installed", bool(shutil.which("ccusage")),
          "npm i -g ccusage — the status line and /usage both need it")

    check("the injected script leaves no placeholders",
          "__TOKEN__" not in PLAN_JS.replace("__TOKEN__", "x").replace("__SLUG__", "y")
          and "__SLUG__" not in PLAN_JS.replace("__TOKEN__", "x").replace("__SLUG__", "y"))

    # Asks: containment, then delivery through a fake cmux -- the real one would
    # type into a terminal, which a selftest has no business doing.
    import tempfile
    global ASKS
    saved_asks = ASKS
    ASKS = tempfile.mkdtemp(prefix="crew-ask-selftest-")
    try:
        aid = "20260917-120000-abcd"
        ask = {"id": aid, "options": [{"label": "a"}, {"label": "b"}, {"label": "c"}],
               "surface": "SURF-1", "answer": None}
        with open(os.path.join(ASKS, aid + ".json"), "w") as fh:
            json.dump(ask, fh)
        with open(os.path.join(ASKS, aid + ".html"), "w") as fh:
            fh.write("<html><body>x</body></html>")
        check("an ask id resolves to its page", ask_path(aid, ".html") is not None)
        for probe in ("../x", "%2e%2e", "/etc/passwd", "a/../../b"):
            check("ask refused: %s" % probe, ask_path(probe, ".html") is None)
        check("answer refuses an option out of range", answer(aid, "4", lambda a: (0, ""))[0] is False)
        check("answer refuses a non-number", answer(aid, "x", lambda a: (0, ""))[0] is False)

        PROMPT = "  1. a\n❯ 2. b\n  3. c\n"

        def fake(screen_after, screen_before=PROMPT):
            # The first read-screen is the look-before-typing; later ones are after.
            calls = []

            def runner(argv):
                calls.append(argv[0])
                if argv[0] == "read-screen":
                    return 0, screen_before if calls.count("read-screen") == 1 else screen_after
                return 0, "OK"
            return runner, calls

        # The measured behaviour: the number key submits, the prompt resolves
        # to "… → <label>", and no Enter is needed.
        runner, calls = fake("  What should it do? → b\n❯ \n")
        ok_, delivered, detail = answer(aid, "2", runner)
        check("resolved line proves delivery: look, send, read-screen, no Enter",
              ok_ and delivered and calls == ["read-screen", "send", "read-screen"], detail)
        check("the answer is recorded as delivered",
              json.load(open(os.path.join(ASKS, aid + ".json")))["answer"]["delivered"] is True)
        check("a second answer is refused", answer(aid, "1", runner)[0] is False)
        # Two submits at once (two tabs, a double click): one keystroke, not two.
        ask["answer"] = None
        with open(os.path.join(ASKS, aid + ".json"), "w") as fh:
            json.dump(ask, fh)
        runner, calls = fake("  What should it do? → b\n❯ \n")
        slow = lambda argv: (time.sleep(0.05), runner(argv))[1]
        both = [threading.Thread(target=answer, args=(aid, "2", slow)) for _ in range(2)]
        [t.start() for t in both]
        [t.join() for t in both]
        check("a double submit types the option once", calls.count("send") == 1, " ".join(calls))
        # A prompt that only moved its pointer gets the Enter.
        ask["answer"] = None
        with open(os.path.join(ASKS, aid + ".json"), "w") as fh:
            json.dump(ask, fh)
        runner, calls = fake("  1. a\n❯ 2. b\n  3. c\n")
        ok_, delivered, detail = answer(aid, "2", runner)
        check("pointer moved but unresolved: Enter is sent",
              ok_ and delivered and calls == ["read-screen", "send", "read-screen", "send-key"], detail)
        # Neither seen after typing: recorded, nothing more typed, the human is told.
        ask["answer"] = None
        with open(os.path.join(ASKS, aid + ".json"), "w") as fh:
            json.dump(ask, fh)
        runner, calls = fake("  1. a\n  2. b\n❯ 3. c\n")
        ok_, delivered, detail = answer(aid, "2", runner)
        check("unconfirmed: recorded, no Enter sent, the human is told",
              ok_ and not delivered and calls == ["read-screen", "send", "read-screen"] and "check the terminal" in detail, detail)
        # The terminal is showing some OTHER question (a different tab of a
        # multi-question prompt, or no prompt at all): nothing is typed.
        ask["answer"] = None
        with open(os.path.join(ASKS, aid + ".json"), "w") as fh:
            json.dump(ask, fh)
        runner, calls = fake("", screen_before="  1. red\n❯ 2. green\n")
        ok_, delivered, detail = answer(aid, "2", runner)
        check("option not on screen: nothing typed, the human is told to switch",
              ok_ and not delivered and calls == ["read-screen"] and "not showing this question" in detail, detail)
        # A label the prompt wrapped across two lines still counts as on screen.
        ask["answer"] = None
        ask["options"][1]["label"] = "a much longer label that wraps"
        with open(os.path.join(ASKS, aid + ".json"), "w") as fh:
            json.dump(ask, fh)
        runner, calls = fake("  ? → a much longer label that wraps\n",
                             screen_before="  1. a\n❯ 2. a much longer label\n     that wraps\n  3. c\n")
        ok_, delivered, detail = answer(aid, "2", runner)
        check("a wrapped label is still found on screen", ok_ and delivered, detail)
        ask["options"][1]["label"] = "b"
        ask["answer"] = None
        ask["surface"] = ""
        with open(os.path.join(ASKS, aid + ".json"), "w") as fh:
            json.dump(ask, fh)
        runner, calls = fake("")
        ok_, delivered, detail = answer(aid, "2", runner)
        check("no recorded surface: nothing typed, recorded as shown", ok_ and not delivered and calls == [], detail)
    finally:
        ASKS = saved_asks

    print("\n%s intent selftest: %d passed, %d failed%s"
          % ("\033[31m" if bad else "\033[32m", ok, bad, "\033[0m"))
    return 1 if bad else 0


def lock_test(rid, n, jitter):
    """`--lock-test RID N [--jitter]`: take the review lock once (N=0), or N
    times incrementing <RID>.json's "n" under it, 2ms apart. --jitter pauses up
    to 2ms after every os.stat, widening the gap two stale-lock breakers race
    in. Prints {took, s} or {took: false, err, s}. For the board probe, which
    races this against lookout's own writers."""
    import random
    if jitter:
        sys.setprofile(lambda f, ev, arg: time.sleep(random.random() * 0.002)
                       if ev == "c_return" and arg is os.stat else None)
    t = time.time()
    try:
        return _lock_test_run(rid, n, t)
    finally:
        sys.setprofile(None)


def _lock_test_run(rid, n, t):
    try:
        for i in range(max(n, 1)):
            with review_lock(rid):
                if n:
                    p = os.path.join(REVIEWS, rid + ".json")
                    with open(p) as fh:
                        r = json.load(fh)
                    r["n"] += 1
                    tmp = "%s.tmp-%d-%d" % (p, os.getpid(), i)
                    with open(tmp, "w") as fh:
                        json.dump(r, fh)
                    os.replace(tmp, p)
            if n:
                time.sleep(0.002)
        print(json.dumps({"took": True, "s": time.time() - t}))
    except TimeoutError as e:
        print(json.dumps({"took": False, "err": str(e), "s": time.time() - t}))
    return 0


def _arg(flag, default=""):
    i = sys.argv.index(flag) + 1 if flag in sys.argv else 0
    return sys.argv[i] if i and i < len(sys.argv) else default


if __name__ == "__main__":
    # Probe entry points: each reaches one piece of the server from the
    # command line, so the same probe drives the Python and the Rust server.
    if "--usage-json" in sys.argv:
        print(json.dumps(usage_data()))
        sys.exit(0)
    if "--lock-test" in sys.argv:
        i = sys.argv.index("--lock-test")
        sys.exit(lock_test(sys.argv[i + 1], int(sys.argv[i + 2]), "--jitter" in sys.argv))
    if "--wake-tab" in sys.argv:
        # --wake-tab NAME URL [--select WS]: the Wake's tab group, as /do and
        # /artifacts/open drive it.
        i = sys.argv.index("--wake-tab")
        ok, detail = _wake_tab(sys.argv[i + 1], sys.argv[i + 2], select=_arg("--select"))
        print(json.dumps({"ok": bool(ok), "detail": detail}))
        sys.exit(0)
    if "--selftest" in sys.argv:
        sys.exit(selftest())
    if "--status" in sys.argv:
        cur = current()
        print(json.dumps({"running": bool(cur),
                          "port": cur[0] if cur else None,
                          "cmux": CMUX}, indent=2))
    else:
        serve(background=False)
