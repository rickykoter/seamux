def act(action, row, extra):
    ref = row.get("ref") or ""
    wsid = row.get("id") or ""
    cwd = row.get("cwd") or ""
    pr_url = row.get("pr_url") or ""
    slug = row.get("slug") or ""
    title = row.get("name") or ""

    if action in ("jump", "row"):
        if not ref:
            return False, "no workspace ref"
        # By uuid first. A `workspace:N` ref is renumbered when cmux restarts,
        # and the targets snapshot lags a sync behind that: a jump on a fresh
        # app failed with "Workspace ref not found". The uuid does not move.
        if UUID_OK.match(wsid) and run([CMUX, "workspace", "select", wsid]):
            return True, "select " + wsid
        return run([CMUX, "workspace", "select", ref]), "select " + ref

    if action == "diff":
        # `cmux diff --workspace` defaults to the UNSTAGED source, which is empty
        # for the common board row: a branch whose work is committed and under
        # review. It failed with "diff input is empty" and read as a dead chip.
        # The diff a board row means is this branch against its merge base:
        # lookout's default, and crew-diff's `branch` when lookout is absent.
        # Both run inside the worktree because they resolve the repo from cwd.
        if not cwd or not os.path.isdir(cwd):
            return False, "no worktree for this row"
        # lookout first: ranked files, threads, the review the agent may
        # already have opened. It opens the page beside the row's terminal
        # without focus, so the row's workspace is selected to bring it in.
        # lookout hands this to `cmux open --workspace`, which takes either.
        sel = wsid if UUID_OK.match(wsid) else ref
        ok, why = _lookout_diff(cwd, sel)
        if ok:
            if sel:
                run([CMUX, "workspace", "select", sel])
            return True, why
        ok = run(["bash", CREW_DIFF, "branch"], cwd=cwd)
        if ok:
            return True, "diff branch in " + cwd
        # A brand-new branch with no merge base still has uncommitted work.
        if ref:
            return run([CMUX, "diff", "--workspace", ref]), "diff --workspace " + ref
        return False, "no diff available"

    if action == "pr":
        if not pr_url:
            return False, "no PR on this row"
        return run(["open", pr_url]), pr_url

    if action == "issue":
        issue_url = row.get("issue_url") or ""
        if not issue_url:
            return False, "no linked issue on this row"
        return run(["open", issue_url]), issue_url

    if action == "jira":
        # The chip sends only the ticket key; the site comes from the
        # integrations file server-side, so a page can never name a host.
        key = (extra or "").strip()
        if not re.fullmatch(r"[A-Z][A-Z0-9]+-\d+", key):
            return False, "not a ticket key"
        try:
            with open(os.path.join(HERE, "..", "integrations.json")) as fh:
                j = json.load(fh).get("jira") or {}
            site = (j.get("site") or "") if j.get("enabled") else ""
        except Exception:
            site = ""
        if not site:
            return False, "no Jira site configured"
        base = site if site.startswith("http") else "https://" + site
        url = base.rstrip("/") + "/browse/" + key
        return run(["open", url]), url

    if action == "checks":
        if not pr_url:
            return False, "no PR on this row"
        return run(["open", pr_url + "/checks"]), pr_url + "/checks"

    if action in ("plan", "take the check", "review"):
        # The row's slug comes from the targets snapshot, which lags a sync
        # behind reality — deep-plan's go-time auto-open knows the slug it
        # just authorized, so it rides in as `extra` and wins when the
        # snapshot has not caught up. Same validation either way: plan_page
        # anchors the slug to a real rendered surface.
        slug = slug or (extra or "").strip()
        if not slug:
            return False, "no plan on this row"
        if not plan_page(slug):
            return False, "no plan page for " + slug
        # In the Dock, beside the board, rather than in the system browser. The
        # plan is the other half of what the board is telling you, and the two
        # being in different applications was the seam.
        port = (current() or (None,))[0]
        if not port:
            return False, "intent server not answering"
        return open_plan(slug, port)

    if action == "wake":
        # The Wake for this row's workspace, in one tab whose surface id is
        # kept like open_plan's: a tap on another row moves it there, and
        # switches to that row's workspace with it.
        if not cwd:
            return False, "no workspace directory on this row"
        port = (current() or (None,))[0]
        if not port:
            return False, "intent server not answering"
        return _wake_tab(WAKE_TAB, "http://127.0.0.1:%d/artifacts?ws=%s"
                         % (port, urllib.parse.quote(cwd, safe="")),
                         select=wsid if UUID_OK.match(wsid) else ref)

    if action == "ask":
        # `deep-plan ask` opens its page here, best-effort, with the id as extra.
        ask_id = (extra or "").strip()
        if not ask_path(ask_id, ".html"):
            return False, "no such ask"
        port = (current() or (None,))[0]
        if not port:
            return False, "intent server not answering"
        # Keyed by the workspace ref (targets rows carry ref + cwd, no id), so
        # every ask from one workspace reuses that workspace's tab.
        return open_ask(ask_id, port, re.sub(r"[^A-Za-z0-9_-]", "_", ref or cwd or ""))

    if action == "code":
        return notify("crew:code", cwd or title, wsid), "code " + (cwd or title)

    if action == "reclaim":
        # triage.py opens a terminal and asks before deleting anything.
        return notify("crew:reclaim", title, wsid), "reclaim " + title

    if action == "archive":
        # triage.py archives in the hook: a close needs a caller cmux trusts,
        # and this server is not one of its children. Nothing is deleted.
        if not wsid:
            return False, "no workspace on this row"
        return notify("crew:archive", title, wsid), "archive " + title

    if action in ("sandbox-up", "sandbox-down"):
        # triage.py resolves the worktree and runs crew-sandbox; the board only
        # asks. Same channel as the Swift sidebar's sandbox chip.
        return (notify("crew:" + action, cwd or title, wsid),
                action + " " + (cwd or title))

    if action in ("feed-allow", "feed-deny"):
        # Approving what an agent asked for is consequential, so it goes through
        # the RPC and hooks/triage.py decides -- exactly as the sidebar did. The
        # board never approves anything itself.
        return notify("crew:" + action, title, wsid), action + " " + title

    if action == "sync":
        return notify("crew:sync-now", "refresh"), "sync"

    if action == "go":
        if not slug:
            return False, "no plan on this row"
        n = "".join(ch for ch in str(extra) if ch.isdigit())
        if not n:
            return False, "no increment number"
        # Through the RPC so the go-ahead is granted the same way everywhere.
        return notify("crew:plan-go", f"{slug} {n}", wsid), f"go {slug} {n}"

    if action == "close plan":
        if not slug:
            return False, "no plan on this row"
        return run(["node", dp_engine.script(), "close", slug]), "close " + slug

    return False, "unknown action: " + action


# The transitions the plan surface may ask for. `go` is the consequential one and
# is the same verb the board's chip fires; the rest only move a card that is
# already authorized. deep_plan.mjs is the authority either way -- it refuses an
# illegal transition, so this list is about not OFFERING nonsense, not about
# enforcement.
INC_ACTIONS = ("go", "start", "done", "block", "reset")


def increment(slug, n, action, why):
    """Run one tracker transition. Returns (ok, detail)."""
    if not SLUG_OK.match(slug or ""):
        return False, "bad slug"
    if not str(n).isdigit():
        return False, "bad increment"
    if action not in INC_ACTIONS:
        return False, "bad transition"
    argv = ["node", dp_engine.script(), action, slug, str(n)]
    if action == "block":
        argv.append(why or "blocked from the plan surface")
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=90)
    except subprocess.TimeoutExpired:
        # Answer the page with a reason rather than dropping its connection.
        log("FAIL inc %s %s %s: timed out" % (action, slug, n))
        return False, "deep-plan did not finish in 90s"
    detail = ((p.stdout or "") + (p.stderr or "")).strip().split("\n")[-1][:160]
    if p.returncode != 0:
        log("FAIL inc %s %s %s: %s" % (action, slug, n, detail))
        return False, detail or "deep-plan refused it"
    return True, "%s %s %s" % (action, slug, n)


# ---------------------------------------------------------------------------
# The Wake: the Artifact Log's page. artifacts.py owns the store; this serves
# /artifacts (the page, token injected, read per request like /usage),
# /artifacts/data (rows as JSON) and /artifacts/open (a click).
#
# The page names row ids, never paths. A path shown on the page is for the eye;
# what gets opened is resolved here from the row the id names, so a page --
# or anything that learned the token -- cannot point this server at a file the
# indexer never recorded.
# ---------------------------------------------------------------------------

ARTIFACTS_TMPL = os.path.join(HERE, "artifacts.tmpl.html")
ARTIFACTS_SLOT = '<script id="boot" type="application/json">__BOOT__</script>'
WAKE_VIEW = "wake-view"                  # the tab files and pages open in, beside the Wake
WAKE_TAB = "wake"                        # the tab the Wake itself lives in
WAKE_LIMIT = 2000                        # rows per answer; the page says when it is cut
VIEW_IN_WAKE = {".html", ".htm", ".svg", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".pdf"}
BROWSER_HOSTS = ("claude.ai", "github.com")
import artifacts  # noqa: E402


WAKE_SHARE = 0.8                         # the least of the main area the Wake's split is widened to


def _cmux_json(argv, timeout=10):
    """A cmux call's stdout as JSON, with UUIDs for ids, or None. stdout only:
    cmux puts notices on stderr."""
    try:
        p = subprocess.run([CMUX, "--id-format", "uuids"] + argv, capture_output=True,
                           text=True, timeout=timeout)
        return json.loads(p.stdout) if p.returncode == 0 else None
    except (subprocess.TimeoutExpired, OSError, ValueError):
        return None


def _main_panes(ws):
    """(main-area width, panes with a frame) of a workspace. Dock panes are in
    the same list, with a dock_scope and no frame; a workspace that is not on
    screen has no frames at all."""
    d = _cmux_json(["list-panes", "--workspace", ws, "--json"]) or {}
    width = (d.get("container_frame") or {}).get("width") or 0
    return width, [p for p in d.get("panes") or [] if p.get("pixel_frame") and not p.get("dock_scope")]


def _pane_of(panes, sid):
    return next((p for p in panes if sid and sid in (p.get("surface_ids") or [])), None)


def _settle(probe, timeout=1.5):
    """probe() until it answers, for up to timeout seconds. cmux applies a
    select, a new pane and a resize after it has answered the call: the list
    read straight after still shows the layout from before."""
    end = time.monotonic() + timeout
    while True:
        got = probe()
        if got or time.monotonic() >= end:
            return got
        time.sleep(0.1)


def _frame_width(ws, sid):
    p = _pane_of(_main_panes(ws)[1], sid)
    return p["pixel_frame"]["width"] if p else 0


def _widen(ws, sid):
    """Widen the pane holding sid to WAKE_SHARE of the main area, never
    narrower than it is. resize-pane moves one divider and does not pass the
    rest on, so once the pane's own left edge is spent -- its sibling is at its
    least -- the pane beside it moves its left edge, which is the divider of
    the split holding both; then the next, nearest first. A pass that moves
    nothing ends it."""
    _settle(lambda: _frame_width(ws, sid))
    for _ in range(6):
        width, panes = _main_panes(ws)
        me = _pane_of(panes, sid)
        if not me or not width:
            return
        w = me["pixel_frame"]["width"]
        need = int(WAKE_SHARE * width - w)
        if need < 8:
            return
        x = me["pixel_frame"]["x"]
        # A pane at the left edge has no divider to move.
        beside = sorted((p for p in panes if 0 < p["pixel_frame"]["x"] < x),
                        key=lambda p: -p["pixel_frame"]["x"])
        for p in [me] + beside:
            run([CMUX, "resize-pane", "--pane", p["id"], "--workspace", ws, "-L",
                 "--amount", str(need)])
            if _settle(lambda: _frame_width(ws, sid) > w + 1, 0.6):
                break
        else:
            return


def _keep_path(keep_name, ws=""):
    # Its own namespace: plan_surface_file("wake") would share a file with a
    # deep-plan whose slug is "wake". One per workspace; no ws is the single
    # file an older crew kept, for one Dock tab.
    return os.path.join(STATE_DIR, "wake-surface-" + keep_name + ("-" + ws if ws else ""))


def _read_keep(keep_name, ws=""):
    try:
        with open(_keep_path(keep_name, ws)) as fh:
            return fh.read().strip()
    except OSError:
        return ""


def _write_keep(keep_name, ws, sid):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(_keep_path(keep_name, ws), "w") as fh:
            fh.write(sid + "\n")
    except OSError:
        pass


def _adopt_legacy(ws):
    """The one Wake tab an older crew kept, in the Dock: closed, and its file
    dropped. One that is already a split in this workspace becomes its own."""
    for name in (WAKE_TAB, WAKE_VIEW):
        sid = _read_keep(name)
        if not sid:
            continue
        if _pane_of(_main_panes(ws)[1], sid):
            _write_keep(name, ws, sid)
        elif _surface_cmux(["browser", "--surface", sid, "get", "url"], 10)[0] == 0:
            d = _cmux_json(["list-panes", "--workspace", ws, "--json"]) or {}
            if any(p.get("dock_scope") and sid in (p.get("surface_ids") or []) for p in d.get("panes") or []):
                run([CMUX, "close-surface", "--surface", sid])
            else:
                continue                 # a split in another workspace adopts it there
        try:
            os.remove(_keep_path(name))
        except OSError:
            pass


def _wake_tab(keep_name, url, select=""):
    """Show url in the Wake's own tab group in the workspace in front: one
    split at the right holding the Wake and a tab for what it opens, nothing
    else. Focused, and widened to WAKE_SHARE of the window. A second click
    navigates, never stacks. Each workspace has its own group, kept per
    workspace; one in another workspace is left where it is. select names a
    workspace to switch to first, so a row's Wake opens in that row's
    workspace: the one you asked about, and the only one with frames to widen
    (one off screen has none).

    Not in the Dock: cmux has no way to widen the Dock from outside (its width
    is read once, at launch, and resize-pane does not reach Dock panes), and the
    Wake wants the room."""
    # tree's "active", not current-workspace: that one answers for the
    # caller's workspace, and stays there after a select.
    def front():
        return ((_cmux_json(["tree", "--json"]) or {}).get("active") or {}).get("workspace_id")
    if select:
        rc, out = _surface_cmux(["--id-format", "uuids", "workspace", "select", select], 10)
        target = next((t for t in out.split() if len(t) == 36 and t.count("-") == 4), "")
        if rc != 0 or not target:
            return False, "could not switch to " + select
        # "active" follows a select a moment later; until it does it names
        # the workspace you were in, whose group would be the one reused.
        if not _settle(lambda: front() == target):
            return False, "cmux did not switch to " + select
        ws = target
    else:
        ws = front()
    if not ws:
        return False, "cmux did not say which workspace is in front"
    _adopt_legacy(ws)
    _, panes = _main_panes(ws)
    # The group is the pane the Wake is in, else the pane its view is in. A
    # tab of either dragged out of it is no longer the group's: the next open
    # makes a new one in the group rather than following it.
    group = (_pane_of(panes, _read_keep(WAKE_TAB, ws)) or
             _pane_of(panes, _read_keep(WAKE_VIEW, ws)))
    sid = _read_keep(keep_name, ws)
    if group and sid in (group.get("surface_ids") or []):
        run([CMUX, "browser", "--surface", sid, "goto", url])
        run([CMUX, "focus-panel", "--panel", sid, "--workspace", ws])
        _widen(ws, sid)
        return True, "focused " + sid
    if group:
        argv = ["new-surface", "--type", "browser", "--pane", group["id"], "--workspace", ws, "--url", url]
    else:
        # A new split at the right edge, cut from the rightmost pane: new-pane
        # splits whichever pane is focused.
        right = max(panes, key=lambda p: p["pixel_frame"]["x"] + p["pixel_frame"]["width"], default=None)
        if right and right.get("selected_surface_id"):
            run([CMUX, "focus-panel", "--panel", right["selected_surface_id"], "--workspace", ws])
        argv = ["new-pane", "--type", "browser", "--direction", "right", "--workspace", ws, "--url", url]
    rc, out = _surface_cmux(["--id-format", "uuids"] + argv, 20)
    new = next((t for t in out.split() if len(t) == 36 and t.count("-") == 4), "") if rc == 0 else ""
    if not new:
        return False, "could not open the Wake's split: " + out.strip()[:160]
    _write_keep(keep_name, ws, new)
    run([CMUX, "focus-panel", "--panel", new, "--workspace", ws])
    _widen(ws, new)
    return True, url


def _browser(url):
    """A claude.ai or GitHub URL in the default browser; nothing else. Rows come
    from transcripts, so a URL a browser could read differently from urlparse
    (a backslash, whitespace, a control character, userinfo) is refused."""
    url = url or ""
    u = urllib.parse.urlparse(url)
    if (any(c == "\\" or c.isspace() or ord(c) < 32 or ord(c) == 127 for c in url)
            or "@" in u.netloc or u.scheme != "https" or u.hostname not in BROWSER_HOSTS):
        return False, "not a claude.ai or GitHub URL"
    ok = run(["open", url])
    return ok, ("opened " + url) if ok else "the browser did not open"


def _lookout_engine():
    """(node, lookout.mjs) from the engine pointer lookout setup wrote, or
    (None, None) when lookout is not installed."""
    try:
        with open(LOOKOUT_POINTER, encoding="utf-8") as fh:
            engine = os.path.join(json.load(fh).get("root") or "", "lookout.mjs")
    except (OSError, ValueError):
        return None, None
    node = shutil.which("node") or next((c for c in ("/opt/homebrew/bin/node", "/usr/local/bin/node")
                                         if os.path.exists(c)), None)
    if not node or not os.path.isfile(engine):
        return None, None
    return node, engine


_DIFF_BUSY = set()                       # worktrees whose lookout diff is building now
_DIFF_LOCK = threading.Lock()


def _lookout_diff(cwd, wsid):
    """The board's diff chip: this branch against its base, as a lookout
    review beside the row's terminal. No --id, so it is the branch's own
    review -- the one /lookout opens -- and its threads and findings come
    along; lookout keeps them across a rebuild. lookout places the page in
    CMUX_WORKSPACE_ID, which for this server is nobody's, so the row's
    workspace is handed in. -> (ok, detail); not ok when lookout is missing
    or refused, so the caller can fall back to crew-diff."""
    node, engine = _lookout_engine()
    if not node:
        return False, "lookout is not installed"
    # One build per worktree at a time. A big branch takes a while, the chip
    # shows only that it was pressed, and a second press would race a second
    # build of the same review; the first one opens the page.
    with _DIFF_LOCK:
        if cwd in _DIFF_BUSY:
            return True, "lookout already opening " + cwd
        _DIFF_BUSY.add(cwd)
    try:
        return _lookout_diff_run(node, engine, cwd, wsid)
    finally:
        with _DIFF_LOCK:
            _DIFF_BUSY.discard(cwd)


def _lookout_diff_run(node, engine, cwd, wsid):
    env = dict(os.environ)
    env.pop("CMUX_WORKSPACE_ID", None)
    if wsid:
        env["CMUX_WORKSPACE_ID"] = wsid
    try:
        p = subprocess.run([node, engine, "open", "--view-only", "--at", cwd], cwd=cwd, env=env,
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=90)
    except (OSError, subprocess.SubprocessError) as exc:
        log("FAIL lookout diff %s: %s" % (cwd, exc))
        return False, "lookout did not run"
    if p.returncode != 0:
        log("FAIL lookout diff %s: %s" % (cwd, (p.stderr or p.stdout).strip()[-160:]))
        return False, "lookout refused it"
    return True, "lookout " + cwd


def _lookout_commit(ws, sha):
    """Build one commit's view-only lookout review, run in the workspace it
    was made in but opened nowhere (--no-open): the caller shows it. Returns
    the review id, or "" when lookout is missing or failed."""
    node, engine = _lookout_engine()
    if not node:
        return ""
    rid = "wake-" + sha[:12]
    # Waited on, not spawned and forgotten: a lookout that fails (a root
    # commit has no sha^) must fall through to the GitHub URL, not report an
    # open that never happened. The server is threaded; one click waits.
    try:
        p = subprocess.run([node, engine, "open", "--range", "%s^..%s" % (sha, sha), "--view-only",
                            "--at", ws, "--id", rid, "--no-open"], cwd=ws,
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=90)
    except (OSError, subprocess.SubprocessError):
        return ""
    if p.returncode != 0:
        log("FAIL lookout open %s: %s" % (sha[:7], (p.stderr or p.stdout).strip()[-160:]))
        return ""
    return rid


CODE_APP = "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"


def _open_in_editor(path):
    """A file in an editor. crew-code-open first: it puts a file inside a
    repo in that worktree's VS Code window. It exits 1 on purpose for a file
    outside any repo (cmux then falls back to the default app), and most
    Wake rows -- scratchpads, ~/.claude/plans -- are outside one. Then VS Code
    on the bare file, then the default TEXT editor (`open -t`). Never plain
    `open`: the default app for a .py or .sh can run it."""
    try:                                  # quiet: its exit 1 here is a fallback, not a failure
        if subprocess.run(["bash", CODE_OPEN, path], capture_output=True, timeout=20).returncode == 0:
            return True, "opened " + path
    except (OSError, subprocess.SubprocessError):
        pass
    code = os.environ.get("CREW_CODE_BIN") or (CODE_APP if os.access(CODE_APP, os.X_OK) else shutil.which("code"))
    if code and run([code, path]):
        return True, "opened " + path + " in VS Code"
    if run(["open", "-t", path]):
        return True, "opened " + path + " in the text editor"
    return False, "no editor would open " + path


def _has_commit(ws, sha):
    try:
        return subprocess.run(["git", "-C", ws, "cat-file", "-e", sha + "^{commit}"],
                              capture_output=True, timeout=5).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def wake_row(r):
    """A row as the page sees it: the store's fields plus its state now."""
    path = r.get("path") or ""
    present = bool(path) and os.path.exists(path)
    url = r.get("url") or ""
    if r.get("kept_at"):
        state = "kept" if present else "gone"
    elif r["kind"] in ("commit", "artifact"):
        state = "ok"                     # a sha or a URL does not go missing with a file
    elif path and not present:
        state = "gone"
    elif present and artifacts.is_temp(path):
        state = "risk"
    else:
        state = "ok"
    return {
        "id": r["id"], "kind": r["kind"], "title": r.get("title") or "",
        "path": path, "was_path": r.get("was_path") or "", "url": url,
        "sha": (r.get("sha") or "")[:7], "created_at": r.get("created_at") or "",
        "session_id": r.get("session_id") or "", "branch": r.get("branch") or "",
        "prompt": r.get("prompt") or "", "source": r.get("source") or "",
        "locator": r["locator"] if r["kind"] in ("plan", "review", "ask") else "",
        "state": state, "published": url.startswith("https://claude.ai/"),
        "publishable": state != "gone" and publishable(r),
        "ws": r.get("ws") or "",
    }


def wake_data(ws, q="", kind=""):
    rows = artifacts.search(q, ws=ws or None, kind=kind or None, limit=WAKE_LIMIT)
    wss = artifacts.workspaces()
    ws = artifacts.wskey(ws) if ws else ""
    return {"ws": ws, "rows": [wake_row(r) for r in rows], "limit": WAKE_LIMIT,
            "truncated": len(rows) >= WAKE_LIMIT,
            "workspaces": [{"ws": w["ws"], "n": w["n"], "last": w["last"] or "",
                            "name": os.path.basename(w["ws"].rstrip("/")) or w["ws"],
                            "here": os.path.isdir(w["ws"])} for w in wss]}


def open_artifact(rid, port, sub=""):
    """Open the row an id names, by kind. Returns (ok, detail)."""
    try:
        r = artifacts.row(int(rid))
    except (TypeError, ValueError):
        return False, "bad id"
    if not r:
        return False, "no such row"
    kind, path, url, loc = r["kind"], r.get("path") or "", r.get("url") or "", r["locator"]
    base = "http://127.0.0.1:%d" % port
    if kind == "plan":
        suffix = {"": "", "working": "", "review": ".review.html", "md": ".md"}.get(sub)
        if suffix is None or not SLUG_OK.match(loc):
            return False, "unknown plan surface"
        if not suffix:
            return _wake_tab(WAKE_VIEW, "%s/plan/%s" % (base, loc))
        if not plan_asset(loc + suffix):
            return False, "no %s for %s" % (sub, loc)
        return _wake_tab(WAKE_VIEW, "%s/plan/%s%s" % (base, loc, suffix))
    if kind == "review":
        if not review_path(loc, ".html"):
            return False, "the review page is gone"
        return _wake_tab(WAKE_VIEW, "%s/review/%s" % (base, loc))
    if kind == "ask":
        if not ask_path(loc, ".html"):
            return False, "the ask page is gone"
        return _wake_tab(WAKE_VIEW, "%s/ask/%s" % (base, loc))
    if kind == "commit":
        sha, ws = r.get("sha") or loc, r.get("ws") or ""
        if (ws and os.path.isdir(ws) and re.match(r"^[0-9a-f]{7,40}$", sha) and _has_commit(ws, sha)
                and _has_commit(ws, sha + "^")):          # a root commit has no sha^..sha
            rid = _lookout_commit(ws, sha)
            if rid and review_path(rid, ".html"):
                # Where you are looking: the tab beside the Wake, through this
                # server's review page. lookout left alone opens it beside the
                # commit's workspace's terminal, unfocused -- often a workspace
                # other than the one the Wake is open in, so nothing appeared.
                return _wake_tab(WAKE_VIEW, "%s/review/%s" % (base, rid))
        if url:
            return _browser(url)
        return False, "the worktree is gone and no GitHub remote was recorded"
    if kind == "artifact":
        return _browser(url)
    if path and os.path.isfile(path):
        if os.path.splitext(path)[1].lower() in VIEW_IN_WAKE:
            return _wake_tab(WAKE_VIEW, "file://" + urllib.parse.quote(path))
        return _open_in_editor(path)
    if url:
        return _browser(url)             # the file is gone; its publish is not
    return False, "gone: " + (path or loc)


PUBLISHABLE = {".html", ".htm", ".md", ".markdown", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg"}
PUBLISH_KINDS = ("temp", "image", "doc", "file")


def publishable(r):
    path = r.get("path") or ""
    return (r["kind"] in PUBLISH_KINDS and os.path.splitext(path)[1].lower() in PUBLISHABLE
            and os.path.isfile(path))


def workspace_for(ws):
    """The cmux workspace the board lists for a directory, or ''."""
    try:
        want = os.path.realpath(ws)
    except (TypeError, ValueError):
        return ""
    for wid, row in targets().items():
        cwd = (row or {}).get("cwd") if isinstance(row, dict) else None
        if cwd and os.path.realpath(cwd) == want:
            return wid
    return ""


def publish_artifact(rid):
    """Publish one row's file to claude.ai: a terminal pane in the row's
    workspace runs an interactive claude limited to Artifact and Read, with
    the prompt already given. Headless `claude -p` is not offered the
    Artifact tool, so the run is one the human can watch and stop. The URL
    reaches the row when the indexer reads that session's transcript."""
    try:
        r = artifacts.row(int(rid))
    except (TypeError, ValueError):
        return False, "bad id"
    if not r:
        return False, "no such row"
    if not publishable(r):
        return False, "only a present HTML, markdown or image file can be published"
    path = r["path"]
    if any(ord(c) < 32 for c in path):
        return False, "a path with control characters is not sent to a terminal"
    ws = r.get("ws") or ""
    cwd = ws if ws and os.path.isdir(ws) else os.path.expanduser("~")
    # No title: a page's own <title> names the artifact, and asking for
    # another made the run offer to edit the file.
    prompt = ("Publish the file %s to claude.ai with the Artifact tool, exactly as it is: read it "
              "first and do not edit or rewrite it. Then reply with only the URL." % path)
    cmd = "claude --tools Artifact Read --strict-mcp-config " + shlex.quote(prompt)
    argv = ["new-surface", "--type", "terminal", "--working-directory", cwd, "--command", cmd,
            "--focus", "true"]
    wid = workspace_for(cwd)
    if wid:
        argv += ["--workspace", wid]
    rc, out = _surface_cmux(argv, 20)
    if rc != 0:
        return False, "could not open a terminal: " + out.strip()[:160]
    return True, "publishing %s in a terminal; the URL lands here when it finishes" % os.path.basename(path)


def wake_page(ws, token):
    tmpl = open(ARTIFACTS_TMPL, encoding="utf-8").read()
    boot = (json.dumps({"t": token, "ws": ws}).replace("<", "\\u003c")
            .replace(">", "\\u003e").replace("&", "\\u0026"))
    return tmpl.replace(ARTIFACTS_SLOT, ARTIFACTS_SLOT.replace("__BOOT__", boot))


# ---------------------------------------------------------------------------
# The served board. GET /board is board.html with render.js, intent.js and a
# boot script injected; GET /board/events is a server-sent-events stream of the
# ranked state (crew-board state --json), one `state` event per change. One
# worker builds it -- from cmux events, plan-state stat and a heartbeat, the
# way `crew-board watch` does -- so no request thread ever waits on a build,
# and it stops a minute after the last subscriber leaves (the event tail and
# plan watcher it wakes on stay, one of each per server). Each build also
# writes the click table, so /do resolves the rows the page shows.
# ---------------------------------------------------------------------------

BOARD_HTML = os.path.join(HERE, "board.html")
RENDER_JS = os.path.join(HERE, "render.js")
INTENT_JS = os.path.join(HERE, "intent.js")
CREW_BOARD = os.path.join(HERE, "crew-board")
BOARD_WAKE_EVENTS = ["agent.hook.Notification", "agent.hook.Stop", "workspace.created",
                     "workspace.closed", "workspace.renamed", "workspace.selected"]
BOARD_IDLE_STOP = 60.0

# The origins that frame the board (the seamux app's webview), plus
# CREW_INTENT_FRAME_ANCESTORS (a developer running the app under Vite adds
# http://localhost:5173 there): intent.js posts to and hears from
# only these. The same list as parent_origins() in the Rust server.rs.
_ORIGIN_OK = re.compile(r"^[a-z][a-z0-9+.-]*://[A-Za-z0-9.:\[\]-]+$")


def parent_origins():
    out = ["tauri://localhost", "http://tauri.localhost", "https://tauri.localhost"]
    for o in os.environ.get("CREW_INTENT_FRAME_ANCESTORS", "").split():
        if _ORIGIN_OK.match(o) and o not in out:
            out.append(o)
    return out


BOARD_JS = """
<style>html[data-feed="lost"] #stamp::after{content:" · reconnecting"}</style>
<script>
(function(){
  var T = "__TOKEN__", PORT = __PORT__, PARENTS = __PARENTS__;
  // EventSource reconnects by itself; the stamp says so while it is down.
