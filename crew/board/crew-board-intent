# A slug reaches us from a URL, and it is about to be joined onto a path. Anchored
# and character-limited so it can only ever name a file inside PLANS.
SLUG_OK = re.compile(r"^[a-z0-9][a-z0-9._-]{0,120}$")
UUID_OK = re.compile(r"^[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}$")
MERMAID_DATA = re.compile(r'src="data:text/javascript;base64,[A-Za-z0-9+/=]+"')


def cmux_bin():
    env = os.environ.get("CREW_CMUX")
    if env and os.path.exists(env):
        return env
    try:
        out = subprocess.run([_RESOLVER], capture_output=True, text=True,
                             timeout=10).stdout.strip()
        if out:
            return out
    except Exception:
        pass
    return shutil.which("cmux") or "cmux"


CMUX = cmux_bin()


def log(msg):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(LOG, "a") as fh:
            fh.write(f"{time.strftime('%H:%M:%S')} {msg}\n")
    except OSError:
        pass


def run(argv, cwd=None):
    """Fire a command. Never through a shell, never blocking the response."""
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=20,
                           cwd=cwd or None)
        if p.returncode != 0:
            log(f"FAIL {argv[1:4]} rc={p.returncode} {p.stderr.strip()[:160]}")
            return False
        return True
    except Exception as exc:
        log(f"FAIL {argv[1:4]} {exc}")
        return False


def notify(subtitle, body, workspace_id=None):
    """Post a marked notification: the RPC channel hooks/triage.py dispatches."""
    argv = [CMUX, "rpc", "notification.create", json.dumps({
        "title": "crew", "subtitle": subtitle, "body": body,
        # snake_case only. cmux now refuses the whole call over an unknown key
        # ("Unsupported parameter 'workspaceId'; use 'workspace_id'"), and the
        # camelCase twin added for the go chip (FINDINGS 2026-09-13) had made
        # every row-scoped button -- reclaim, archive, code, go, sandbox, feed --
        # fail before triage.py ever saw it. The policy JSON triage.py reads
        # carries the id under workspaceId either way, and it reads both.
        **({"workspace_id": workspace_id} if workspace_id else {}),
    })]
    return run(argv)


def targets():
    try:
        with open(TARGETS) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def plan_surface_file(slug):
    return os.path.join(STATE_DIR, "plan-surface-" + slug)


def _surface_cmux(argv, timeout):
    """(returncode, output) of a cmux call. A hung cmux is a failure with a
    reason: TimeoutExpired out of a handler drops the page's connection bare."""
    try:
        p = subprocess.run([CMUX] + argv, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout or "") + (p.stderr or "")
    except subprocess.TimeoutExpired:
        return 1, "cmux did not answer in %ds" % timeout
    except OSError as exc:
        return 1, "cmux could not run: %s" % exc


def open_plan(slug, port):
    """Show a plan in the Dock, reusing its own surface.

    Served over this server's origin rather than opened as a file://, for three
    reasons that all point the same way: the page can then reference ONE cached
    mermaid instead of embedding 3.4MB of it, its increment buttons are
    same-origin with /inc so they need no injected token, and it gets a stable
    URL the Dock can restore. The Swift sidebar had to use openURL because a
    sidebar can only call cmux dispatcher methods; this is an ordinary process
    and has no such limit.
    """
    url = "http://127.0.0.1:%d/plan/%s" % (port, slug)
    keep = plan_surface_file(slug)
    sid = ""
    try:
        with open(keep) as fh:
            sid = fh.read().strip()
    except OSError:
        pass

    if sid:
        # Still there? Then this is a focus, not an open -- clicking `plan` twice
        # must not stack Dock tabs.
        if _surface_cmux(["browser", "--surface", sid, "get", "url"], 10)[0] == 0:
            run([CMUX, "browser", "--surface", sid, "goto", url])
            run([CMUX, "focus-panel", "--panel", sid])
            return True, "focused " + sid

    rc, out = _surface_cmux(["new-surface", "--type", "browser", "--placement",
                             "dock", "--url", url], 20)
    if rc != 0:
        return False, "could not open a Dock surface: " + out.strip()[:160]
    new = next((t for t in out.split() if len(t) == 36 and t.count("-") == 4), "")
    if new:
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            with open(keep, "w") as fh:
                fh.write(new + "\n")
        except OSError:
            pass
    return True, url


def plan_page(slug):
    """Prefer the live working surface; fall back to the frozen review."""
    if not SLUG_OK.match(slug or ""):
        return None
    for suffix in (".working.html", ".review.html"):
        p = os.path.join(PLANS, slug + suffix)
        if os.path.exists(p):
            return p
    return None


# What a plan page links to, and therefore what has to resolve under /plan/.
# Nothing else does: the directory also holds .json and .txt artifacts, and
# widening this to "any file" would publish them to anything that can reach the
# port. (The answer keys and archived specs are not at risk either way -- they
# live in ~/.claude/deep-plan/keys, a separate tree, deliberately.)
SERVABLE = (".html", ".md")


def plan_asset(rel):
    """Resolve a /plan/ URL segment to a real file, or None.

    Two shapes reach this. A bare slug is the entry point the board links to and
    resolves to that plan's live surface. Anything ending in a servable extension
    is an internal link FROM one of those pages -- `<slug>.review.html`,
    `<slug>.md`, `<slug>.cutover/<slug>.epic.html` -- which resolve relative to
    /plan/ and used to 404, breaking the way back to the review of record.
    """
    rel = urllib.parse.unquote(rel or "").strip()
    if not rel or rel.startswith("/"):
        return None
    if not rel.endswith(SERVABLE):
        return plan_page(rel)                    # a bare slug
    # A relative path now, so containment is checked on the resolved path rather
    # than trusted to a pattern: symlinks and any ".." that survives unquoting
    # both have to land inside PLANS or this returns nothing.
    base = os.path.realpath(PLANS)
    target = os.path.realpath(os.path.join(PLANS, rel))
    if target != base and not target.startswith(base + os.sep):
        return None
    return target if os.path.isfile(target) else None


# ---------------------------------------------------------------------------
# Asks. `deep-plan ask` writes asks/<id>.json + .html under PLANS; this server
# serves the page at /ask/<id> and, on a pick, types the option number into the
# ONE surface the ask recorded — never a surface the request names. Enter is
# sent only after read-screen shows that number selected; otherwise the page
# tells the human which key to press. (ADR: pages act on a session only through
# this server, verify-then-commit.)
# ---------------------------------------------------------------------------

ASKS = os.path.join(PLANS, "asks")

# What the screen shows after the number is typed, as two regexes. Measured on
# 2026-09-17 against a real prompt: a number key SUBMITS the option outright,
# and the prompt collapses to one line ending in "→ <option label>". So the
# proof of delivery is that resolved line (ASK_RESOLVED_RE, %s = the label);
# only a prompt that instead moved its pointer (ASK_SELECTED_RE, %d = the
# number) still needs an Enter. Override either with CREW_ASK_*_RE if a
# terminal renders differently. A pattern that never matches is safe: the
# page then says "press N", and Enter is never sent blind.
ASK_RESOLVED_RE = os.environ.get("CREW_ASK_RESOLVED_RE") or r"→\s*%s\s*$"
ASK_SELECTED_RE = os.environ.get("CREW_ASK_SELECTED_RE") or r"^\s*[❯›>]\s*%d[.)]"


def ask_path(ask_id, ext):
    """Resolve an ask id to its .json or .html, or None. Anchored like plan_asset."""
    if not SLUG_OK.match(ask_id or ""):
        return None
    base = os.path.realpath(ASKS)
    target = os.path.realpath(os.path.join(ASKS, ask_id + ext))
    if not target.startswith(base + os.sep):
        return None
    return target if os.path.isfile(target) else None


def cmux_run(argv, timeout=10):
    """The one seam through which delivery touches cmux (the selftest swaps it)."""
    try:
        p = subprocess.run([CMUX] + list(argv), capture_output=True, text=True,
                           timeout=timeout, env=dict(os.environ, CMUX_QUIET="1"))
        return p.returncode, (p.stdout or "") + (p.stderr or "")
    except Exception as exc:
        return 1, str(exc)


def _on_screen(label, screen):
    """Is the option label visible? Whitespace-insensitive: the prompt wraps
    long labels across lines, and read-screen keeps the wrap."""
    squash = lambda s: re.sub(r"\s+", "", s)
    return squash(label) in squash(screen)


def deliver(surface, n, label="", runner=None):
    """Type option n into `surface` and prove it landed before claiming so.

    Returns (delivered, detail). Verify-then-commit is the whole point: the
    number key normally submits by itself, and the resolved line is the
    proof. Enter is sent only when the screen shows the pointer moved to n
    WITHOUT resolving — never blind, because a blind Enter would submit
    whatever IS highlighted.
    """
    runner = runner or cmux_run
    if not surface:
        return False, "the ask recorded no terminal surface — press %d in the terminal" % n
    # Look BEFORE typing: the number key submits whatever prompt is showing,
    # and a multi-question prompt shows one question per tab. If this ask's
    # option is not on screen, the keystroke would answer some other question.
    rc, screen = runner(["read-screen", "--surface", surface, "--lines", "60"])
    if label and (rc != 0 or not _on_screen(label, screen)):
        return False, "the terminal is not showing this question — switch to it, then press %d" % n
    rc, out = runner(["send", "--surface", surface, str(n)])
    if rc != 0:
        return False, "cmux send failed (%s) — press %d in the terminal" % (out.strip()[:80], n)
    rc, screen = runner(["read-screen", "--surface", surface, "--lines", "60"])
    lines = screen.splitlines() if rc == 0 else []
    resolved = re.compile(ASK_RESOLVED_RE % re.escape(label)) if label else None
    if resolved and any(resolved.search(line) for line in lines):
        return True, "delivered %d — the prompt took it" % n
    selected = re.compile(ASK_SELECTED_RE % n)
    if any(selected.match(line) for line in lines):
        rc, out = runner(["send-key", "--surface", surface, "enter"])
        if rc != 0:
            return False, "%d is selected; Enter did not send (%s) — press Enter" % (n, out.strip()[:80])
        return True, "delivered %d — selected, then Enter" % n
    return False, "typed %d but could not confirm it on screen — check the terminal" % n


# One answer at a time. The server is threaded, and the "not yet answered" check
# and the write that answers must not straddle another thread's deliver(): a
# double submit (two tabs, a double click) would type the digit twice, and the
# second keystroke answers whatever prompt comes next.
_ANSWER_LOCK = threading.Lock()


def answer(ask_id, n_raw, runner=None):
    """Record and deliver one answer. Returns (ok, delivered, detail)."""
    with _ANSWER_LOCK:
        return _answer(ask_id, n_raw, runner)


def _answer(ask_id, n_raw, runner):
    jp = ask_path(ask_id, ".json")
    if not jp:
        return False, False, "no such ask"
    try:
        with open(jp, encoding="utf-8") as fh:
            ask = json.load(fh)
    except (OSError, ValueError) as exc:
        return False, False, "unreadable ask: %s" % exc
    if not str(n_raw).isdigit():
        return False, False, "bad option"
    n = int(n_raw)
    if not 1 <= n <= len(ask.get("options") or []):
        return False, False, "option %d is not one of %d" % (n, len(ask.get("options") or []))
    if ask.get("answer"):
        return False, False, "already answered: %d" % ask["answer"].get("n", 0)
    label = ((ask.get("options") or [])[n - 1] or {}).get("label") or ""
    delivered, detail = deliver(ask.get("surface") or "", n, label, runner)
    ask["answer"] = {"n": n, "at": time.strftime("%Y-%m-%dT%H:%M:%S"), "delivered": delivered}
    try:
        with open(jp, "w", encoding="utf-8") as fh:
            json.dump(ask, fh, indent=2)
            fh.write("\n")
    except OSError as exc:
        return False, delivered, "recorded nothing: %s" % exc
    log("ask %s answered %d (%s)" % (ask_id, n, "typed" if delivered else "shown"))
    return True, delivered, detail


def open_ask(ask_id, port, wsid):
