# ---------------------------------------------------------------------------
# Reviews. lookout (the code-review plugin) writes reviews/<id>.json, the
# review's record, and reviews/<id>.html, its page, under PLANS. This server
# serves the page at /review/<id> with the token injected, the record at
# /review/<id>.json for the page to poll, and takes the human's comments and
# closes as POST /review/<id>.
#
# A comment travels as DATA: it is stored, and lookout's prompt hook hands it
# to the session at its next prompt. Nothing here types into a terminal; the
# keystroke rule for asks (verify, then send only an option number) is
# untouched. This is the server's first POST route, so it is held to more
# than the GETs: the token, a JSON body (a cross-origin page cannot send one
# without a preflight, which this server never answers), an Origin that is
# this server's own, and a size cap. Writes take the same lock directory the
# lookout CLI takes and replace the file atomically.
# ---------------------------------------------------------------------------

# LOOKOUT_REVIEWS_DIR first, as lookout/lib/store.mjs resolves it: the two
# sides of the lock contract have to agree on where the lock lives.
REVIEWS = os.environ.get("LOOKOUT_REVIEWS_DIR") or os.path.join(PLANS, "reviews")
LOOKOUT_POINTER = os.path.join(os.path.expanduser("~"), ".claude", "lookout", "engine.json")
REVIEW_MAX_BODY = 64 * 1024
REVIEW_MAX_TEXT = 4000
REVIEW_OPS = ("comment", "resolve", "dismiss", "reopen", "answer")
LOCK_STALE = 10.0


def review_path(rid, ext):
    """Resolve a review id to its .json or .html, or None. Anchored like ask_path."""
    if not SLUG_OK.match(rid or ""):
        return None
    base = os.path.realpath(REVIEWS)
    target = os.path.realpath(os.path.join(REVIEWS, rid + ext))
    if not target.startswith(base + os.sep):
        return None
    return target if os.path.isfile(target) else None


LOCK_OWNER = "owner"


def _remove_lock(lock):
    """The owner file, then the directory; anything else in it keeps the lock."""
    try:
        os.remove(os.path.join(lock, LOCK_OWNER))
    except FileNotFoundError:
        pass
    os.rmdir(lock)


def _lock_stale(path):
    return time.time() - os.stat(path).st_mtime > LOCK_STALE


def _break_stale_lock(lock):
    """Remove a stale lock, one breaker at a time; True when it is gone.

    Two writers that both saw it stale would otherwise both remove it, the
    second taking away the lock the first had just made fresh. The breaker
    holds <id>.lock-break (beside the lock, which stays empty), looks again,
    and removes the lock only if it is still stale. Anything else (another
    breaker, a lock that will not go) waits out the deadline like a live
    writer's lock."""
    guard = lock + "-break"
    try:
        if not _lock_stale(lock):
            return False
    except FileNotFoundError:
        return True
    except OSError:
        return False
    try:
        os.mkdir(guard)
    except FileExistsError:
        # A guard as old as a stale lock is a crashed breaker's.
        try:
            if _lock_stale(guard):
                os.rmdir(guard)
        except OSError:
            pass
        return False
    except OSError:
        return False
    try:
        if not _lock_stale(lock):
            return False
        _remove_lock(lock)
        return True
    except FileNotFoundError:
        return True
    except OSError:
        return False
    finally:
        try:
            os.rmdir(guard)
        except OSError:
            pass


class review_lock:
    """lookout's lock: a <id>.lock directory, created atomically, stale after 10s.

    A file contract (ADR 0004) with a twin that must stay in step: withLock in
    lookout/lib/store.mjs takes the same <id>.lock, breaks it through the same
    <id>.lock-break guard, with the same timings."""

    def __init__(self, rid):
        self.path = os.path.join(REVIEWS, rid + ".lock")
        self.nonce = "%d-%s" % (os.getpid(), secrets.token_hex(8))

    def __enter__(self):
        deadline = time.time() + 5
        while True:
            try:
                os.mkdir(self.path)
            except FileExistsError:
                pass
            else:
                try:
                    with open(os.path.join(self.path, LOCK_OWNER), "w") as f:
                        f.write(self.nonce)
                except OSError:
                    try:
                        os.rmdir(self.path)
                    except OSError:
                        pass
                    raise
                return self
            gone = _break_stale_lock(self.path)
            if time.time() > deadline:
                raise TimeoutError("the review is locked by another writer")
            if not gone:
                time.sleep(0.025)

    def __exit__(self, *_):
        # Ours only: a lock broken as stale and retaken carries another nonce.
        # (The window between this read and the removal needs this holder
        # past the 10s stale age; accepted, as in the Rust and JS twins.)
        try:
            with open(os.path.join(self.path, LOCK_OWNER)) as f:
                if f.read() != self.nonce:
                    return
            _remove_lock(self.path)
        except OSError:
            pass


def _iso_now():
    # The same shape as JavaScript's toISOString(), which the rest of the
    # record uses, so string comparison orders them.
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def _next_id(items, prefix):
    n = 0
    for x in items:
        tail = str(x.get("id", ""))[len(prefix):]
        if str(x.get("id", "")).startswith(prefix) and tail.isdigit():
            n = max(n, int(tail))
    return "%s%d" % (prefix, n + 1)


def _message(msgs, text, **extra):
    m = {"id": _next_id(msgs, "m"), "by": "human", "at": _iso_now(), "text": text}
    m.update(extra)
    msgs.append(m)
    return m


def review_apply(rid, body):
    """One op from the page, as the human. Returns (http code, reply dict)."""
    op = body.get("op")
    if op not in REVIEW_OPS:
        return 400, {"error": "unknown op"}
    text = str(body.get("text") or "").strip()[:REVIEW_MAX_TEXT]
    item_id = str(body.get("item") or "")
    path = os.path.join(REVIEWS, rid + ".json")
    try:
        with review_lock(rid):
            with open(path, encoding="utf-8") as fh:
                review = json.load(fh)
            findings = review.setdefault("findings", [])
            threads = review.setdefault("threads", [])
            item, kind = None, None
            if op == "answer":
                # The ownership quiz (lookout's notes): one multiple-choice
                # question per note, graded here against the stored answer
                # and recorded once, as the human's. It never gates anything.
                if not (review.get("policy") or {}).get("quiz"):
                    return 400, {"error": "this review has no quiz"}
                note = next((n for n in review.get("notes") or [] if n.get("id") == item_id), None)
                quiz = note.get("quiz") if note else None
                if not isinstance(quiz, dict):
                    return 404, {"error": "no question on note " + item_id}
                pick = body.get("pick")
                options = quiz.get("options") or []
                if not isinstance(pick, int) or isinstance(pick, bool) or not 0 <= pick < len(options):
                    return 400, {"error": "pick is an option's index as written"}
                if quiz.get("answered"):
                    return 409, {"error": "already answered", "review": review}
                quiz["answered"] = {"pick": pick, "correct": pick == quiz.get("answer"), "at": _iso_now(), "by": "human"}
            elif item_id:
                item = next((f for f in findings if f.get("id") == item_id), None)
                kind = "finding" if item else None
                if item is None:
                    item = next((t for t in threads if t.get("id") == item_id), None)
                    kind = "thread" if item else None
                if item is None:
                    return 404, {"error": "no finding or thread " + item_id}
            msgs = (item.setdefault("thread", []) if kind == "finding"
                    else item.setdefault("messages", []) if kind == "thread" else None)

            if op == "comment":
                if not text:
                    return 400, {"error": "an empty comment says nothing"}
                if item is not None:
                    _message(msgs, text)
                else:
                    f = str(body.get("file") or "")
                    side = body.get("side") or "new"
                    line = body.get("line")
                    if not any(x.get("path") == f for x in review.get("files", [])):
                        return 400, {"error": "file is not in this review"}
                    if side not in ("new", "old") or not isinstance(line, int) or isinstance(line, bool) or line < 1:
                        return 400, {"error": "a comment needs a line and a side"}
                    t = {"id": _next_id(threads, "t"), "file": f, "line": line, "side": side,
                         "status": "open", "by": "human", "createdAt": _iso_now(), "messages": []}
                    _message(t["messages"], text)
                    threads.append(t)
                    item_id = t["id"]
            elif op != "answer":
                if item is None:
                    return 400, {"error": op + " needs an item"}
                to = {"resolve": "resolved", "dismiss": "dismissed", "reopen": "open"}[op]
                if kind == "thread" and to == "dismissed":
                    to = "resolved"
                frm = item.get("status") or "open"
                item.update({"status": to, "statusBy": "human", "statusAt": _iso_now()})
                _message(msgs, text, kind="status", **{"from": frm, "to": to})

            review["updatedAt"] = _iso_now()
            tmp = "%s.tmp-%d-%s" % (path, os.getpid(), secrets.token_hex(3))
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump(review, fh, indent=2)
                fh.write("\n")
            os.replace(tmp, path)
    except FileNotFoundError:
        return 404, {"error": "no such review"}
    except (ValueError, TimeoutError) as exc:
        return 409, {"error": str(exc)}
    review_sync(rid)
    return 200, {"ok": True, "item": item_id, "review": review}


def review_sync(rid):
    """Have lookout re-rank and redraw the review (a close moves risk), in the
    background. Best-effort: without the engine the record is still right and
    the page polls it."""
    try:
        with open(LOOKOUT_POINTER, encoding="utf-8") as fh:
            root = json.load(fh).get("root") or ""
    except (OSError, ValueError):
        return
    engine = os.path.join(root, "lookout.mjs")
    node = shutil.which("node") or next((c for c in ("/opt/homebrew/bin/node", "/usr/local/bin/node")
                                         if os.path.exists(c)), None)
    if not node or not os.path.isfile(engine):
        return
    try:
        subprocess.Popen([node, engine, "sync", rid], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


