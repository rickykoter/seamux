#!/usr/bin/env bash
# crew-reclaim [-n|--dry-run] [-y|--yes] [--family-ok] [--json] [<workspace-id>|<path>]
#
# The board's Merged bucket knows a worktree can go; this is the tap that
# actually removes it. Invoked from the sidebar through the notification-hook
# RPC channel (see hooks/triage.py), or by hand.
#
# Deliberately conservative — this deletes work, so every one of these must
# hold or it refuses:
#
#   * the path is a git worktree, and NOT the primary checkout
#   * HEAD is an ancestor of the default branch (origin/HEAD, else origin/main
#     or origin/master), i.e. the work really did land
#   * the tree is clean and there are no unpushed commits
#   * no ignored file would be lost with it (.env, local settings, databases):
#     git status does not show them and git worktree remove deletes them;
#     build output, caches, symlinks and copies of the primary checkout's aside
#   * nothing live is standing in it — not this shell, not another workspace
#   * the workspace being closed has no agent mid-turn (an idle Claude is
#     closed with it: cmux needs --force for any running process, and this
#     guard is what stands in for that confirmation)
#   * no Docker sandbox is still running for it
#   * deep-plan does not protect it: no plan with work not done is rooted in
#     it, and it is no member of a family that is not done (ADR 0031)
#
# Every guard is evaluated and reported before anything is touched, so the
# answer to "why did it refuse?" is on screen in full rather than one reason at
# a time. Nothing on disk is ever forced.
#
# Interactive by default: with a tty on stdin it prints the report and waits for
# a yes. --yes skips the prompt, --dry-run stops after the report. Without a tty
# there is nobody to ask, so it behaves as it always did and just proceeds —
# that is the path a detached `fire()` from the hook still takes.
#
# --json is a dry run that prints the report as one JSON object instead (the
# seamux app's reclaim wizard reads it): the worktree, branch, size and what
# else it names, every check as {kind: pass|fail|skip|warn, text, hint}, the
# blocker count, and what it would remove. Nothing is changed; the exit code
# is the dry run's (1 with blockers).
#
# --family-ok turns the deep-plan guard from a blocker into a question: a y/N
# that names the family, asked at a terminal only (refused without one, and
# --yes does not answer it), and logged to ~/.cache/cmux-crew/family-ok.log.
# With a workspace to close, the close asks it; without one, this does.

set -uo pipefail

CMUX="${CREW_CMUX:-$(command -v cmux || true)}"
# One definition of "which cmux": bin/crew-cmux-bin. A hardcoded bundle path kept
# driving the OLD cli against the NEW app after the switch to the nightly build --
# version skew that fails silently, because the old bundle is still on disk.
[ -n "$CMUX" ] || CMUX="$("$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/crew-cmux-bin" 2>/dev/null || true)"
[ -n "$CMUX" ] || CMUX=cmux

# The real path, not the one it was run by: ~/.local/bin holds a link to it, and
# workspaces.py lives beside the real bin/, in hooks/.
SELF_DIR="$(dirname "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")")"
WORKSPACES="$SELF_DIR/../hooks/workspaces.py"
CALLER_CREW_CMUX="${CREW_CMUX:-}"

# workspaces: `seamux workspaces`, else the Python until it is deleted. seamux
# gets CREW_CMUX only when the caller set it (a probe's fakecmux): set at all,
# it means "drive the CLI", and live use belongs on the socket.
SEAMUX="${SEAMUX_BIN:-$HOME/.local/bin/seamux}"
ws_tool() {
  if [ -x "$SEAMUX" ]; then
    if [ -n "$CALLER_CREW_CMUX" ]; then CREW_CMUX="$CALLER_CREW_CMUX" "$SEAMUX" workspaces "$@"
    else env -u CREW_CMUX "$SEAMUX" workspaces "$@"; fi
  elif [ -f "$WORKSPACES" ]; then
    # A checkout run before seamux exists (the live tree has no Python).
    CREW_CMUX="$CMUX" python3 "$WORKSPACES" "$@"
  else
    printf 'crew-reclaim: seamux is not installed at %s (./install.sh --app)\n' "$SEAMUX" >&2
    return 1
  fi
}

# Under --json the report is kept, not printed: each check as kind, text and
# its note (the hint under it), each "would remove" line as what, target, note.
json=""
chk_kind=(); chk_text=(); chk_hint=()
rm_what=(); rm_target=(); rm_note=()
record() { chk_kind+=("$1"); chk_text+=("$2"); chk_hint+=(""); }

die()  { printf '\033[31m✗\033[0m %s\n' "$*" >&2; exit 1; }
ok()   { printf '\033[32m✓\033[0m %s\n' "$*"; }
say()  { [ -n "$json" ] && return 0; printf '\033[2m→\033[0m %s\n' "$*"; }
pass() { if [ -n "$json" ]; then record pass "$*"; else printf '  \033[32m✓\033[0m %s\n' "$*"; fi; }
fail() { if [ -n "$json" ]; then record fail "$*"; else printf '  \033[31m✗\033[0m %s\n' "$*"; fi; blockers=$((blockers + 1)); }
skip() { if [ -n "$json" ]; then record skip "$*"; else printf '  \033[2m·\033[0m %s\n' "$*"; fi; }
warn() { if [ -n "$json" ]; then record warn "$*"; else printf '  \033[33m!\033[0m %s\n' "$*"; fi; }
note() { if [ -n "$json" ]; then [ "${#chk_hint[@]}" -gt 0 ] && chk_hint[${#chk_hint[@]}-1]="$*"; else printf '    \033[2m%s\033[0m\n' "$*"; fi; }
head2(){ [ -n "$json" ] && return 0; printf '\n\033[1m%s\033[0m\n' "$*"; }
kv()   { [ -n "$json" ] && return 0; printf '  \033[2m%-9s\033[0m %s\n' "$1" "$2"; }
removes() { rm_what+=("$1"); rm_target+=("$2"); rm_note+=("$3")
  [ -n "$json" ] || printf '  \033[2m·\033[0m %-10s %s \033[2m(%s)\033[0m\n' "$1" "$2" "$3"; }

# The --json report: everything as arguments, one JSON object out.
emit_json() {
  python3 - "$top" "$branch" "${size:-}" "${ws_title:-$ws}" "$ws" "$plan_names" \
    "${sandboxed:+registered${sb_state:+ ($sb_state)}}" "$blockers" "$base" \
    "${#chk_kind[@]}" ${chk_kind[@]+"${chk_kind[@]}"} ${chk_text[@]+"${chk_text[@]}"} ${chk_hint[@]+"${chk_hint[@]}"} \
    "${#rm_what[@]}" ${rm_what[@]+"${rm_what[@]}"} ${rm_target[@]+"${rm_target[@]}"} ${rm_note[@]+"${rm_note[@]}"} <<'EMIT'
import json, sys
a = sys.argv[1:]
top, branch, size, ws_name, ws_id, plan, sandbox, blockers, base = a[:9]
n = int(a[9]); kinds, texts, hints = a[10:10 + n], a[10 + n:10 + 2 * n], a[10 + 2 * n:10 + 3 * n]
rest = a[10 + 3 * n:]
m = int(rest[0]); what, target, note = rest[1:1 + m], rest[1 + m:1 + 2 * m], rest[1 + 2 * m:1 + 3 * m]
print(json.dumps({
    "worktree": top, "branch": branch or None, "size": size or None, "base": base or None,
    "workspace": {"id": ws_id, "name": ws_name} if ws_id else None,
    "plan": plan or None, "sandbox": sandbox or None,
    "checks": [{"kind": k, "text": t, "hint": h or None} for k, t, h in zip(kinds, texts, hints)],
    "blockers": int(blockers),
    "remove": [{"what": w, "target": t, "note": o} for w, t, o in zip(what, target, note)],
}))
EMIT
}

dry=""
assume_yes=""
family_ok=""
arg=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -n|--dry-run) dry=1 ;;
    -y|--yes)     assume_yes=1 ;;
    --family-ok)  family_ok=1 ;;
    --json)       json=1; dry=1 ;;
    -h|--help)    sed -n '2,45p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --)           shift; arg="${1:-}"; break ;;
    -*)           die "unknown option: $1" ;;
    *)            arg="$1" ;;
  esac
  shift
done

ws=""
path=""
if [ -n "$arg" ] && [ -d "$arg" ]; then
  path="$arg"
elif [ -n "$arg" ]; then
  ws="$arg"
  path="$("$CMUX" sidebar-state --workspace "$ws" 2>/dev/null | sed -n 's/^cwd=//p')"
else
  path="$PWD"
fi
[ -n "$path" ] && [ -d "$path" ] || die "no directory for '${arg:-$PWD}'"

top="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)" || die "not a git repo: $path"

# ---------------------------------------------------------------------------
# Evaluate every guard. Nothing below this line changes anything on disk; the
# report is built first and printed whole, because a wall of context is what
# makes a delete prompt answerable.
# ---------------------------------------------------------------------------
blockers=0

common="$(git -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
gitdir="$(git -C "$path" rev-parse --path-format=absolute --git-dir 2>/dev/null)"
branch="$(git -C "$top" branch --show-current 2>/dev/null)"

# origin/HEAD names the default branch; not every repo has it set, and not every
# repo is master. Same order as crew-worktree's default_base.
default_base() {
  local head
  head="$(git -C "$top" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -n "$head" ]; then printf '%s\n' "$head"; return; fi
  for b in origin/main origin/master; do
    git -C "$top" show-ref --verify --quiet "refs/remotes/$b" && { printf '%s\n' "$b"; return; }
  done
  printf 'origin/master\n'
}

say "checking $top"
if [ -n "$branch" ]; then
  say "fetching origin"
  git -C "$top" fetch --quiet origin 2>/dev/null
fi

ahead=""
base="$(default_base)"
if [ -n "$branch" ]; then
  ahead="$(git -C "$top" rev-list --count "$base..HEAD" 2>/dev/null)"
fi
dirty_n="$(git -C "$top" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
caller_top="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)"

# Ignored files are the hole in "clean tree": `status --porcelain` leaves them
# out, and `git worktree remove` deletes them without asking. That is where a
# worktree's .env, .claude/settings.local.json, local databases and scratch notes
# live. Prints one path per line (relative to the worktree) of every ignored file
# that would be lost, leaving out what is not lost: build output and caches that
# regenerate, symlinks (only the link goes; crew-worktree links node_modules to
# the primary checkout), and a file byte-identical to the primary checkout's copy
# (crew-worktree copies .husky/_ in). Exits 2 when git cannot list them, which
# the report treats as a blocker: "could not tell" is not "none".
lost_ignored() {
  python3 - "$top" "$common" <<'IGNORED'
import filecmp, fnmatch, os, subprocess, sys
top, common = sys.argv[1], sys.argv[2]
main = os.path.dirname(common.rstrip("/")) if os.path.basename(common.rstrip("/")) == ".git" else ""
REGEN = {"node_modules", "target", "dist", "build", ".next", ".nuxt", ".turbo", ".parcel-cache",
         ".svelte-kit", "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache", ".tox",
         ".venv", "venv", ".cache", "coverage", ".nyc_output", ".gradle", ".terraform", ".eggs",
         ".DS_Store"}
GLOBS = ("*.pyc", "*.pyo", "*.egg-info")
try:
    out = subprocess.run(["git", "-C", top, "ls-files", "-z", "-o", "-i", "--exclude-standard",
                          "--directory"], capture_output=True, check=True).stdout
except Exception:
    sys.exit(2)

def regen(rel):
    parts = rel.split("/")
    if rel == ".husky/_" or rel.startswith(".husky/_/"):
        return True     # husky's generated dir; crew-worktree copies it in
    return any(p in REGEN or any(fnmatch.fnmatch(p, g) for g in GLOBS) for p in parts)

def kept(rel):
    full = os.path.join(top, rel)
    if os.path.islink(full) or regen(rel):
        return True
    twin = os.path.join(main, rel) if main else ""
    try:
        return bool(twin) and os.path.isfile(twin) and filecmp.cmp(full, twin, shallow=False)
    except OSError:
        return False

for raw in out.split(b"\0"):
    rel = os.fsdecode(raw).rstrip("/")
    if not rel or kept(rel):
        continue
    full = os.path.join(top, rel)
    if os.path.isdir(full):
        for d, dirs, files in os.walk(full):
            r = os.path.relpath(d, top)
            dirs[:] = [x for x in dirs if not kept(os.path.join(r, x))]
            for f in files:
                if not kept(os.path.join(r, f)):
                    print(os.path.join(r, f))
    else:
        print(rel)
IGNORED
}
ignored_list="$(lost_ignored)"; ignored_rc=$?
ignored_n="$(printf '%s' "$ignored_list" | grep -c . || true)"

# Unknown until cmux answers: no cmux at all is the same "could not tell" as a
# cmux that does not answer, and both block below. Never a default of 0.
others=""
ws_id=""
others_desc=""
ws_title=""
planmode_desc=""
if [ -x "$CMUX" ]; then
  # One call answers three questions: who else is standing in this worktree,
  # what the workspace we are about to close is actually called, and whether any
  # session in here is in plan mode. `plan:mode` is crew-sync's token, read off
  # the description — the same thing the board draws ◇ from.
  # Every window, not the caller's: the sweep hands this workspaces from all of
  # them, and a blocker in another window is still a blocker.
  probe="$(ws_tool list-json 2>/dev/null \
    | python3 -c '
import json,sys
try:
    ws = json.load(sys.stdin).get("workspaces") or []
except Exception:
    sys.exit(0)
top, keep = sys.argv[1], sys.argv[2]

def inside(w):
    # Path-boundary compare, not a bare prefix: sibling worktrees live under
    # <repo>.worktrees/ and their names nest (PROJ-1013-Isolated is a prefix of
    # PROJ-1013-Isolated-CLI-Page), so startswith alone reports the neighbour.
    d = w.get("current_directory") or "\0"
    return d == top or d.startswith(top.rstrip("/") + "/")

# The id from a notification is a UUID; a hand-typed one is a ref like
# workspace:4. Match either, or the workspace being reclaimed counts itself
# as a reason not to reclaim it.
def is_keep(w):
    return keep in (w.get("id"), w.get("ref"))

def label(w):
    # Always paired with the ref. Two workspaces on the same worktree usually
    # carry the same title — that is the case this guard exists to catch — so a
    # bare title names the blocker without saying which one to close.
    name = (w.get("title") or "").strip()
    if name.startswith("/") or name.startswith("\u2026/"):
        name = name.rstrip("/").rsplit("/", 1)[-1]
    ref = w.get("ref") or w.get("id") or "?"
    return "%s (%s)" % (name, ref) if name else ref

here = [w for w in ws if inside(w)]
hits = [w for w in here if not is_keep(w)]
print("COUNT %d" % len(hits))
print("KEEP %s" % next((label(w) for w in ws if is_keep(w)), ""))
print("KEEPID %s" % next((w.get("id") or "" for w in ws if is_keep(w)), ""))
for w in hits:
    print("HIT %s" % label(w))
for w in here:
    if "plan:mode" in (w.get("description") or "").split():
        print("MODE %s" % label(w))' "$top" "${ws:-none}" 2>/dev/null)"
  # No COUNT line means cmux did not answer (socket refused, mid-restart). Left
  # empty, that is a blocker below, not a pass: "could not tell" is not "none".
  others="$(printf '%s\n' "$probe" | sed -n 's/^COUNT //p')"
  ws_title="$(printf '%s\n' "$probe" | sed -n 's/^KEEP //p')"
  ws_id="$(printf '%s\n' "$probe" | sed -n 's/^KEEPID //p')"
  others_desc="$(printf '%s\n' "$probe" | sed -n 's/^HIT //p' | paste -sd, -)"
  planmode_desc="$(printf '%s\n' "$probe" | sed -n 's/^MODE //p' | paste -sd, -)"
fi

# Whether the agent in the workspace about to be closed is mid-turn. Same answer
# the board's archive chip and the sweep get, from the one reader of cmux's
# session records. "unknown" is a blocker, for the same reason as above.
life=""
if [ -n "$ws" ]; then
  life="$(ws_tool lifecycle "$ws" 2>/dev/null)"
  [ -n "$life" ] || life=unknown
fi

# --- deep-plan ---------------------------------------------------------------
# A plan with work not done, or a member of a family that is not done, is work
# living outside the worktree: deleting the tree strands it. deep-plan answers
# that itself (`deep-plan protects`, matched anywhere inside a plan's root), so
# this reads no plan state of its own. No deep-plan is no guard, said once; a
# deep-plan that does not answer is a blocker, because "could not tell" is not
# "nothing is there". CREW_DEEP_PLAN is the probe's override: a command line,
# split on whitespace.
plan_state=missing   # missing | clear | protected | error
plan_why=""
plan_slug=""
plan_family=""
if [ -n "${CREW_DEEP_PLAN:-}" ]; then
  read -r -a dp_argv <<< "$CREW_DEEP_PLAN"
elif command -v deep-plan >/dev/null 2>&1; then
  dp_argv=(deep-plan)
elif [ -x "$HOME/.local/bin/deep-plan" ]; then
  dp_argv=("$HOME/.local/bin/deep-plan")
else
  dp_argv=()
fi
if [ "${#dp_argv[@]}" -gt 0 ]; then
  dp_err="$(mktemp "${TMPDIR:-/tmp}/crew-reclaim.XXXXXX")"
  dp_out="$("${dp_argv[@]}" protects "$top" --json 2>"$dp_err")"
  dp_rc=$?
  dp_tail="$(sed '/^[[:space:]]*$/d' "$dp_err" | tail -1)"
  rm -f "$dp_err"
  if [ "$dp_rc" -eq 127 ]; then
    plan_state=missing
  elif [ "$dp_rc" -ne 0 ]; then
    plan_state=error
    plan_why="could not ask deep-plan whether live work is here (deep-plan protects failed: ${dp_tail:-exit $dp_rc})"
  else
    dp_rows="$(printf '%s' "$dp_out" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    assert isinstance(d, dict) and isinstance(d.get("protected"), bool)
except Exception:
    sys.exit(1)
fam = d.get("family") if isinstance(d.get("family"), dict) else {}
clean = lambda v: " ".join(str(v or "").split())
print("protected" if d["protected"] else "clear")
print(clean(d.get("why")))
print(clean(d.get("plan")))
print(clean(fam.get("parent")))' 2>/dev/null)"
    if [ -z "$dp_rows" ]; then
      plan_state=error
      plan_why="could not ask deep-plan whether live work is here (deep-plan protects gave an answer crew could not read)"
    else
      plan_state="$(printf '%s\n' "$dp_rows" | sed -n 1p)"
      plan_why="$(printf '%s\n' "$dp_rows" | sed -n 2p)"
      plan_slug="$(printf '%s\n' "$dp_rows" | sed -n 3p)"
      plan_family="$(printf '%s\n' "$dp_rows" | sed -n 4p)"
    fi
  fi
fi
plan_names=""
[ "$plan_state" = protected ] && plan_names="$plan_slug${plan_family:+ (the $plan_family family)}"

# Registry presence is the cheap host-side answer to "was this sandboxed?", so
# the common non-sandboxed case never touches sbx and never wakes its daemon.
CREW_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/cmux-crew"
md5_of() { printf '%s' "$1" | md5 -q 2>/dev/null || printf '%s' "$1" | md5sum | cut -d' ' -f1; }
SANDBOX_BIN="$(dirname "$0")/crew-sandbox"
sb_reg="$CREW_CACHE/sandbox/roots/$(md5_of "$top")"
sandboxed=""
[ -f "$sb_reg" ] && sandboxed=1

# A running microVM holds the mount open and is still executing an agent. Same
# reasoning as the "another workspace is open here" guard: refuse rather than
# pull the ground out from under something live. `status` is side-effect free —
# it never starts the daemon — so this stays cheap and safe when sbx is absent,
# signed out, or stopped.
#
# Bounded, because `sbx ls --json` can wedge for minutes when the daemon is
# unwell and crew-sandbox's own reader has no timeout — a delete prompt frozen
# with nothing on screen is worse than a slow one. A probe that never answers
# counts as a blocker rather than a pass: "I could not tell" and "it is not
# running" are different sentences when the next step unmounts it.
sb_state=""
if [ -n "$sandboxed" ] && [ -x "$SANDBOX_BIN" ]; then
  say "asking sbx about the sandbox"
  sb_state="$(python3 - "$SANDBOX_BIN" "$top" 2>/dev/null <<'SBXPROBE'
import json, subprocess, sys
try:
    r = subprocess.run([sys.argv[1], "status", sys.argv[2], "--json"],
                       capture_output=True, text=True, timeout=20)
    print(json.loads(r.stdout).get("state", ""))
except subprocess.TimeoutExpired:
    print("unreachable")
except Exception:
    pass
SBXPROBE
)"
fi

size="$(du -sh "$top" 2>/dev/null | cut -f1)"

head2 "reclaim ${branch:-<detached>}"
kv worktree "$top"
kv branch   "${branch:-<detached HEAD>}"
kv size     "${size:-?}"
[ -n "$ws" ] && kv workspace "${ws_title:-$ws}"
[ -n "$plan_names" ] && kv plan "$plan_names"
[ -n "$sandboxed" ] && kv sandbox "registered${sb_state:+ ($sb_state)}"

printf '\n'
if [ "$gitdir" != "$common" ]; then
  pass "linked worktree, not the primary checkout"
else
  fail "$top is the primary checkout, not a worktree"
fi

if [ -z "$branch" ]; then
  fail "detached HEAD — resolve it by hand"
  skip "merge check skipped: no branch"
elif [ "${ahead:-1}" = "0" ]; then
  pass "merged: HEAD is an ancestor of $base"
else
  fail "${ahead:-?} commit(s) not in $base — not merged"
fi

if [ "${dirty_n:-0}" = "0" ]; then
  pass "clean tree, nothing uncommitted"
else
  fail "$dirty_n uncommitted change(s)"
fi

# Ignored files `git status` does not show and `git worktree remove` deletes.
# There is no flag past this one, as there is none past uncommitted changes:
# nothing on disk is ever forced.
if [ "$ignored_rc" -ne 0 ]; then
  fail "git could not list the ignored files — could not tell what would be lost with it"
elif [ "$ignored_n" -eq 0 ]; then
  pass "no ignored files that would be lost (build output and caches aside)"
else
  ignored_names="$(printf '%s\n' "$ignored_list" | head -5 | paste -sd, - | sed 's/,/, /g')"
  [ "$ignored_n" -gt 5 ] && ignored_names="$ignored_names, +$((ignored_n - 5)) more"
  fail "$ignored_n ignored file(s) would be deleted with it: $ignored_names"
  note "git status does not show these and git worktree remove does not ask — move them out of $top (or delete them) first"
fi

# Planning is unfinished work that does not show up in `git status`. A deep-plan
# lives in ~/.claude/deep-plan and points back at this root; plan mode means a
# session here is still deciding what to do. Deleting the tree under either one
# strands it — and in the deep-plan case the plan outlives the worktree, so what
# you lose is the thing you were about to build, not the build.
family_ask=""
case "$plan_state" in
  protected|error)
    if [ -z "$family_ok" ]; then
      fail "$plan_why"
      note "finish it first — or, at a terminal, crew-reclaim --family-ok asks before it goes"
    elif [ ! -t 0 ]; then
      fail "$plan_why; --family-ok needs a person at a terminal"
    else
      warn "$plan_why"
      note "--family-ok: you are asked to confirm before it goes"
      family_ask=1
    fi ;;
  missing) skip "deep-plan is not installed — no plan guard" ;;
  *)       pass "no live plan or family work here" ;;
esac
if [ -n "$planmode_desc" ]; then
  fail "a session here is in plan mode: $planmode_desc"
  note "leave plan mode there, or close it — crew-sync drops the token within 120s"
fi

# Never delete the ground you are standing on. Removing the caller's own
# worktree yanks the cwd out from under the shell (and any agent) running in it.
# Learned the hard way: every other guard passed and it deleted the live
# worktree mid-session.
if [ "$caller_top" != "$top" ]; then
  pass "this shell is not inside it"
else
  fail "this shell is inside $top — run it from elsewhere"
fi

# The close is forced now, so it would take this terminal down with it — after
# the close, before the removal. Same reason the board opens its reclaim
# terminal anywhere but the workspace being reclaimed.
if [ -n "$ws" ]; then
  if [ -n "${CMUX_WORKSPACE_ID:-}" ] && [ "$CMUX_WORKSPACE_ID" = "${ws_id:-$ws}" ]; then
    fail "this terminal is in ${ws_title:-$ws}, the workspace it would close — run it from another"
  else
    pass "this terminal is not in the workspace it closes"
  fi
fi

if [ ! -x "$CMUX" ]; then
  fail "cmux not found ($CMUX) — could not tell whether another workspace is open here"
  note "put cmux on PATH, or point CREW_CMUX at it"
elif [ -z "$others" ]; then
  fail "cmux did not list its workspaces — could not tell whether another is open here"
elif [ "$others" -eq 0 ]; then
  pass "no other cmux workspace is open here"
else
  fail "$others other workspace(s) still open here${others_desc:+: $others_desc}"
fi

case "$life" in
  "")      ;;
  running) fail "an agent is mid-turn in ${ws_title:-$ws} — let the turn end first" ;;
  idle)    pass "the agent in ${ws_title:-$ws} is idle — it is closed with the workspace" ;;
  none)    pass "no agent is running in ${ws_title:-$ws}" ;;
  *)       fail "could not tell whether an agent is mid-turn in ${ws_title:-$ws}" ;;
esac

case "$sb_state" in
  *running*)   fail "a sandbox is still running — run: crew-sandbox down $top" ;;
  unreachable) fail "sbx did not answer in 20s — check: crew-sandbox status $top" ;;
  "")          [ -n "$sandboxed" ] && pass "sandbox is not running" || skip "never sandboxed" ;;
  *)           pass "sandbox is not running ($sb_state)" ;;
esac

[ -n "$json" ] || printf '\n'
if [ "$blockers" -gt 0 ]; then
  if [ -n "$json" ]; then emit_json; exit 1; fi
  printf '\033[31m%s blocker(s) — nothing was changed.\033[0m\n' "$blockers"
  exit 1
fi

[ -n "$json" ] || printf '\033[1mWould remove\033[0m\n'
removes worktree "$top" "${size:-?}"
removes branch "$branch" "safe delete; kept if git declines"
[ -n "$ws" ] && removes workspace "${ws_title:-$ws}" "closed first, with whatever runs in it"
[ -n "$sandboxed" ] && removes sandbox "the microVM and its image cache" "destroyed before the directory goes"

if [ -n "$json" ]; then emit_json; exit 0; fi
if [ -n "$dry" ]; then
  printf '\n\033[2mDry run — nothing was changed.\033[0m\n'
  exit 0
fi

# A tty means there is somebody to ask. Without one — a detached fire() from the
# notification hook, or a script — asking would hang forever, so it proceeds.
if [ -z "$assume_yes" ] && [ -t 0 ]; then
  printf '\n\033[1mProceed?\033[0m \033[2m[y/N]\033[0m '
  reply=""
  read -r reply || reply=""
  case "$reply" in
    y|Y|yes|YES) printf '\n' ;;
    *) printf '\033[2maborted — nothing was changed.\033[0m\n'; exit 130 ;;
  esac
fi

# ---------------------------------------------------------------------------
# Past this line it deletes. Re-check the guards that a human could have
# invalidated while the prompt sat there; the fetch is not repeated, since a
# branch cannot become unmerged.
# ---------------------------------------------------------------------------
[ -z "$(git -C "$top" status --porcelain 2>/dev/null | head -1)" ] \
  || die "$top picked up uncommitted changes while you were deciding — refusing"
ignored_now="$(lost_ignored)" && [ -z "$ignored_now" ] \
  || die "$top picked up ignored files that would be lost while you were deciding — refusing"
if [ -n "$ws" ]; then
  case "$(ws_tool lifecycle "$ws" 2>/dev/null)" in
    idle|none) ;;
    running) die "an agent started a turn in ${ws_title:-$ws} while you were deciding — refusing" ;;
    *)       die "could not tell whether an agent is mid-turn in ${ws_title:-$ws} — refusing" ;;
  esac
fi

# The family question, which --yes never answers. With a workspace to close,
# the close asks it (and logs the yes), so it is asked once; without one, it
# is asked here, in the same words and the same log.
if [ -n "$family_ask" ] && [ -z "$ws" ]; then
  if [ -n "$plan_family" ]; then what="The $plan_family family is not done."
  elif [ -n "$plan_slug" ]; then what="Plan $plan_slug is live there."
  else what="Deep-plan could not say."; fi
  printf '\n%s\n\033[1mReclaim %s anyway?\033[0m %s \033[2m[y/N]\033[0m ' "$plan_why" "$top" "$what"
  reply=""
  read -r reply || reply=""
  case "$reply" in
    y|Y|yes|YES) printf '\n' ;;
    *) printf '\033[2mkept — nothing was changed.\033[0m\n'; exit 130 ;;
  esac
  FAMILY_LOG="${XDG_CACHE_HOME:-$HOME/.cache}/cmux-crew/family-ok.log"
  python3 -c '
import json, os, sys, time
log, cwd, plan, family, why = sys.argv[1:6]
os.makedirs(os.path.dirname(log), exist_ok=True)
with open(log, "a") as fh:
    fh.write(json.dumps({"at": time.time(), "cwd": cwd, "workspace": "", "plan": plan,
                         "family": family, "why": why, "by": "crew-reclaim"}) + "\n")
' "$FAMILY_LOG" "$top" "$plan_slug" "$plan_family" "$plan_why" \
    || die "could not log the --family-ok override — nothing was changed"
fi

say "reclaiming $top ($branch, ${size:-?})"

# Close the workspace first so cmux is not left pointing at a deleted path —
# and stop here if it will not go. A close that fails in silence is how a
# worktree got removed out from under a workspace that was still open on it.
# The close runs the same plan guard; under --family-ok it asks the family
# question on this terminal, so its stderr is left on the terminal too.
if [ -n "$ws" ] && [ -n "$family_ask" ]; then
  ws_tool close --family-ok "$ws" >/dev/null \
    || die "${ws_title:-$ws} was not closed (above) — nothing was removed"
  ok "closed workspace ${ws_title:-$ws}"
elif [ -n "$ws" ]; then
  why="$(ws_tool close "$ws" 2>&1 >/dev/null)" \
    || die "cmux did not close ${ws_title:-$ws} (${why:-no answer}) — nothing was removed"
  ok "closed workspace ${ws_title:-$ws}"
fi

# Destroy the microVM before the directory goes: it has the worktree mounted, and
# an orphaned sandbox keeps a whole private image cache on disk. Host files are
# never copied in, so nothing of yours lives inside it.
if [ -n "$sandboxed" ] && [ -x "$SANDBOX_BIN" ]; then
  if "$SANDBOX_BIN" rm "$top" >/dev/null 2>&1; then
    ok "removed sandbox"
  else
    say "could not remove the sandbox — check: crew-sandbox status $top"
  fi
  rm -f "$sb_reg"
fi

# Through the worktree's own repository, named by its common git dir: crew
# worktrees can belong to any repo, not only the baked main one. Never --force:
# what git refuses to remove is exactly what this has to keep.
git -C "$common" worktree remove "$top" \
  || die "git refused to remove $top (reason above) — nothing was forced"
ok "removed worktree $top"

# The branch is merged, so -d (safe delete) is enough; never -D.
if git -C "$common" branch -d "$branch" >/dev/null 2>&1; then
  ok "deleted branch $branch"
else
  say "kept branch $branch (git declined a safe delete)"
fi

# A VS Code window pinned to this worktree outlives the directory: it stays open
# on a tree that reports zero files until you close it. Nothing here can close
# it for you — VS Code ships no `code --close`, and the osascript route needs
# accessibility access this machine does not grant — so say so once, at the end,
# where it is the last thing on screen.
CODE_HELPER="$(dirname "$0")/crew-code"
if [ -x "$CODE_HELPER" ] && "$CODE_HELPER" windows 2>/dev/null | grep -Fxq "$top"; then
  say "VS Code still has a window open on $top — close it by hand"
fi

"$CMUX" notify --title "crew" --subtitle "crew:reclaimed" \
  --body "$branch — ${size:-?} reclaimed" >/dev/null 2>&1 || true
ok "reclaimed ${size:-?}"
