#!/usr/bin/env bash
# crew — install, inspect, and remove the cmux crew layer.
#
#   crew status     what is installed and live right now
#   crew adopt      back-fill a session that started before crew was applied
#   crew sync       reconcile every workspace against what is actually true
#   crew timer      on|off|status — periodic reconcile via launchd (opt-in)
#   crew listen     on|off|status|log — reconcile on cmux workspace events (opt-in)
#   crew color      list|show|assign|apply|free|prune — per-worktree identity color
#   crew doctor     check the install, exit non-zero if something is wrong
#   crew apply      install the live tree from the plugin, render config, sidebar + Dock
#                   (--dry-run says what it would do and changes nothing)
#   crew on|off     enable / disable at runtime (hooks stay wired, become no-ops)
#   crew uninstall  restore the pre-crew cmux.json, remove legacy Claude hook entries
#   crew demo       fire each hook with a synthetic payload and show the effect
#
# Design notes:
#   - cmux has no config include mechanism, so `apply` renders the whole of
#     ~/.config/cmux/cmux.json from config/cmux.jsonc. The live file is copied
#     to a timestamped .bak first; `uninstall` restores the newest one.
#   - ~/.claude/hooks/cmux/guard_bash.sh is deliberately NOT part of crew. It
#     enforces the never-force-push / no---no-verify rules, and disabling crew
#     must never disable it.

set -uo pipefail

# Resolve through symlinks: `crew` is normally invoked via ~/.local/bin/crew, so
# a naive dirname would make CREW_HOME ~/.local and every package path miss.
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P -- "$(dirname -- "$_src")" && pwd)"
  _src="$(readlink -- "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
CREW_HOME="$(cd -P -- "$(dirname -- "$_src")/.." && pwd)"
# The live tree: what cmux, launchd, the board and the intent server run, at a
# path that never moves. When this script runs from anywhere else (the crew
# plugin's root, which carries its version in the path), `crew apply` copies
# that root here first. CREW_LIVE is for tests.
LIVE="${CREW_LIVE:-$HOME/.config/cmux/crew}"
CMUX_JSON="$HOME/.config/cmux/cmux.json"
SETTINGS="$HOME/.claude/settings.json"
SIDEBAR_DIR="$HOME/.config/cmux/sidebars"
STATE="${XDG_CACHE_HOME:-$HOME/.cache}/cmux-crew"
LOCALBIN="$HOME/.local/bin"
MONOLITH="${CREW_MONOLITH:-__MAIN_REPO__}"
HOOK="$CREW_HOME/hooks/crew-hook.sh"

CMUX="$(command -v cmux || true)"
# One definition of "which cmux": bin/crew-cmux-bin. A hardcoded bundle path kept
# driving the OLD cli against the NEW app after the switch to the nightly build --
# version skew that fails silently, because the old bundle is still on disk.
[ -n "$CMUX" ] || CMUX="$("$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/crew-cmux-bin" 2>/dev/null || true)"
[ -n "$CMUX" ] || CMUX=cmux

ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$*"; FAIL=1; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }
head_() { printf '\n\033[1m%s\033[0m\n' "$*"; }
# For what is neither healthy nor sick: a declined integration is a choice,
# not a symptom, and must never read as one.
note() { printf '  \033[2m· %s\033[0m\n' "$*"; }

# integrations.json: rendered from the crew plugin's options (hooks/options.py), or
# written by the old installer; absent means all disabled.
# integ <name> <key> prints the key's value ("" when disabled/absent).
integ() {
  python3 - "$CREW_HOME/integrations.json" "$1" "${2:-enabled}" 2>/dev/null <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1])).get(sys.argv[2]) or {}
    v = d.get(sys.argv[3])
    if v is True: print("yes")
    elif v: print(v)
except Exception:
    pass
PY
}

# Whether integrations.json was rendered from the crew plugin's options
# (hooks/options.py marks it) rather than written by the old installer.
integ_from_options() {
  python3 -c 'import json,sys;sys.exit(0 if (json.load(open(sys.argv[1])) or {}).get("managedBy") else 1)' \
    "$CREW_HOME/integrations.json" 2>/dev/null
}

# __INTENT_PORT__ feeds the web Dock's /usage browser control; it must match
# the intent server's pin (crew-board-intent free_port, same default).
render() { sed -e "s|__HOME__|$HOME|g" -e "s|__INTENT_PORT__|${CREW_INTENT_PORT:-7345}|g" "$1"; }

# Machine-local overlay, deliberately a SIBLING of this package rather than a
# child: install.sh moves the whole crew tree aside on upgrade, and drift_check
# only walks $HERE/crew, $HERE/deep-plan and $DEST -- so a sibling survives the
# move and stays silent in the check. Nothing here is ever in the repo.
CREW_LOCAL="${CREW_LOCAL:-$HOME/.config/cmux/crew-local}"

# render_local <template> <overlay-name>
# With no overlay this is render, comments and all -- byte-identical output on a
# machine that has none. With one, the rendered JSONC is parsed, deep-merged and
# re-emitted as strict JSON. A broken overlay fails loudly rather than shipping
# an unmerged config, because "my overlay is being ignored" is the exact bug
# class this exists to remove.
# The overlay goes through `render` too, not just the template. Overlay content
# is usually lifted straight out of a config template, so it arrives carrying
# __HOME__ and __INTENT_PORT__ -- and a merge that substituted only one side
# shipped a `db` control whose command began with a literal "__HOME__/".
render_local() {
  local ov="$CREW_LOCAL/$2"
  if [ ! -f "$ov" ]; then render "$1"; return; fi
  render "$1" | python3 "$CREW_HOME/bin/crew-overlay" <(render "$ov") "$ov"
}

# --------------------------------------------------------- plugin plumbing --
# Whether Claude has a plugin enabled, by name, in any marketplace.
plugin_enabled() {
  python3 - "$SETTINGS" "$1" <<'PY' 2>/dev/null
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
sys.exit(0 if any(k.split("@")[0] == sys.argv[2] and v
                  for k, v in (d.get("enabledPlugins") or {}).items()) else 1)
PY
}

# The directory Claude runs a plugin from; "" when it is not installed. Not
# simply installPath: a folder marketplace's plugin runs from the folder, while
# its installPath names a cache snapshot (bin/crew-plugin-root says more).
plugin_install_path() {
  python3 "$CREW_HOME/bin/crew-plugin-root" "$1" 2>/dev/null
}

# How many settings.json hook entries still run crew-hook.sh (the wiring the
# old `crew apply` wrote; the crew plugin's hooks.json replaces it).
legacy_hook_count() {
  python3 - "$SETTINGS" <<'PY' 2>/dev/null || echo 0
import json, sys
try:
    s = json.load(open(sys.argv[1]))
except Exception:
    print(0); sys.exit(0)
print(sum("crew-hook.sh" in (h.get("command") or "")
          for ms in (s.get("hooks") or {}).values() for m in ms for h in m.get("hooks", [])))
PY
}

# The repo the worktree helpers default to, baked over __MAIN_REPO__:
# $CREW_MONOLITH, else the crew plugin's main_repo option, else what the live
# tree already has baked (a re-apply), else the one git repo under ~/code.
# Empty when none of those answers.
resolve_main() {
  if [ -n "${CREW_MONOLITH:-}" ]; then printf '%s\n' "$CREW_MONOLITH"; return; fi
  local opt
  opt="$(python3 "$CREW_HOME/hooks/options.py" --from-settings --get main_repo 2>/dev/null)"
  if [ -n "$opt" ]; then printf '%s\n' "$opt"; return; fi
  local baked=""
  [ -f "$LIVE/bin/crew" ] && baked="$(sed -n 's/^MONOLITH="\${CREW_MONOLITH:-\(.*\)}"$/\1/p' "$LIVE/bin/crew" | head -1)"
  # Spelled in two halves wherever this file names the placeholder: the bake
  # rewrites every whole occurrence in the live copy, these included.
  if [ -n "$baked" ] && [ "$baked" != "__MAIN_""REPO__" ]; then printf '%s\n' "$baked"; return; fi
  local cands
  cands="$(find "$HOME/code" -maxdepth 2 -name .git -print 2>/dev/null | sed 's|/\.git$||' | grep -v '\.worktrees/' | sort)"
  [ "$(printf '%s\n' "$cands" | grep -c .)" = 1 ] && printf '%s\n' "$cands"
}

# The plugin root the live tree should be a copy of: the one recorded at the
# last apply, unless Claude has since installed another version (an update),
# in which case that one. "" for a tree installed the old way, from a checkout.
plugin_version() { sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$1/.claude-plugin/plugin.json" 2>/dev/null | head -1; }
plugin_source() {
  local rec="" inst
  rec="$(cat "$LIVE/.seamux-source" 2>/dev/null)"
  [ -n "$rec" ] && [ -f "$rec/.claude-plugin/plugin.json" ] || rec=""
  inst="$(plugin_install_path crew)"
  [ -n "$inst" ] && [ -f "$inst/.claude-plugin/plugin.json" ] || inst=""
  if [ -n "$rec" ] && [ -n "$inst" ] && [ "$(plugin_version "$rec")" != "$(plugin_version "$inst")" ]; then
    printf '%s\n' "$inst"
  else
    printf '%s\n' "${rec:-$inst}"
  fi
}

# Files that differ between a plugin root and the live tree, one per line, as
# "differs|source-only|live-only <path>". The main repo baked into the live
# tree is put back to __MAIN_REPO__ before comparing; install-time state
# (.seamux-source, integrations.json) and caches are not compared.
crew_drift() {
  python3 - "$1" "$LIVE" "$(resolve_main)" <<'PY'
import os, sys
src, live, main = sys.argv[1], sys.argv[2], sys.argv[3]
SKIP_DIRS = {"__pycache__", "types"}
SKIP = {".seamux-source", "integrations.json", ".DS_Store"}
def files(root):
    out = set()
    for d, dirs, fs in os.walk(root):
        dirs[:] = [x for x in dirs if x not in SKIP_DIRS]
        for f in fs:
            if f in SKIP or f.endswith(".pyc"):
                continue
            out.add(os.path.relpath(os.path.join(d, f), root))
    return out
a, b = files(src), files(live)
for rel in sorted(a | b):
    if rel not in b: print("source-only", rel); continue
    if rel not in a: print("live-only", rel); continue
    x = open(os.path.join(src, rel), "rb").read()
    y = open(os.path.join(live, rel), "rb").read()
    if main:
        y = y.replace(main.encode(), b"__MAIN_" + b"REPO__")
    if x != y:
        print("differs", rel)
PY
}

# `crew apply` from the plugin root: make the live tree a copy of it, then let
# the live copy's own apply do the rest, so every path it links, renders and
# registers with launchd is the stable one.
apply_from_source() {
  local src="$CREW_HOME" dry="$1" main n_legacy
  main="$(resolve_main)"
  n_legacy="$(legacy_hook_count)"
  head_ "crew apply  (source ${src/#$HOME/~})"
  if [ "$dry" = 1 ]; then
    printf '  would move %s aside to ~/.config/cmux/crew-backups/, keeping integrations.json\n' "${LIVE/#$HOME/~}"
    printf '  would copy %s -> %s\n' "${src/#$HOME/~}" "${LIVE/#$HOME/~}"
    printf '  would record the source in %s/.seamux-source\n' "${LIVE/#$HOME/~}"
    if [ -n "$main" ]; then printf '  would bake the main repo: %s\n' "$main"
    else printf '  no main repo found: __MAIN_REPO__ stays (set CREW_MONOLITH)\n'; fi
    printf '  then run the live copy'"'"'s apply: render cmux.json, link commands, sidebar, Dock,\n'
    printf '  install the deep-plan and restack shims through their engine pointers\n'
    printf '  settings.json: no hook entries written (the crew plugin'"'"'s hooks.json wires them);\n'
    printf '  statusLine and the push flags merged (claude/merge_settings.py)\n'
    printf '  %s legacy crew-hook.sh entr%s to remove\n' "$n_legacy" "$([ "$n_legacy" = 1 ] && echo y || echo ies)"
    return 0
  fi
  local prev_integ=""
  [ -f "$LIVE/integrations.json" ] && prev_integ="$(cat "$LIVE/integrations.json")"
  if [ -d "$LIVE" ]; then
    local bak="$(dirname "$LIVE")/crew-backups/crew.$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$(dirname "$bak")" && mv "$LIVE" "$bak" || { bad "could not move $LIVE aside"; return 1; }
    ok "moved the live tree aside -> ${bak/#$HOME/~}"
  fi
  mkdir -p "$LIVE" && cp -R "$src/." "$LIVE/" || { bad "could not copy $src -> $LIVE"; return 1; }
  ok "copied ${src/#$HOME/~} -> ${LIVE/#$HOME/~}"
  # Provenance: `crew doctor` compares the live tree against this root.
  printf '%s\n' "$src" > "$LIVE/.seamux-source"
  [ -n "$prev_integ" ] && printf '%s\n' "$prev_integ" > "$LIVE/integrations.json" && ok "kept integrations.json"
  if [ -n "$main" ]; then
    grep -rl '__MAIN_''REPO__' "$LIVE" 2>/dev/null | while read -r f; do
      python3 - "$f" "$main" <<'PY'
import io, sys
p, main = sys.argv[1], sys.argv[2]
t = io.open(p, encoding="utf-8").read()
io.open(p, "w", encoding="utf-8").write(t.replace("__MAIN_" + "REPO__", main))
PY
    done
    ok "main repo baked: $main"
  else
    warn "no main repo found: worktree helpers keep __MAIN_REPO__ (set CREW_MONOLITH and re-apply)"
  fi
  exec env CREW_APPLY_FROM="$src" CREW_MONOLITH="${main:-${CREW_MONOLITH:-}}" "$LIVE/bin/crew" apply
}

# deep-plan and restack each keep a pointer to their engine; this installs the
# ~/.local/bin shims that exec through them, by running each engine's own
# `setup`. Before the first Claude session after an install there is no
# pointer yet, so the engine is found once through Claude's install record.
install_engine_shims() {
  local name script setup_out root node=""
  if command -v node >/dev/null 2>&1; then node=node
  else
    for c in "$HOME/.asdf/shims/node" /opt/homebrew/bin/node /usr/local/bin/node; do
      [ -x "$c" ] && node="$c" && break
    done
  fi
  for pair in deep-plan:deep_plan.mjs restack:restack.mjs; do
    name="${pair%%:*}"; script="${pair#*:}"
    root="$(sed -n 's/^  "root": "\(.*\)",\{0,1\}$/\1/p' "$HOME/.claude/$name/engine.json" 2>/dev/null)"
    [ -f "$root/$script" ] || root="$(plugin_install_path "$name")"
    if [ -z "$root" ] || [ ! -f "$root/$script" ]; then
      note "$name plugin not installed — no $name shim"
      continue
    fi
    [ -n "$node" ] || { warn "node not found — could not install the $name shim"; continue; }
    if setup_out="$("$node" "$root/$script" setup 2>&1)"; then
      ok "$name shim and engine pointer (engine ${root/#$HOME/~})"
    else
      warn "$name setup failed: $(printf '%s' "$setup_out" | tail -1)"
    fi
  done
}

# Remove settings.json hook entries that run crew-hook.sh, backing the file up
# first. Every other hook is left exactly as found.
strip_legacy_hooks() {
  cp "$SETTINGS" "$SETTINGS.pre-crew-plugin.$(date +%Y%m%d-%H%M%S).bak"
  python3 - "$SETTINGS" <<'PY'
import json, sys
p = sys.argv[1]
with open(p) as fh:
    s = json.load(fh)
hooks = s.get("hooks", {})
for event, matchers in list(hooks.items()):
    for m in matchers:
        m["hooks"] = [h for h in m.get("hooks", [])
                      if "crew-hook.sh" not in (h.get("command") or "")]
    hooks[event] = [m for m in matchers if m.get("hooks")]
    if not hooks[event]:
        del hooks[event]
with open(p, "w") as fh:
    json.dump(s, fh, indent=2)
    fh.write("\n")
PY
}

# ---------------------------------------------------------------- apply -----
cmd_apply() {
  local dry=0
  [ "${1:-}" = "--dry-run" ] && dry=1
  # Not the live tree: this is the plugin's root (or a checkout). Install the
  # live tree from it, then hand over to the live copy.
  if [ "$CREW_HOME" != "$LIVE" ]; then
    apply_from_source "$dry"; return $?
  fi
  # The live tree, run by hand (~/.local/bin/crew): when it was installed from
  # a plugin, re-copy from that plugin first, so `crew apply` after a plugin
  # update is what lands the update. The source's apply hands back here.
  if [ -z "${CREW_APPLY_FROM:-}" ]; then
    local src; src="$(plugin_source)"
    if [ -n "$src" ] && [ -x "$src/bin/crew" ]; then
      exec "$src/bin/crew" apply "$@"
    fi
  fi
  if [ "$dry" = 1 ]; then
    head_ "crew apply --dry-run  (live tree)"
    printf '  would re-render cmux.json, relink commands, reinstall sidebar and Dock\n'
    printf '  settings.json: %s\n' "$(plugin_enabled crew && echo "no hook entries written; $(legacy_hook_count) legacy crew-hook.sh entries to remove" || echo "legacy wiring rewritten (the crew plugin is not enabled)")"
    return 0
  fi
  head_ "crew apply"

  mkdir -p "$HOME/.config/cmux" "$SIDEBAR_DIR" "$STATE"

  # 1. back up whatever cmux.json is there now — but only if it is not already
  #    crew's own output. Re-applying must never overwrite the pre-crew backup
  #    with a crew-rendered one, or `crew uninstall` can no longer get you home.
  if [ -f "$CMUX_JSON" ]; then
    if grep -q "crew-triage" "$CMUX_JSON" 2>/dev/null; then
      ok "cmux.json is already crew-rendered — keeping the existing backup"
    else
      local bak="$CMUX_JSON.$(date +%Y%m%d-%H%M%S).bak"
      cp "$CMUX_JSON" "$bak"
      ok "backed up cmux.json -> $(basename "$bak")"
    fi
  fi

  # 2. render config
  render_local "$CREW_HOME/config/cmux.jsonc" cmux.json > "$CMUX_JSON"
  ok "rendered cmux.json from config/cmux.jsonc"

  # 3. put the commands on PATH. ~/.local/bin is already there, so this needs
  #    no shell-config edit. crew-code-open is deliberately excluded: cmux
  #    invokes it by absolute path, nobody types it.
  if [ -d "$LOCALBIN" ] || mkdir -p "$LOCALBIN" 2>/dev/null; then
    local linked=0
    for f in crew crew-color crew-diff crew-code crew-digest crew-feed crew-reclaim crew-resume crew-sandbox crew-spec crew-sync crew-worktree crew-watch crew-listen; do
      ln -sf "$CREW_HOME/bin/$f" "$LOCALBIN/$f" && linked=$((linked + 1))
    done
    # The board lives in board/, not bin/: it is a surface with an HTML shell beside it.
    for f in crew-board crew-board-diag; do
      ln -sf "$CREW_HOME/board/$f" "$LOCALBIN/$f" && linked=$((linked + 1))
    done
    ok "linked $linked commands into $LOCALBIN"
  fi

  # 4. sidebar
  cp "$CREW_HOME/sidebars/crew.swift" "$SIDEBAR_DIR/crew.swift"
  ok "installed sidebar -> $SIDEBAR_DIR/crew.swift"

  # 4. project Dock, untracked
  if [ -d "$MONOLITH/.git" ]; then
    mkdir -p "$MONOLITH/.cmux"
    render_local "$CREW_HOME/config/dock.json" dock.json > "$MONOLITH/.cmux/dock.json"
    local ex="$MONOLITH/.git/info/exclude"
    if ! grep -qx '.cmux/' "$ex" 2>/dev/null; then
      printf '\n# crew (local cmux Dock config)\n.cmux/\n' >> "$ex"
    fi
    ok "installed Dock -> $MONOLITH/.cmux/dock.json (untracked)"
  else
    warn "no monolith checkout at $MONOLITH — skipped Dock"
  fi

  # 4b. global Dock (web Dock beta). Many hobby repos, one board: the global
  #     config seeds every workspace's Dock; a repo's own .cmux/dock.json still
  #     wins wholesale in that repo (precedence, not merge — which is why the
  #     project copy above carries the same board/usage controls).
  if [ -f "$HOME/.config/cmux/dock.json" ] && ! grep -q '"id": *"board"' "$HOME/.config/cmux/dock.json" 2>/dev/null; then
    cp "$HOME/.config/cmux/dock.json" "$HOME/.config/cmux/dock.json.pre-crew.bak"
    ok "backed up dock.json -> dock.json.pre-crew.bak"
  fi
  render_local "$CREW_HOME/config/dock.global.json" dock.global.json > "$HOME/.config/cmux/dock.json"
  ok "installed global Dock -> ~/.config/cmux/dock.json (board + usage)"

  # 5. Claude hooks. The crew plugin wires them from its own hooks.json, so
  #    apply writes none, and removes the settings.json entries the old apply
  #    wrote (they would fire every hook twice). A machine on the old install,
  #    with no crew plugin, keeps the old wiring until the bootstrap migrates it.
  if [ -n "${CREW_APPLY_FROM:-}" ] || plugin_enabled crew; then
    local n_legacy; n_legacy="$(legacy_hook_count)"
    if [ "$n_legacy" -gt 0 ] 2>/dev/null; then
      if strip_legacy_hooks; then
        ok "removed $n_legacy legacy crew-hook.sh entries from settings.json (backup kept)"
      else
        bad "could not remove the legacy crew-hook.sh entries — every hook fires twice"
      fi
    fi
    ok "Claude hooks come from the crew plugin (settings.json carries none)"
  else
    # Back up settings.json the same way, and for the same reason: apply
    # supersedes the v1 bridge hooks, and `uninstall` strips crew surgically
    # rather than restoring wholesale.
    if [ -f "$SETTINGS" ] && ! grep -q "crew-hook.sh" "$SETTINGS" 2>/dev/null; then
      cp "$SETTINGS" "$SETTINGS.pre-crew.$(date +%Y%m%d-%H%M%S).bak"
      ok "backed up settings.json (pre-crew hook wiring)"
    fi
    # Not `&& ok`: a silent wiring failure is the one failure mode that leaves an
    # install looking complete and doing nothing.
    if wire_hooks; then
      warn "wired Claude hooks in settings.json (legacy: claude plugin install crew@seamux replaces this)"
    else
      bad "could not wire Claude hooks — the board will show no agent state"
    fi
  fi

  # 5b. The deep-plan and restack commands for a human shell and the go chip.
  install_engine_shims

  # 5c. The crew plugin's options -> integrations.json, for a machine where no
  #     session has run since they were set (the SessionStart hook does the same).
  python3 "$CREW_HOME/hooks/options.py" --from-settings \
    && ok "integrations.json follows the crew plugin's options$(grep -q managedBy "$CREW_HOME/integrations.json" 2>/dev/null || echo ' (none set; earlier answers kept)')" \
    || warn "could not render the crew plugin's options into integrations.json"

  # 5d. The status line and the phone-push flags: the two things a plugin
  #     cannot set, merged into settings.json (additive, backed up).
  python3 "$CREW_HOME/claude/merge_settings.py" | sed 's/^/  /'

  chmod +x "$CREW_HOME"/bin/* "$CREW_HOME"/hooks/*.sh "$CREW_HOME"/hooks/*.py 2>/dev/null
  rm -f "$STATE/disabled"

  # 6. validate + reload
  "$CMUX" config validate >/dev/null 2>&1 && ok "cmux config validates" \
    || bad "cmux config validate failed — run: cmux config doctor"
  "$CMUX" reload-config >/dev/null 2>&1 && ok "reloaded cmux + ghostty config" \
    || warn "reload-config failed (is cmux running?)"

  # The template carries activePaneBorderColor as null, so an apply resets the
  # pane frame. Repaint it now rather than leaving it blank until the next
  # workspace switch.
  if [ -x "$CREW_HOME/bin/crew-frame" ]; then
    python3 "$CREW_HOME/bin/crew-frame" >/dev/null 2>&1 \
      && ok "pane frame follows the selected workspace" \
      || warn "crew-frame did not run"
  fi

  # A running intent server keeps executing whatever code it started with, and
  # nothing else restarts it: crew-listen only spawns one when it is DOWN, so an
  # apply could land new code and change nothing observable. Restarting here is
  # safe because serve() persists BOTH the port (the __INTENT_PORT__ pin) and the
  # token across a restart, precisely so a bounce does not turn every chip on an
  # already-pushed board into a 403.
  #
  # Only when it is actually behind: an apply with no new code should not bounce
  # a healthy server for nothing. Same test `crew doctor` reports.
  if [ -f "$STATE/board-intent.port" ] && [ "$CREW_HOME/board/crew-board-intent" -nt "$STATE/board-intent.port" ]; then
    # One python call does the whole bounce: kill, respawn detached, wait on the
    # socket. Spawned with start_new_session so it outlives this shell -- the
    # same reason crew-board does it that way, and there is no setsid on BSD.
    # It is started here rather than left to crew-listen, which is not running
    # when the daemon is off, in which case nothing would restart it at all.
    if python3 - "$CREW_HOME/board/crew-board-intent" "$STATE/board-intent.port" <<'PY'
import os, signal, socket, subprocess, sys, time

intent, portfile = sys.argv[1], sys.argv[2]

# Match any generation, including one started with a relative path.
subprocess.run(["pkill", "-f", "crew-board-intent"], capture_output=True)
for _ in range(20):                       # let the port come free
    time.sleep(0.05)
    if subprocess.run(["pgrep", "-f", "crew-board-intent"],
                      capture_output=True).returncode != 0:
        break

subprocess.Popen([sys.executable, intent], stdout=subprocess.DEVNULL,
                 stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                 start_new_session=True)

for _ in range(40):                       # ~4s
    time.sleep(0.1)
    try:
        with open(portfile) as fh:
            port = int(fh.read().strip())
        s = socket.create_connection(("127.0.0.1", port), timeout=0.4)
        s.close()
        sys.exit(0)
    except (OSError, ValueError):
        continue
sys.exit(1)
PY
    then
      ok "restarted the intent server on the new code"
    else
      warn "intent server did not come back — it starts again on the next board push"
    fi
  fi

  printf '\nNew Claude sessions pick up the hooks. Open the board with:\n  cmux sidebar open crew\n'
}

# Rewrites only crew's own hook entries. Every other hook — whimsy, gitnexus,
# guard_bash — is preserved exactly as found.
wire_hooks() {
  python3 - "$SETTINGS" "$HOOK" <<'PY'
import json, os, sys

settings_path, hook = sys.argv[1], sys.argv[2]
# A machine where Claude Code has never run has no settings.json, which is
# exactly the case a fresh install is. Opening it blind crashed here, and
# `apply` carried on reporting success -- a green install with no hooks wired.
if os.path.exists(settings_path):
    with open(settings_path) as fh:
        s = json.load(fh)
else:
    s = {}
    os.makedirs(os.path.dirname(settings_path) or ".", exist_ok=True)

hooks = s.setdefault("hooks", {})

def entry(arg, timeout=5, msg=None):
    h = {"type": "command", "command": f'bash "{hook}" {arg}', "timeout": timeout}
    if msg:
        h["statusMessage"] = msg
    return h

# Anything that runs crew-hook.sh, or the v1 bridge crew replaces.
SUPERSEDED = ("crew-hook.sh", "on_stop_notify.sh", "on_session_start.sh",
              "on_notification.sh", "set_status_running.sh", "clear_status.sh",
              "flash_on_edit.sh")

def strip(event):
    for matcher in hooks.get(event, []):
        matcher["hooks"] = [
            h for h in matcher.get("hooks", [])
            if not any(m in (h.get("command") or "") for m in SUPERSEDED)
        ]
    hooks[event] = [m for m in hooks.get(event, []) if m.get("hooks")]

def add(event, matcher, hook_entry):
    strip_target = [m for m in hooks.setdefault(event, [])
                    if m.get("matcher", "") == matcher]
    if strip_target:
        strip_target[0].setdefault("hooks", []).insert(0, hook_entry)
    else:
        hooks[event].insert(0, {"matcher": matcher, "hooks": [hook_entry]})

for ev in ("SessionStart", "SessionEnd", "Stop", "Notification",
           "PreToolUse", "PostToolUse"):
    strip(ev)

add("SessionStart", "", entry("session"))
add("SessionEnd", "", entry("end", 3))
add("Stop", "", entry("stop"))
add("Notification", "", entry("notification"))
add("PreToolUse", "", entry("pretool", 3))
# A question to the human is a block on the human from the moment the tool is
# called; no Notification fires for it. Own matchers so the hot path stays
# payload-free.
add("PreToolUse", "AskUserQuestion", entry("ask", 3))
add("PostToolUse", "AskUserQuestion", entry("answered", 3))
add("PostToolUse", "TaskCreate|TaskUpdate|TodoWrite",
    entry("task", 5, "Publishing plan to cmux..."))

with open(settings_path, "w") as fh:
    json.dump(s, fh, indent=2)
    fh.write("\n")
PY
}

# ------------------------------------------------------------ uninstall -----
cmd_uninstall() {
  head_ "crew uninstall"

  local bak
  bak="$(ls -t "$CMUX_JSON".*.bak 2>/dev/null | head -1)"
  if [ -n "$bak" ]; then
    cp "$bak" "$CMUX_JSON"
    ok "restored cmux.json from $(basename "$bak")"
  else
    warn "no backup found — leaving cmux.json as is"
  fi

  # The crew plugin's own hooks leave with the plugin (`claude plugin uninstall
  # crew`); what is left to remove here is the wiring the old apply wrote.
  if [ "$(legacy_hook_count)" -gt 0 ] 2>/dev/null; then
    strip_legacy_hooks && ok "removed the legacy crew-hook.sh entries from settings.json (whimsy, gitnexus, guard_bash untouched)"
  fi
  plugin_enabled crew && warn "the crew plugin is still enabled: claude plugin uninstall crew (its hooks are no-ops once crew is off)"
  python3 "$CREW_HOME/claude/merge_settings.py" --remove | sed 's/^/  /'

  # Only remove links that actually point back into the package.
  local unlinked=0
  for f in crew crew-color crew-diff crew-code crew-digest crew-feed crew-reclaim crew-resume crew-sandbox crew-spec crew-sync crew-worktree crew-watch crew-listen; do
    if [ -L "$LOCALBIN/$f" ] && [ "$(readlink "$LOCALBIN/$f")" = "$CREW_HOME/bin/$f" ]; then
      rm -f "$LOCALBIN/$f"; unlinked=$((unlinked + 1))
    fi
  done
  [ "$unlinked" -gt 0 ] && ok "unlinked $unlinked commands from $LOCALBIN"

  launchctl unload "$PLIST" 2>/dev/null; rm -f "$PLIST" 2>/dev/null && ok "removed sync timer"
  # Both launchd jobs are opt-in, so neither may survive an uninstall — a
  # KeepAlive listener left behind would keep respawning against a crew that is
  # no longer installed.
  launchctl unload "$PLIST_LISTEN" 2>/dev/null; rm -f "$PLIST_LISTEN" 2>/dev/null && ok "removed event listener"
  # The daemon is a plain detached process now, so uninstall has to stop it.
  if [ -f "$STATE/listen.pid" ]; then
    _p="$(cat "$STATE/listen.pid" 2>/dev/null || true)"
    [ -n "$_p" ] && kill "$_p" 2>/dev/null && ok "stopped the reconciler (pid $_p)"
    rm -f "$STATE/listen.pid"
  fi
  rm -f "$SIDEBAR_DIR/crew.swift" && ok "removed sidebar"
  rm -f "$MONOLITH/.cmux/dock.json" 2>/dev/null && ok "removed Dock config"
  rm -rf "$STATE" && ok "cleared crew state"

  "$CMUX" reload-config >/dev/null 2>&1 && ok "reloaded cmux config"

  printf '\nguard_bash.sh is still wired — crew never owned it.\n'
  printf 'The v1 cmux bridge hooks crew superseded are NOT re-wired. Their\n'
  printf 'scripts are untouched at ~/.claude/hooks/cmux/ if you want them back:\n'
  printf '  on_session_start.sh  on_stop_notify.sh  on_notification.sh\n'
  printf '  set_status_running.sh  clear_status.sh  flash_on_edit.sh\n'
  local sbak
  sbak="$(ls -t "$SETTINGS".pre-crew.*.bak 2>/dev/null | head -1)"
  [ -n "$sbak" ] && printf 'settings.json as it was just before crew: %s\n' "$sbak"
}

# ------------------------------------------------------------- on / off -----
cmd_on()  { mkdir -p "$STATE"; rm -f "$STATE/disabled"; echo "crew on"; }
cmd_off() { mkdir -p "$STATE"; : > "$STATE/disabled"; echo "crew off (hooks stay wired, now no-ops)"; }

# --------------------------------------------------------------- adopt ------
# Claude Code binds hooks at session start, so a session already running when
# `crew apply` ran will never publish anything — no name, no progress, no lane.
# `crew adopt` back-fills that session's workspace once, without a restart.
#
# It cannot make future turns publish. For that the session has to be restarted,
# which `--resume` makes cheap (crew-resume does it in one keystroke).
crew_session_id() {
  python3 - "$HOME/.cmuxterm/claude-hook-sessions.json" "${CMUX_WORKSPACE_ID:-}" <<'PY' 2>/dev/null
import json, sys
try:
    with open(sys.argv[1]) as fh:
        d = json.load(fh)
    print(((d.get("activeSessionsByWorkspace") or {}).get(sys.argv[2]) or {}).get("sessionId") or "")
except Exception:
    pass
PY
}

cmd_adopt() {
  head_ "crew adopt"
  [ -n "${CMUX_WORKSPACE_ID:-}" ] || { bad "not inside a cmux terminal"; return 1; }

  local sid; sid="$(crew_session_id)"
  [ -n "$sid" ] || { bad "no Claude session registered for this workspace"; return 1; }
  ok "session $sid"

  local payload
  payload="$(python3 -c 'import json,os,sys; print(json.dumps({"cwd": os.getcwd(), "session_id": sys.argv[1]}))' "$sid")"

  # Naming + colour, then plan/progress. Deliberately not the notification or
  # lane events: back-filling should not fire a banner or claim the workspace
  # is blocked on you.
   printf '%s' "$payload" | CREW_ADOPT=1 bash "$HOOK" session
  ok "renamed workspace and tab"
  printf '%s' "$payload" | bash "$HOOK" task
  if [ -d "$HOME/.claude/tasks/$sid" ]; then
    ok "published plan ($(ls "$HOME/.claude/tasks/$sid"/[0-9]*.json 2>/dev/null | wc -l | tr -d ' ') tasks)"
  else
    warn "no task list for this session yet — progress stays empty until it has one"
  fi

  mkdir -p "$STATE"
  : > "$STATE/session-$sid.adopted"

  printf '\nBack-filled once. Future turns in this session still will not publish —\n'
  printf 'hooks bind at session start. To get live updates, restart it:\n'
  printf '  crew-resume        (pick this session, ^T to resume in place)\n'
}

# --------------------------------------------------------------- timer ------
# The Stop hook already reconciles every workspace after any turn, so the only
# gap is "everything is idle and something is stuck" — where nothing changes
# anyway until you touch it. This closes that gap for people who would rather
# not think about it. Opt-in, because it is a persistent background job.
PLIST="$HOME/Library/LaunchAgents/com.crew.sync.plist"

cmd_timer() {
  # Retired. `com.crew.sync` could never work: a launchd job holds no
  # CMUX_SOCKET_CAPABILITY, so every cmux call inside crew-sync was refused and
  # swallowed. It was loaded and reconciling nothing -- proven with the `synced:`
  # stamp, which stayed 140s old across a launchd run and moved to 3s when the
  # same binary ran from a cmux terminal.
  #
  # The periodic reconcile now lives in crew-listen's ticker, which the
  # SessionStart hook starts and which therefore inherits the token.
  case "${1:-status}" in
    off)
      launchctl unload "$PLIST" 2>/dev/null
      rm -f "$PLIST" && ok "removed the retired com.crew.sync job"
      ;;
    *)
      printf '  timer is retired — a launchd job cannot reach the cmux socket.\n'
      printf '  the periodic reconcile is crew-listen'"'"'s tick: crew listen status\n'
      if launchctl list 2>/dev/null | grep -c com.crew.sync >/dev/null; then
        warn "com.crew.sync is still loaded and doing nothing — remove it: crew timer off"
      fi
      ;;
  esac
}

# -------------------------------------------------------------- listen ------
# The third trigger. The Stop hook covers "an agent just finished", the timer
# covers "nothing is happening but something drifted", and this covers the gap
# neither can: a worktree opening or closing makes the board wrong *now*, and
# waiting up to five minutes to notice is the one case you watch happen.
#
# It cannot help with CI, review or Jira. There is no git event and no PR event
# in cmux's catalog, and those services are not on this machine — only the poll
# learns them. See crew-listen's own header and FINDINGS.md.
#
# KeepAlive, not StartInterval: this one is a long-lived subscription rather
# than a periodic job.
PLIST_LISTEN="$HOME/Library/LaunchAgents/com.crew.listen.plist"

cmd_listen() {
  # No launchd. A launchd job cannot open the cmux socket -- it holds no
  # CMUX_SOCKET_CAPABILITY -- so `com.crew.listen` respawned every 10s doing
  # nothing, and `com.crew.sync` reconciled nothing at all. The daemon is started
  # by the SessionStart hook instead, which runs inside a cmux terminal and so
  # passes the token on to its detached child. See FINDINGS.md.
  local pidf="$STATE/listen.pid" pid=""
  [ -f "$pidf" ] && pid="$(cat "$pidf" 2>/dev/null || true)"
  local live=""
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && live=1

  case "${1:-status}" in
    on)
      rm -f "$STATE/listen.off"
      if [ -n "$live" ]; then
        ok "listener already running (pid $pid)"
      else
        mkdir -p "$STATE"
        ( nohup "$CREW_HOME/bin/crew-listen" >>"$STATE/listen.log" 2>&1 & ) >/dev/null 2>&1
        sleep 1
        pid="$(cat "$pidf" 2>/dev/null || true)"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
          ok "listener on (pid $pid) — events + a ${CREW_TICK_SECONDS:-120}s reconcile, board every ${CREW_BOARD_TICK:-10}s"
        else
          bad "listener failed to start; see: crew listen log"
        fi
      fi
      ;;
    off)
      : > "$STATE/listen.off"
      if [ -n "$live" ]; then
        kill "$pid" 2>/dev/null && ok "listener off (was pid $pid)"
      else
        ok "listener off"
      fi
      rm -f "$pidf"
      ;;
    log)
      [ -f "$STATE/listen.log" ] && tail -n "${2:-20}" "$STATE/listen.log" \
        || printf '  no listener log yet (%s)\n' "$STATE/listen.log"
      ;;
    *)
      if [ -n "$live" ]; then
        ok "listener running (pid $pid) — events + a ${CREW_TICK_SECONDS:-120}s reconcile, board every ${CREW_BOARD_TICK:-10}s"
      elif [ -f "$STATE/listen.off" ]; then
        printf '  listener off by choice — turn on with: crew listen on\n'
      else
        printf '  listener not running — starts on the next Claude session, or: crew listen on\n'
      fi
      ;;
  esac
}

# -------------------------------------------------------------- status ------
cmd_status() {
  head_ "crew status"
  [ -f "$STATE/disabled" ] && printf '  runtime: \033[33mdisabled\033[0m (crew on)\n' \
                           || printf '  runtime: \033[32menabled\033[0m\n'
  printf '  package: %s\n' "$CREW_HOME"
  printf '  cmux:    %s\n' "$("$CMUX" version 2>/dev/null || echo 'not found')"

  # All three reconcile triggers in one place, because "why is the board stale"
  # is almost always one of them being off. grep -c, not -q — see crew-sandbox.
  local jobs; jobs="$(launchctl list 2>/dev/null || true)"
  printf '  reconcile: Stop hook (<=%ss)' "${CREW_SYNC_INTERVAL:-120}"
  local lpid=""
  [ -f "$STATE/listen.pid" ] && lpid="$(cat "$STATE/listen.pid" 2>/dev/null || true)"
  if [ -n "$lpid" ] && kill -0 "$lpid" 2>/dev/null; then
    printf ' + daemon (events + %ss tick, pid %s)\n' "${CREW_TICK_SECONDS:-120}" "$lpid"
  else
    printf ' + \033[33mno daemon\033[0m (starts on the next Claude session)\n'
  fi
  case "$jobs" in
    *com.crew.sync*|*com.crew.listen*)
      printf '  \033[33m!\033[0m a retired launchd job is still loaded — remove it: crew timer off\n' ;;
  esac
  if [ -f "$STATE/sync-stamp" ]; then
    local last age; last="$(cat "$STATE/sync-stamp" 2>/dev/null || echo 0)"
    age=$(( $(date +%s) - last ))
    printf '  last sync: %ss ago\n' "$age"
  else
    printf '  last sync: \033[33mnever\033[0m\n'
  fi

  head_ "this session"
  if [ -n "${CMUX_WORKSPACE_ID:-}" ]; then
    local sid; sid="$(crew_session_id)"
    if [ -z "$sid" ]; then
      printf '  no Claude session registered for this workspace\n'
    elif [ -f "$STATE/session-$sid" ]; then
      printf '  hooks: \033[32mlive\033[0m (started after crew was applied)\n'
    elif [ -f "$STATE/session-$sid.adopted" ]; then
      printf '  hooks: \033[33mnot live, back-filled once\033[0m — restart for live updates\n'
    else
      printf '  hooks: \033[33mnot live\033[0m — this session predates crew apply.\n'
      printf '         run \033[1mcrew adopt\033[0m to back-fill it now, or restart it\n'
    fi
    [ -n "$sid" ] && printf '  session: %s\n' "$sid"
  else
    printf '  not running inside a cmux terminal\n'
  fi

  head_ "this workspace"
  if [ -n "${CMUX_WORKSPACE_ID:-}" ]; then
    "$CMUX" sidebar-state 2>/dev/null | sed 's/^/  /'
  else
    printf '  not running inside a cmux terminal\n'
  fi
}

# -------------------------------------------------------------- doctor ------
cmd_doctor() {
  FAIL=0
  head_ "binaries"
  [ -x "$CMUX" ] && ok "cmux: $CMUX" || bad "cmux not found"
  command -v python3 >/dev/null && ok "python3" || bad "python3 missing (hooks need it)"
  command -v git >/dev/null && ok "git" || bad "git missing"
  command -v gh >/dev/null && ok "gh (Dock checks, crew-diff pr)" || warn "gh missing — Dock 'Checks' and 'crew-diff pr' will fail"
  command -v docker >/dev/null && ok "docker (Dock db)" || warn "docker missing — Dock 'DB' will fail"
  # Sandboxing is opt-in, so none of this is fatal — warn only. This is `sbx`,
  # the standalone CLI; the `docker sandbox` Desktop plugin is deprecated and
  # goes away at Docker Desktop 4.80.0.
  local sbxbin; sbxbin="${CREW_SBX:-$(command -v sbx || true)}"
  if [ -n "$sbxbin" ] && [ -x "$sbxbin" ]; then
    ok "sbx ($("$sbxbin" version 2>/dev/null | sed -n 's/.*version: *//p' | head -1))"
    # The daemon has its own lifecycle and everything 401s or hangs without it.
    if "$sbxbin" daemon status 2>/dev/null | grep -c running >/dev/null; then
      ok "sandboxd running"
      case "$("$sbxbin" ls 2>&1)" in
        *"not authenticated"*|*"not signed in"*|*"no valid user session"*)
          warn "sbx not signed in — run: sbx login" ;;
        *)
          ok "sbx authenticated"
          local tmpl="${CREW_SBX_TEMPLATE:-crew/monolith-base:latest}"
          "$sbxbin" template ls 2>/dev/null | grep -c "${tmpl%%:*}" >/dev/null \
            && ok "sandbox template $tmpl" \
            || warn "no $tmpl image — every sandbox pays a full bundle install; run: crew-sandbox base" ;;
      esac
    else
      warn "sandboxd not running — run: sbx daemon start -d --policy balanced"
    fi
  else
    warn "sbx missing — crew-worktree --sandbox will fail (brew install --cask docker/tap/sbx)"
  fi
  # Integration checks run only for what the human enabled at setup; a
  # declined integration is one quiet line, never a warn (the old
  # unconditional acli nag was exactly the noise this replaces).
  if [ -n "$(integ jira)" ]; then
    if command -v acli >/dev/null; then
      acli jira auth status >/dev/null 2>&1 && ok "acli authenticated (Jira status)" \
        || warn "acli present but not authenticated — Jira badges will be blank"
    else
      warn "acli missing — Jira is enabled but has no status source"
    fi
    [ -n "$(integ jira site)" ] && ok "Jira site: $(integ jira site) (ticket chips link)$(integ_from_options && echo ", from the crew plugin's options")" \
      || note "no Jira site recorded — ticket chips stay unlinked (set jira_site: /plugin configure crew@seamux)"
  else
    note "Jira integration off — turn it on with the crew plugin's jira_site option (/plugin configure crew@seamux)"
  fi
  if [ -n "$(integ github_issues)" ]; then
    command -v gh >/dev/null && ok "GitHub issue chips (via gh)" \
      || warn "GitHub Issues enabled but gh is missing"
  else
    note "GitHub Issues integration off — turn it on with the crew plugin's github_issues option (/plugin configure crew@seamux)"
  fi
  # Optional and keyed, not chosen at setup: a key on this machine turns it on.
  if python3 "$CREW_HOME/hooks/asked.py" available 2>/dev/null; then
    # Both knobs live in integrations.json typesafe; the client owns the
    # defaults, so read them through it rather than restating 0.7/0.8 here.
    local _ts_t
    _ts_t="$(python3 -c "import sys; sys.path.insert(0, '$CREW_HOME/hooks'); \
import typesafe; print('asked>=%.2f stuck>=%.2f' % (typesafe.threshold(), \
typesafe.threshold('stuck_threshold', 0.8)))" 2>/dev/null)"
    ok "TypeSafe: turn-end ask + board ranking (${_ts_t:-thresholds unreadable})"
  else
    note "TypeSafe off — set TYPESAFE_API_KEY or ~/.config/typesafe/api-key to catch questions at turn end"
  fi
  local codebin="${CREW_CODE_BIN:-/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code}"
  [ -x "$codebin" ] || codebin="$(command -v code || true)"
  if [ -n "$codebin" ] && [ -x "$codebin" ]; then
    ok "VS Code CLI ($("$codebin" --version 2>/dev/null | head -1))"
    # Every worktree is a path VS Code has never seen, so an untrusted ~/code
    # means a trust modal on every single one — and declining leaves the window
    # in Restricted Mode with the extensions disabled, which is exactly what
    # moving off serve-web was meant to fix. Trusting the parent once covers
    # every worktree ever created under it.
    local _tdb="$HOME/Library/Application Support/Code/User/globalStorage/state.vscdb"
    if command -v sqlite3 >/dev/null && [ -f "$_tdb" ]; then
      if sqlite3 "$_tdb" \
           "select cast(value as text) from ItemTable where key like '%trust%';" 2>/dev/null \
           | grep -c "file://$HOME/code" >/dev/null; then
        ok "~/code trusted in VS Code (new worktrees open trusted)"
      else
        warn "~/code is not a trusted folder — every new worktree will prompt; trust the parent folder once (README: Editor)"
      fi
    fi
  else
    warn "VS Code CLI not found — crew-code and Cmd-click-to-editor will not work"
  fi

  head_ "package"
  # Every shipped file, not a subset. The list had drifted behind the package:
  # costs.py, crew-overlay, dock.global.json, crew-frame, intent.js and the
  # usage template were all absent from it, and every one of them fails QUIETLY
  # when missing -- costs.py behind a bare `except` that simply drops the cost
  # facts, crew-overlay only for machines that have an overlay, crew-frame
  # behind an `[ -x ]` that skips it without a word.
  for f in hooks/lib.sh hooks/crew-hook.sh hooks/progress.sh hooks/triage.py \
           hooks/asked.py hooks/asked.sh hooks/typesafe.py hooks/typesafe_probe.py \
           bin/crew-watch bin/crew-spec bin/crew-worktree bin/crew-diff bin/crew-code \
           bin/crew-code-open bin/crew-color bin/crew-digest bin/crew-feed bin/crew-listen bin/crew-reclaim bin/crew-resume bin/crew-sandbox bin/crew-sync sidebars/crew.swift config/cmux.jsonc config/dock.json \
           bin/crew-frame bin/crew-overlay config/dock.global.json \
           board/crew-board board/board.html board/render.js board/board_probe.mjs bin/crew-cmux-bin \
           board/crew-board-intent board/crew-board-diag board/costs.py board/judgments.py board/intent.js board/cat_from_swift.py board/usage.tmpl.html \
           board/dp_engine.py hooks/hooks.json .claude-plugin/plugin.json bin/crew-plugin-root \
           tools/render_probe.py; do
    [ -f "$CREW_HOME/$f" ] && ok "$f" || bad "missing $f"
  done
  # crew-frame is here because `crew apply` gates it on [ -x ] and skips it in
  # silence; the pane frame then just never follows the workspace.
  for f in hooks/crew-hook.sh hooks/triage.py bin/crew-watch bin/crew-spec \
           bin/crew-worktree bin/crew-diff bin/crew-code bin/crew-code-open bin/crew-color bin/crew-listen bin/crew-reclaim bin/crew-resume bin/crew-sandbox \
           bin/crew-frame bin/crew-cmux-bin board/crew-board; do
    [ -x "$CREW_HOME/$f" ] || bad "$f is not executable"
  done
  for f in crew-diff crew-code crew-code-open crew-sandbox crew-worktree crew-cmux-bin; do
    bash -n "$CREW_HOME/bin/$f" 2>/dev/null && ok "$f parses" || bad "$f syntax error"
  done
  for f in crew-resume crew-sync crew-digest crew-feed crew-listen crew-color; do
    python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" "$CREW_HOME/bin/$f" \
      2>/dev/null && ok "$f parses" || bad "$f syntax error"
  done
  python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" "$CREW_HOME/board/crew-board" \
    2>/dev/null && ok "crew-board parses" || bad "crew-board syntax error"
  # The board's renderer is pushed with each update, not resident in the page -- so the
  # entry point lives in render.js and board.html must stay inert. Both directions are
  # checked: a page that regains a <script> has regained a dependency that already broke.
  grep -q "__boardRender" "$CREW_HOME/board/render.js" \
    2>/dev/null && ok "render.js defines __boardRender" || bad "render.js has no entry point"
  grep -q "<script" "$CREW_HOME/board/board.html" \
    2>/dev/null && bad "board.html has a <script> — the renderer is pushed, not resident" \
    || ok "board.html is inert"
  # Inert is not the same as correct. A page with no script can still be the WRONG page:
  # one was installed with #list where render.js writes into #rows, and it passed the check
  # above while the board threw "null is not an object" on every push. So the targets are
  # extracted from render.js itself -- hardcoding them here would drift the moment the
  # renderer grows a field.
  local _want _miss=""
  _want="$(grep -oE '\$\("[a-z]+"\)' "$CREW_HOME/board/render.js" 2>/dev/null \
           | grep -oE '"[a-z]+"' | tr -d '"' | sort -u)"
  if [ -z "$_want" ]; then
    warn "could not read render targets out of render.js"
  else
    for _id in $_want; do
      grep -q "id=\"$_id\"" "$CREW_HOME/board/board.html" 2>/dev/null || _miss="$_miss $_id"
    done
    if [ -n "$_miss" ]; then
      bad "board.html is missing render targets:$_miss — the board will throw on push"
    else
      ok "board.html satisfies render.js ($(printf '%s' "$_want" | wc -w | tr -d ' ') targets)"
    fi
  fi
  # Not a command — a dev tool. It renders sidebars/crew.swift through cmux's own
  # interpreter worker so a render bug can be caught before it reaches the board,
  # which `cmux sidebar validate` cannot do. See TESTING.md.
  python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" \
    "$CREW_HOME/tools/render_probe.py" 2>/dev/null \
    && ok "render_probe.py parses" || bad "render_probe.py syntax error"
  # preferredEditor is only consulted when cmux is not previewing the file
  # itself, so these two settings have to agree or Cmd-click never reaches
  # VS Code.
  if grep -q "crew-code-open" "$CMUX_JSON" 2>/dev/null; then
    ok "Cmd-click wired to VS Code (app.preferredEditor)"
    grep -q '"openSupportedFilesInCmux" *: *false' "$CMUX_JSON" 2>/dev/null \
      && ok "openSupportedFilesInCmux false — Cmd-click reaches preferredEditor" \
      || warn "openSupportedFilesInCmux is true — cmux previews win, VS Code only sees unsupported files"
  fi
  bash -n "$CREW_HOME/hooks/lib.sh" 2>/dev/null && ok "lib.sh parses" || bad "lib.sh syntax error"
  bash -n "$CREW_HOME/hooks/crew-hook.sh" 2>/dev/null && ok "crew-hook.sh parses" || bad "crew-hook.sh syntax error"
  python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" "$CREW_HOME/hooks/triage.py" \
    2>/dev/null && ok "triage.py parses" || bad "triage.py syntax error"

  head_ "reconciler"
  local dpid=""
  [ -f "$STATE/listen.pid" ] && dpid="$(cat "$STATE/listen.pid" 2>/dev/null || true)"
  if [ -n "$dpid" ] && kill -0 "$dpid" 2>/dev/null; then
    ok "daemon running (pid $dpid) — events + ${CREW_TICK_SECONDS:-120}s tick"
  elif [ -f "$STATE/listen.off" ]; then
    warn "daemon off by choice — only the Stop hook reconciles; crew listen on"
  else
    warn "daemon not running — starts on the next Claude session, or: crew listen on"
  fi
  if [ -f "$STATE/sync-stamp" ]; then
    local sage; sage=$(( $(date +%s) - $(cat "$STATE/sync-stamp" 2>/dev/null || echo 0) ))
    if [ "$sage" -lt 900 ]; then ok "last reconcile ${sage}s ago"
    else bad "last reconcile ${sage}s ago — the board is stale"; fi
  else
    warn "never reconciled (no sync-stamp)"
  fi
  case "$(launchctl list 2>/dev/null | grep -c 'com.crew' || true)" in
    0) ok "no retired launchd jobs loaded" ;;
    *) bad "a retired launchd job is loaded and cannot reach the socket — crew timer off" ;;
  esac

  head_ "installed"
  # The crew plugin wires the hooks from its hooks.json; settings.json should
  # carry none of crew's. The old install wired them there instead.
  local _legacy; _legacy="$(legacy_hook_count)"
  if plugin_enabled crew; then
    ok "crew plugin enabled (its hooks.json wires the Claude hooks)"
    [ "$_legacy" -gt 0 ] 2>/dev/null \
      && bad "settings.json still carries $_legacy crew-hook.sh entries — every hook fires twice; run: crew apply"
  elif [ "$_legacy" -gt 0 ] 2>/dev/null; then
    warn "Claude hooks wired in settings.json (legacy) — claude plugin install crew@seamux, then crew apply"
  else
    bad "Claude hooks not wired — claude plugin install crew@seamux"
  fi
  # The board's go chip and a human shell find deep-plan through its pointer.
  if [ -f "$HOME/.claude/deep-plan/engine.json" ]; then
    ok "deep-plan engine pointer: $(sed -n 's/^  "root": "\(.*\)",\{0,1\}$/\1/p' "$HOME/.claude/deep-plan/engine.json" | sed "s|^$HOME|~|")"
  elif [ -f "$HOME/.claude/skills/deep-plan/deep_plan.mjs" ]; then
    warn "deep-plan runs from the old ~/.claude/skills copy — claude plugin install deep-plan@seamux"
  else
    bad "no deep-plan engine — the go chip has nothing to run; install the deep-plan plugin and start a session"
  fi
  # The guard is wired one of two ways: the bash-guard plugin enabled, or the
  # settings.json entry the old installer wrote (kept until migration removes it).
  if python3 -c 'import json,sys
d=json.load(open(sys.argv[1]))
sys.exit(0 if any(k.startswith("bash-guard@") and v for k,v in (d.get("enabledPlugins") or {}).items()) else 1)' "$SETTINGS" 2>/dev/null; then
    ok "bash-guard plugin enabled"
  elif grep -q "guard_bash.sh" "$SETTINGS" 2>/dev/null; then
    ok "guard_bash.sh wired in settings.json (legacy; the bash-guard plugin replaces it)"
  else
    bad "the destructive-command guard is off — claude plugin install bash-guard@seamux"
  fi
  [ -f "$SIDEBAR_DIR/crew.swift" ] && ok "sidebar installed" || bad "sidebar not installed"
  if python3 "$CREW_HOME/board/crew-board-intent" --selftest >/dev/null 2>&1; then
    ok "intent server routes + mermaid swap"
  else
    bad "intent selftest failed — python3 board/crew-board-intent --selftest"
  fi
  # A running server keeps executing whatever code it started with. install.sh
  # and `crew apply` both report success without touching it, and crew-listen
  # only respawns it when it is DOWN, never when it is merely behind -- so an
  # upgrade can land, say so, and change nothing you can see. It has already
  # happened once: a server old enough to still emit the dollars-era /usage
  # shape was serving the current template, which rendered "no budget on record"
  # over perfectly good data.
  #
  # The port file is written once, in serve(), so its mtime is the server's
  # start time without parsing `ps`. Newer code than that means stale.
  if [ ! -f "$STATE/board-intent.port" ]; then
    note "no intent server has started yet — the next board push starts one"
  elif [ "$CREW_HOME/board/crew-board-intent" -nt "$STATE/board-intent.port" ]; then
    bad "intent server is running older code than is installed — restart it:"
    bad "  pkill -f crew-board-intent   (crew-listen respawns it within ~10s)"
  else
    ok "intent server is running the installed code"
  fi
  grep -q "crew-triage" "$CMUX_JSON" 2>/dev/null && ok "notification triage in cmux.json" \
    || bad "cmux.json is not crew-rendered — run: crew apply"
  ls "$CMUX_JSON".*.bak >/dev/null 2>&1 && ok "a cmux.json backup exists (crew uninstall can revert)" \
    || warn "no cmux.json backup — crew uninstall cannot restore"

  head_ "cmux"
  "$CMUX" config validate >/dev/null 2>&1 && ok "config validates" || bad "cmux config doctor reports a problem"
  if "$CMUX" ping >/dev/null 2>&1; then
    ok "socket reachable"
    "$CMUX" sidebar validate crew >/dev/null 2>&1 && ok "sidebar validates" || bad "sidebar has errors: cmux sidebar validate crew"
  else
    warn "cmux socket unreachable (app not running?) — skipped live checks"
  fi

  head_ "source of truth"
  # The plugin root (or, for the old install, the repo) is the source of truth:
  # apply writes .seamux-source, and drift between it and the live tree is a
  # red, not a habit. A missing marker means the install predates the marker.
  local _src="" _plug
  [ -f "$CREW_HOME/.seamux-source" ] && _src="$(cat "$CREW_HOME/.seamux-source" 2>/dev/null)"
  _plug="$(plugin_source)"
  if [ -n "$_plug" ]; then
    if [ "$_plug" != "$_src" ]; then
      bad "the crew plugin moved to ${_plug/#$HOME/~} ($(plugin_version "$_plug")) since the last apply — run: crew apply"
    else
      local _drift; _drift="$(crew_drift "$_plug")"
      if [ -z "$_drift" ]; then
        ok "no drift vs the crew plugin at ${_plug/#$HOME/~}"
      else
        bad "live tree differs from the crew plugin at ${_plug/#$HOME/~} — run: crew apply"
        printf '%s\n' "$_drift" | head -8 | sed 's/^/      /'
      fi
    fi
  elif [ -z "$_src" ]; then
    warn "no .seamux-source marker — reinstall from the seamux repo to enable the drift check"
  elif [ ! -x "$_src/install.sh" ]; then
    bad "seamux repo missing or has no install.sh: $_src"
  elif "$_src/install.sh" --check >/dev/null 2>&1; then
    ok "no drift vs $_src"
  else
    bad "live install has drifted from $_src — see: $_src/install.sh --check"
  fi
  # The machine-local overlay: not drift, and not a symptom. A machine without
  # one is the normal case, so it gets a `note`, the same level a declined
  # integration gets. The one hard failure is an override that is present but
  # not executable, because `[ -x ]` makes that a silent no-op -- the same bug
  # class as the go chip that sent workspace_id to a reader expecting
  # workspaceId, and silence is what made that one survive so long.
  if [ -d "$CREW_LOCAL" ]; then
    local _n
    _n="$(find "$CREW_LOCAL" -maxdepth 1 -type f ! -name '.*' 2>/dev/null | wc -l | tr -d ' ')"
    ok "machine-local overlay: ${CREW_LOCAL/#$HOME/~} ($_n file(s), never synced)"
    if [ -f "$CREW_LOCAL/crew-spec" ] && [ ! -x "$CREW_LOCAL/crew-spec" ]; then
      bad "crew-local/crew-spec is not executable — the override is being silently ignored (chmod +x it)"
    fi
    # Billing mode decides what the status line and /usage lead with, and
    # getting it wrong is silent -- the page just answers a question this
    # account does not have. Say which one is in force and where it came from.
    if [ -f "$CREW_LOCAL/config.json" ]; then
      local _bill
      _bill="$(python3 -c 'import json,sys;print((json.load(open(sys.argv[1])).get("billing") or "subscription"))' "$CREW_LOCAL/config.json" 2>/dev/null)"
      if [ "$_bill" = "usage" ]; then
        local _budget
        _budget="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("monthBudget") or "")' "$CREW_LOCAL/config.json" 2>/dev/null)"
        ok "billing: usage-based${_budget:+ — budget \$$_budget/month} (crew-local/config.json)"
      else
        ok "billing: subscription — the 5h window is the constraint"
      fi
    else
      note "billing: subscription (default) — set crew-local/config.json for usage-based"
    fi
    local _f
    for _f in cmux.json dock.json dock.global.json config.json; do
      if [ -f "$CREW_LOCAL/$_f" ] && ! python3 -c "import json,sys;json.load(open(sys.argv[1]))" "$CREW_LOCAL/$_f" 2>/dev/null; then
        bad "crew-local/$_f is not valid JSON — crew apply will refuse to render"
      fi
    done
  else
    note "no machine-local overlay — the package's own defaults are in use"
  fi
  # Computer Use is optional (crew works without it) — report, never fail.
  local _cua="$HOME/Library/Application Support/cmux/cmux-cua"
  if [ -d "$_cua" ] && find "$_cua" -name "cmux-cua" -type f 2>/dev/null | grep -c . >/dev/null; then
    ok "Computer Use helper installed (agents can drive the browser/UI)"
  else
    warn "Computer Use not set up — optional; finish the onboarding in cmux (README: Computer Use)"
  fi

  head_ "context"
  [ -n "${CMUX_WORKSPACE_ID:-}" ] && ok "CMUX_WORKSPACE_ID set (hooks will fire)" \
    || warn "no CMUX_WORKSPACE_ID — hooks no-op outside cmux terminals"

  printf '\n'
  [ "${FAIL:-0}" -eq 0 ] && { printf '\033[32mall good\033[0m\n'; return 0; }
  printf '\033[31mproblems found\033[0m\n'; return 1
}

# ---------------------------------------------------------------- demo ------
# Fires each hook with a synthetic payload against the *current* workspace and
# shows the resulting sidebar state, so you can see what crew actually changes
# without waiting for a real turn.
cmd_demo() {
  [ -n "${CMUX_WORKSPACE_ID:-}" ] || { echo "crew demo must run inside a cmux terminal" >&2; exit 1; }
  local sid="${1:-}"
  local payload
  payload="$(python3 -c 'import json,os,sys; print(json.dumps({"cwd": os.getcwd(), "session_id": sys.argv[1], "message": "crew demo: Claude would be asking you something here"}))' "$sid")"

  for ev in session task notification stop pretool; do
    head_ "$ev"
    printf '%s' "$payload" | bash "$HOOK" "$ev"
    "$CMUX" sidebar-state 2>/dev/null \
      | grep -E '^(status_count|progress|color|tab)|^  ' | sed 's/^/  /'
    "$CMUX" workspace status 2>/dev/null | sed 's/^/  lane: /'
    sleep 1
  done
  printf '\nTodo list now:\n'; "$CMUX" todo list 2>/dev/null | sed 's/^/  /'
  printf '\nRestore with: cmux workspace status set auto && cmux clear-progress && cmux todo clear\n'
}

# Run from the plugin root (inside Claude, the plugin's bin/ is first on the
# Bash tool's PATH), every verb but `apply` belongs to the live tree: doctor
# inspects it, timer and listen register its paths with launchd, and a plugin
# root's path changes on every update.
if [ "$CREW_HOME" != "$LIVE" ] && [ "${1:-status}" != "apply" ]; then
  if [ -x "$LIVE/bin/crew" ]; then exec "$LIVE/bin/crew" "$@"; fi
  printf 'crew is not applied yet: run `crew apply` to install the live tree at %s\n' "${LIVE/#$HOME/~}" >&2
  exit 1
fi

case "${1:-status}" in
  apply)     shift; cmd_apply "$@" ;;
  uninstall) cmd_uninstall ;;
  on)        cmd_on ;;
  off)       cmd_off ;;
  status)    cmd_status ;;
  doctor)    cmd_doctor ;;
  adopt)     cmd_adopt ;;
  sync)      shift; exec "$CREW_HOME/bin/crew-sync" "$@" ;;
  timer)     shift; cmd_timer "${1:-status}" ;;
  listen)    shift; cmd_listen "${1:-status}" "${2:-}" ;;
  color)     shift; exec "$CREW_HOME/bin/crew-color" "$@" ;;
  demo)      shift; cmd_demo "${1:-}" ;;
  *) sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ; exit 2 ;;
esac
