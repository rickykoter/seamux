#!/usr/bin/env bash
# crew-worktree [--repo <name|path>] [--sandbox [--claude=link|isolated]]
#               [--dry-run] [branch] [base]
#   new worktree for any repo under ~/code, ready to commit, opened as a cmux
#   workspace with Claude already running.
#
# Which repo, in order:
#   --repo <name|path>   explicit; a bare name resolves under $CREW_CODE_ROOT
#   the current directory if it is a primary checkout
#   otherwise a picker of every repo under $CREW_CODE_ROOT
#
# The cwd rule is what makes the per-repo context menus work: cmux opens the
# action in a tab inheriting the workspace's directory, so right-clicking a repo
# and asking for a worktree gets you one for THAT repo without a prompt. A
# worktree is never offered as a base for another worktree -- its .git is a file,
# not a directory, which is exactly how they are told apart here.
#
# Worktrees land in <repo>.worktrees, the convention already in use.
#
# With --sandbox and no --claude=, the wizard asks whether to carry your Claude
# setup into the sandbox or start clean. See crew-sandbox for what each does.
#
# A fresh `git worktree add` cannot commit in this repo: core.hooksPath is
# .husky, and two things husky needs are untracked, so they exist only in the
# primary checkout.
#
#   .husky/_/husky.sh   generated by `npm install`; without it every hook
#                       fails on a missing source file
#   node_modules/       the hooks shell out to lint-staged/rubocop wrappers
#
# The usual workaround is `git commit --no-verify`, which the bash guard in
# ~/.claude/hooks/cmux/guard_bash.sh blocks on purpose. So fix the worktree
# instead.

set -euo pipefail

CODE="${CREW_CODE_ROOT:-$HOME/code}"
MONOLITH="${CREW_MONOLITH:-__MAIN_REPO__}"
PREFIX="${CREW_BRANCH_PREFIX:-dev/}"

die() { printf '\033[31m✗\033[0m %s\n' "$*" >&2; exit 1; }
say() { printf '\033[2m→\033[0m %s\n' "$*"; }

# A primary checkout has .git as a DIRECTORY. A worktree has it as a file
# pointing back at the primary, which is how worktrees are kept out of the
# picker and refused as a base.
is_repo() { [ -d "$1/.git" ]; }

repos() {
  local d
  for d in "$CODE"/*/; do
    d="${d%/}"
    is_repo "$d" && printf '%s\n' "$d"
  done
}

pick_repo() {
  local list=() d i=1 pick
  # The monolith first when it is there: it is the one you want most days, and
  # a default you can take with Enter is worth more than alphabetical purity.
  is_repo "$MONOLITH" && list+=("$MONOLITH")
  while IFS= read -r d; do
    [ "$d" = "$MONOLITH" ] || list+=("$d")
  done < <(repos)
  [ ${#list[@]} -gt 0 ] || die "no git checkouts under $CODE"

  printf '\033[1mWhich repo?\033[0m\n' >&2
  for d in "${list[@]}"; do
    printf '  \033[1m%d\033[0m %-30s \033[2m%s\033[0m\n' \
      "$i" "$(basename "$d")" "$([ -d "$d.worktrees" ] && echo "has worktrees" || echo "")" >&2
    i=$((i + 1))
  done
  printf 'Choice [1]: ' >&2
  read -r pick
  [ -n "$pick" ] || pick=1
  case "$pick" in
    ''|*[!0-9]*) die "not a number: $pick" ;;
  esac
  [ "$pick" -ge 1 ] && [ "$pick" -le ${#list[@]} ] || die "no such choice: $pick"
  printf '%s\n' "${list[$((pick - 1))]}"
}

resolve_repo() {
  local want="$1"
  if [ -n "$want" ]; then
    case "$want" in
      */*|~*) printf '%s\n' "${want/#\~/$HOME}" ;;
      *)      printf '%s\n' "$CODE/$want" ;;
    esac
    return
  fi
  # Standing in a checkout is an answer. Standing in a WORKTREE is not -- that
  # would nest worktrees of worktrees, so fall through to the picker.
  local top
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$top" ] && is_repo "$top"; then
    printf '%s\n' "$top"
    return
  fi
  [ -t 0 ] || die "no repo given and stdin is not a terminal (use --repo <name>)"
  pick_repo
}

# origin/HEAD names the default branch; not every repo has it set, and not every
# repo is master (the-app is main). Asking git beats guessing.
default_base() {
  local head
  head="$(git -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -n "$head" ]; then printf '%s\n' "$head"; return; fi
  for b in origin/main origin/master; do
    git -C "$1" show-ref --verify --quiet "refs/remotes/$b" && { printf '%s\n' "$b"; return; }
  done
  printf 'origin/master\n'
}

# --sandbox runs the agent and its service stack in a Docker Sandboxes microVM
# instead of on the host. Opt-in: without it this script behaves exactly as it
# always has. See crew-sandbox for the mount model.
sandbox=""
claude_mode=""
want_repo=""
dry=""
while :; do
  case "${1:-}" in
    --sandbox)  sandbox=1; shift ;;
    --claude=*) claude_mode="${1#--claude=}"; shift ;;
    --repo)     want_repo="${2:-}"; shift 2 ;;
    --repo=*)   want_repo="${1#--repo=}"; shift ;;
    --dry-run)  dry=1; shift ;;
    *) break ;;
  esac
done
case "$claude_mode" in
  ""|link|isolated) ;;
  *) die "--claude must be 'link' or 'isolated' (got '$claude_mode')" ;;
esac

MAIN="$(resolve_repo "$want_repo")"
is_repo "$MAIN" || die "not a git checkout: $MAIN"
NAME="$(basename "$MAIN")"

# CREW_WORKTREES stays honoured for the monolith so an existing setup keeps
# working; every other repo derives its own sibling, which is the convention
# already on disk (infrastructure.worktrees was made by hand).
if [ "$MAIN" = "$MONOLITH" ] && [ -n "${CREW_WORKTREES:-}" ]; then
  TREES="$CREW_WORKTREES"
else
  TREES="$MAIN.worktrees"
fi

branch="${1:-}"
base="${2:-$(default_base "$MAIN")}"

if [ -z "$branch" ]; then
  printf '\033[1mNew %s worktree\033[0m \033[2m(off %s)\033[0m\n' "$NAME" "$base"
  printf 'Branch name (without %s): ' "$PREFIX"
  read -r branch
  [ -n "$branch" ] || die "no branch given"
fi

# Only ask when it is a real choice: sandboxed, interactive, and not already
# decided on the command line. Answering is one keystroke and the default is the
# one you almost always want.
if [ -n "$sandbox" ] && [ -z "$claude_mode" ] && [ -t 0 ]; then
  printf '\n\033[1mClaude setup inside the sandbox\033[0m\n'
  printf '  \033[1m1\033[0m linked    your CLAUDE.md, skills, commands and plugins (read-only),\n'
  printf '              plus your login carried in  \033[2m[default]\033[0m\n'
  printf '  \033[1m2\033[0m isolated  a clean Claude that knows nothing about you; /login inside\n'
  printf 'Choice [1]: '
  read -r _pick
  case "$_pick" in
    2|isolated) claude_mode="isolated" ;;
    *)          claude_mode="link" ;;
  esac
fi

# Accept "dev/foo", "foo", or a bare ticket. Store fully qualified.
case "$branch" in
  */*) full="$branch" ;;
  *)   full="$PREFIX$branch" ;;
esac

# Directory name is the branch without the owner prefix — that is the existing
# convention in this worktrees dir.
dir="${full#*/}"
path="$TREES/$dir"

[ -e "$path" ] && die "$path already exists"

if [ -n "$dry" ]; then
  printf '\033[2mdry run\033[0m\n'
  printf '  repo    %s\n  trees   %s\n  branch  %s\n  base    %s\n  path    %s\n' \
    "$MAIN" "$TREES" "$full" "$base" "$path"
  exit 0
fi

say "fetching $base"
git -C "$MAIN" fetch --quiet origin || die "fetch failed"

say "git worktree add $path ($full off $base)"
if git -C "$MAIN" show-ref --verify --quiet "refs/heads/$full"; then
  git -C "$MAIN" worktree add "$path" "$full"
else
  git -C "$MAIN" worktree add -b "$full" "$path" "$base"
fi

# --- make the worktree able to commit ---------------------------------------
if [ -d "$MAIN/.husky/_" ]; then
  say "copying .husky/_ (untracked; husky hooks source it)"
  mkdir -p "$path/.husky"
  cp -R "$MAIN/.husky/_" "$path/.husky/_"
elif [ -d "$MAIN/.husky" ]; then
  # Husky is set up but its generated dir is missing: that IS the failure this
  # fixup exists for. A repo with no .husky at all is not broken, it just does
  # not use husky, and warning about it every time trains you to ignore warnings.
  printf '\033[33m!\033[0m %s\n' "no $MAIN/.husky/_ — run npm install in the primary checkout"
fi

if [ ! -e "$path/node_modules" ] && [ -d "$MAIN/node_modules" ]; then
  say "symlinking node_modules -> primary checkout"
  ln -s "$MAIN/node_modules" "$path/node_modules"
fi

# --- open it -----------------------------------------------------------------
# CREW_CMUX first, the same override every other crew script honours. It is also
# what makes this script testable end to end: point it at a no-op and the whole
# path runs without opening a workspace.
CMUX="${CREW_CMUX:-$(command -v cmux || true)}"
# One definition of "which cmux": bin/crew-cmux-bin. A hardcoded bundle path kept
# driving the OLD cli against the NEW app after the switch to the nightly build --
# version skew that fails silently, because the old bundle is still on disk.
[ -n "$CMUX" ] || CMUX="$("$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/crew-cmux-bin" 2>/dev/null || true)"
[ -n "$CMUX" ] || CMUX=cmux

# The workspace command differs between host and sandbox, but --cwd does not:
# it stays the *host* path either way, so cmux's watchGitStatus, PR bindings and
# the byCwd group glob keep working and the workspace keeps its worktree identity.
#
# Remote Control (CREW_REMOTE, default on): the session attaches to claude.ai so
# the phone / another machine can steer it -- send prompts, approve permissions,
# stop tasks. The session is NAMED "<repo>/<branch>" so the claude.ai session
# list reads like the crew board. Needs a claude.ai subscription login; if this
# machine is logged out, claude says so in the pane and CREW_REMOTE=0 opts out.
command="claude"
if [ "${CREW_REMOTE:-1}" = 1 ]; then
  rc_name="$(basename "$MAIN")/$full"
  command="claude --remote-control \"$rc_name\""
fi
if [ -n "$sandbox" ]; then
  SANDBOX_BIN="$(dirname "$0")/crew-sandbox"
  [ -x "$SANDBOX_BIN" ] || die "crew-sandbox not found next to crew-worktree"
  say "creating sandbox${claude_mode:+ (claude: $claude_mode)}"
  "$SANDBOX_BIN" ${claude_mode:+--claude="$claude_mode"} up "$path" || die "sandbox create failed"
  # Remote Control is a host-login feature; the sandbox agent runs against a
  # read-only ~/.claude and its own network namespace, so the flag is not
  # forwarded. Say so instead of silently diverging from the host behaviour.
  [ "${CREW_REMOTE:-1}" = 1 ] && say "note: remote control not yet supported in sandboxed workspaces"
  command="$SANDBOX_BIN attach $path"
fi

if [ -x "$CMUX" ]; then
  say "opening cmux workspace"
  "$CMUX" new-workspace --cwd "$path" --command "$command" --focus true
  printf '\033[32m✓\033[0m %s\n' "$full ready at $path${sandbox:+ (sandboxed)}"
else
  printf '\033[32m✓\033[0m %s\n' "$full ready at $path (cmux not found; open it yourself)"
fi
