#!/usr/bin/env python3
"""crew-artifacts — the Artifact Log from a shell.

    crew-artifacts index                       rescan changed transcripts (the Stop hook runs this)
    crew-artifacts backfill                    index every transcript from the start
    crew-artifacts search <q> [--ws <cwd>] [--kind <k>] [--json]
    crew-artifacts keep <id>                   copy an at-risk temp file into ~/.claude/crew/kept/

The store and its rules live in board/artifacts.py; this is a thin wrapper.
The crew Stop hook spawns `index` detached, so a turn never waits on it, and
an index run that finds another holding the lock exits at once: that run is
already reading the same transcripts.
"""
import calendar
import json
import os
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "board"))
import artifacts  # noqa: E402

USAGE = __doc__.split("\n\n")[1]


def take(args, flag):
    if flag in args:
        i = args.index(flag)
        if i + 1 < len(args):
            v = args[i + 1]
            del args[i:i + 2]
            return v
        del args[i]
    return None


def local(iso):
    """The store's UTC ISO time as this machine's local YYYY-MM-DD HH:MM."""
    try:
        t = calendar.timegm(time.strptime(iso[:19], "%Y-%m-%dT%H:%M:%S"))
        return time.strftime("%Y-%m-%d %H:%M", time.localtime(t))
    except ValueError:
        return iso[:16].replace("T", " ")


def line(r):
    when = local(r.get("created_at") or "")
    where = r.get("url") or r.get("path") or r.get("sha") or ""
    out = "%-5d %s  %-8s %s" % (r["id"], when, r["kind"], r.get("title") or "")
    if where and where != r.get("title"):
        out += "\n      " + where
    if r.get("prompt"):
        out += "\n      > " + r["prompt"][:160]
    return out


def main(argv):
    args = argv[1:]
    cmd = args.pop(0) if args else ""
    if cmd == "index":
        try:
            n = artifacts.index()
        except artifacts.Busy:
            print("another index run holds the lock; nothing to do")
            return 0
        print("indexed %d rows" % n)
        return 0
    if cmd == "backfill":
        t = time.time()
        n = artifacts.backfill()
        print("indexed %d rows in %.1fs" % (n, time.time() - t))
        return 0
    if cmd == "search":
        as_json = "--json" in args
        if as_json:
            args.remove("--json")
        ws = take(args, "--ws")
        kind = take(args, "--kind")
        if ws:
            ws = os.path.realpath(os.path.expanduser(ws))
        rows = artifacts.search(" ".join(args), ws=ws, kind=kind)
        if as_json:
            json.dump(rows, sys.stdout, indent=1)
            print()
        else:
            for r in rows:
                print(line(r))
            if not rows:
                print("no rows")
        return 0
    if cmd == "keep":
        if not args or not args[0].isdigit():
            sys.stderr.write("usage: crew-artifacts keep <id>\n")
            return 2
        keep = getattr(artifacts, "keep", None)
        if keep is None:
            sys.stderr.write("keep is not available in this install\n")
            return 1
        res = keep(int(args[0]))
        if res.get("ok"):
            print("kept -> %s" % res["path"])
            return 0
        sys.stderr.write("refused: %s\n" % res.get("why", "unknown"))
        return 1
    sys.stdout.write(USAGE + "\n")
    return 0 if cmd in ("-h", "--help", "help") else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
