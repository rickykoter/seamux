#!/usr/bin/env python3
"""Merge a machine-local overlay into a rendered crew config. Reads JSONC on
stdin, takes the overlay path as argv[1], writes strict JSON on stdout.

Why the comments are lost. The templates in config/ carry ~100 lines of
comments, and they are documentation for the TEMPLATE -- which is the file you
are told to edit. The generated artifact is not read by humans, and cmux parses
it either way. crew only calls this when an overlay actually exists, so a
machine without one keeps the commented output byte-for-byte.

Why `controls` merges by id. dock.json's controls are a list, and the whole
point of the overlay is to ADD one (a database watch, say) or amend one without
restating the other six. Every other list replaces wholesale, which is what you
want for something like hostsToOpenInEmbeddedBrowser.
"""
import json
import sys


def strip_jsonc(t):
    """Drop // and /* */ comments that are not inside a string.

    Character-by-character rather than a regex: the configs contain "https://"
    inside string values, and every regex that looked right ate those too.
    """
    out, i, n = [], 0, len(t)
    in_str = esc = False
    while i < n:
        c = t[i]
        if in_str:
            out.append(c)
            if esc:
                esc = False
            elif c == "\\":
                esc = True
            elif c == '"':
                in_str = False
            i += 1
            continue
        if c == '"':
            in_str = True
            out.append(c)
            i += 1
            continue
        if c == "/" and i + 1 < n and t[i + 1] == "/":
            while i < n and t[i] != "\n":
                i += 1
            continue
        if c == "/" and i + 1 < n and t[i + 1] == "*":
            i += 2
            while i + 1 < n and not (t[i] == "*" and t[i + 1] == "/"):
                i += 1
            i += 2
            continue
        out.append(c)
        i += 1
    return "".join(out)


def merge_controls(base, over):
    """Merge two control lists by `id`, base order first, extras appended."""
    by_id = {c["id"]: dict(c) for c in base if isinstance(c, dict) and "id" in c}
    order = [c["id"] for c in base if isinstance(c, dict) and "id" in c]
    for c in over:
        if not isinstance(c, dict) or "id" not in c:
            continue
        if c["id"] in by_id:
            by_id[c["id"]].update(c)
        else:
            by_id[c["id"]] = dict(c)
            order.append(c["id"])
    return [by_id[i] for i in order]


def merge(base, over, path=""):
    if isinstance(base, dict) and isinstance(over, dict):
        out = dict(base)
        for k, v in over.items():
            if k == "controls" and isinstance(v, list) and isinstance(base.get(k), list):
                out[k] = merge_controls(base[k], v)
            elif k in base:
                out[k] = merge(base[k], v, path + "." + k)
            else:
                out[k] = v
        return out
    # scalars and lists replace; dict-vs-scalar mismatches take the overlay
    return over


def main():
    if len(sys.argv) not in (2, 3):
        print("usage: crew-overlay <overlay.json> [display-name]  (template on stdin)",
              file=sys.stderr)
        return 2
    # crew passes the overlay through a process substitution so it gets
    # __HOME__ rendered too, which makes argv[1] a /dev/fd path. argv[2] is the
    # name to blame in an error message -- "/dev/fd/63 is not valid JSON" tells
    # nobody which file to go and fix.
    shown = sys.argv[2] if len(sys.argv) == 3 else sys.argv[1]
    try:
        base = json.loads(strip_jsonc(sys.stdin.read()))
    except ValueError as e:
        print("crew-overlay: the rendered template is not valid JSONC: %s" % e, file=sys.stderr)
        return 1
    try:
        with open(sys.argv[1], encoding="utf-8") as fh:
            over = json.loads(strip_jsonc(fh.read()))
    except (OSError, ValueError) as e:
        # Never silently ship an unmerged config: a typo in the overlay would
        # look exactly like "my overlay is being ignored", which is the bug
        # class this whole mechanism is meant to remove.
        print("crew-overlay: cannot read overlay %s: %s" % (shown, e), file=sys.stderr)
        return 1
    json.dump(merge(base, over), sys.stdout, indent=2)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
