#!/usr/bin/env python3
"""Print the directory Claude Code runs an installed plugin from.

    crew-plugin-root <plugin-name>       prints the root, or nothing (exit 1)

installed_plugins.json's `installPath` is not always that directory. For a
plugin whose marketplace is a local folder (`claude plugin marketplace add
<folder>`), Claude still records a cache copy there, but reads the plugin from
the folder itself (`claude plugin list` says "Read from:"). Copying from the
cache would install a snapshot that edits to the folder never reach. So:

    marketplace source is a directory  ->  its folder + the plugin's `source`
                                           from that folder's marketplace.json
    anything else                      ->  installPath

Used by `crew apply`, `crew doctor` and crew-feed; outside Claude, where no
CLAUDE_PLUGIN_ROOT exists. CLAUDE_CONFIG_DIR is honoured as Claude honours it.
"""
import json
import os
import sys


def _load(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh) or {}
    except (OSError, ValueError):
        return {}


def plugin_root(name, config_dir=None):
    cfg = config_dir or os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
    plugins = (_load(os.path.join(cfg, "plugins", "installed_plugins.json")).get("plugins") or {})
    markets = _load(os.path.join(cfg, "plugins", "known_marketplaces.json"))
    for key, installs in plugins.items():
        pname, _, market = key.partition("@")
        if pname != name:
            continue
        m = markets.get(market) or {}
        if (m.get("source") or {}).get("source") == "directory":
            folder = m.get("installLocation") or (m.get("source") or {}).get("path") or ""
            entries = (_load(os.path.join(folder, ".claude-plugin", "marketplace.json")).get("plugins") or [])
            for e in entries:
                src = e.get("source")
                if e.get("name") == name and isinstance(src, str):
                    root = os.path.normpath(os.path.join(folder, src))
                    if os.path.isdir(root):
                        return root
        for inst in installs or []:
            p = inst.get("installPath") or ""
            if p and os.path.isdir(p):
                return p
    return ""


if __name__ == "__main__":
    if len(sys.argv) != 2:
        print(__doc__.strip().splitlines()[2], file=sys.stderr)
        sys.exit(2)
    root = plugin_root(sys.argv[1])
    if root:
        print(root)
    sys.exit(0 if root else 1)
