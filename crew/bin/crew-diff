#!/usr/bin/env bash
# crew-diff — every diff worth looking at, one keystroke away.
#
#   crew-diff                  interactive picker (turn / branch / commits / …)
#   crew-diff turn             changes since Claude's last turn
#   crew-diff branch [base]    branch vs merge base (default origin/HEAD)
#   crew-diff unstaged
#   crew-diff staged
#   crew-diff pr               the open PR's full diff, vs its own base
#   crew-diff commit <ref>     one commit  (git show)
#   crew-diff range <a> <b>    a..b inclusive of b, exclusive of a
#   crew-diff <n>              the nth commit in the picker list
#
# Every source opens as a lookout review (plan cmux-shell-tools), on cmux and
# on the seamux app's own tmux alike: beside the pane it is run from, with
# files ranked by risk and threads on their lines. lookout's own sources cover
# most of them (--turn, --range); unstaged, staged and the PR go in as a patch
# file kept in crew's cache, so a second run refreshes the same review.

set -uo pipefail

LOOKOUT="${LOOKOUT_BIN:-$(command -v lookout 2>/dev/null || true)}"
[ -n "$LOOKOUT" ] || LOOKOUT="$HOME/.local/bin/lookout"
[ -x "$LOOKOUT" ] || { echo "crew-diff: lookout not found (./install.sh installs it)" >&2; exit 1; }
# cmux only closes the tab one of its actions opened (ephemeral_close below).
CMUX="${CREW_CMUX:-$(command -v cmux || true)}"
[ -n "$CMUX" ] || CMUX="$("$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/crew-cmux-bin" 2>/dev/null || true)"

REPO="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$REPO" ] || { echo "crew-diff: not inside a git repository" >&2; exit 1; }

BRANCH="$(git branch --show-current 2>/dev/null || echo HEAD)"

base_ref() {
  if [ -n "${1:-}" ]; then printf '%s' "$1"; return; fi
  local head
  head="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -n "$head" ]; then printf '%s' "$head"; return; fi
  for c in origin/master origin/main master main; do
    git rev-parse --verify --quiet "$c" >/dev/null 2>&1 && { printf '%s' "$c"; return; }
  done
  printf 'HEAD~1'
}

# The Claude session whose last turn to show. lookout --turn reads only
# CLAUDE_CODE_SESSION_ID, which a shell beside Claude does not have: on the
# app's tmux the pane file names the pane's session, and on cmux its hook
# store names the workspace's.
turn_session() {
  if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then printf '%s' "$CLAUDE_CODE_SESSION_ID"; return; fi
  python3 - "${XDG_CACHE_HOME:-$HOME/.cache}/cmux-crew/pane-${SEAMUX_PANE_ID:-}.json" \
    "$HOME/.cmuxterm/claude-hook-sessions.json" "${CMUX_WORKSPACE_ID:-}" "${SEAMUX_PANE_ID:-}" <<'PY' 2>/dev/null
import json, sys
pane_file, store, ws, pane = sys.argv[1:5]
def load(p):
    try:
        with open(p) as fh:
            return json.load(fh)
    except Exception:
        return {}
sid = (load(pane_file) or {}).get("session") if pane else ""
if not sid and ws:
    e = (load(store).get("activeSessionsByWorkspace") or {}).get(ws) or {}
    sid = e.get("sessionId")
print(sid or "", end="")
PY
}

show_turn() {
  local sid; sid="$(turn_session)"
  if [ -z "$sid" ]; then
    echo "crew-diff: no Claude session here (no CLAUDE_CODE_SESSION_ID, no pane file for SEAMUX_PANE_ID, no cmux session for this workspace); run it from the workspace's own pane" >&2
    return 1
  fi
  "$LOOKOUT" open --turn "$sid/last" --title "last turn · $BRANCH"
}

# A range as a lookout review: real commits, so threads anchor to them.
show_range() {  # <A..B or A...B> <title>
  "$LOOKOUT" open --range "$1" --title "$2"
}

# One commit: its parent to it; a root commit has no parent, so its patch.
show_commit() {  # <sha>
  if git rev-parse --verify --quiet "$1~1^{commit}" >/dev/null 2>&1; then
    show_range "$1~1..$1" "$(subject_of "$1")"
  else
    git show "$1" | show_patch "commit-$(git rev-parse --short "$1")" "$(subject_of "$1")"
  fi
}

# A patch on stdin as a lookout review. The file stays in crew's cache under
# a name for this checkout, branch and source: lookout reads it again when the
# review is rebuilt, and the same path is the same review next time. A hash
# of the checkout's path keeps two checkouts with one name apart.
show_patch() {  # <source> <title>
  local dir file
  dir="${XDG_CACHE_HOME:-$HOME/.cache}/cmux-crew/crew-diff"
  mkdir -p "$dir"
  local tag; tag="$(printf '%s' "$REPO" | shasum 2>/dev/null | cut -c1-8)"
  file="$dir/$(printf '%s-%s-%s-%s' "$(basename "$REPO")" "$tag" "$BRANCH" "$1" | tr -c 'A-Za-z0-9._-' '-').patch"
  cat > "$file"
  if [ ! -s "$file" ]; then
    rm -f "$file"
    echo "crew-diff: no changes for '$2'" >&2
    return 1
  fi
  "$LOOKOUT" open --patch "$file" --title "$2"
}

# A clean tree says so instead of opening an empty review you then have to
# close.
guard_nonempty() {  # <description> <git-diff-args...>
  local what="$1"; shift
  if [ -z "$(git diff --name-only "$@" 2>/dev/null | head -1)" ]; then
    echo "crew-diff: nothing $what" >&2
    exit 1
  fi
}

need_ref() {
  git rev-parse --verify --quiet "$1^{commit}" >/dev/null 2>&1 && return 0
  echo "crew-diff: '$1' is not a commit" >&2
  exit 1
}

commit_list() { git log --oneline --no-decorate "$(base_ref)..HEAD" 2>/dev/null; }

commit_at() {  # <n> -> sha
  commit_list | sed -n "${1}p" | cut -d' ' -f1
}

subject_of() { git log -1 --format='%h %s' "$1" 2>/dev/null; }

# ------------------------------------------------------------------ picker ---
picker() {
  local base n line sha subj count
  base="$(base_ref)"
  count="$(commit_list | wc -l | tr -d ' ')"

  printf '\n\033[1mDiffs\033[0m  \033[2m%s\033[0m\n\n' "$BRANCH"
  printf '  \033[36mt\033[0m  turn      \033[2mchanges since Claude'"'"'s last turn\033[0m\n'
  printf '  \033[36mb\033[0m  branch    \033[2mvs %s (%s commits)\033[0m\n' "$base" "$count"
  printf '  \033[36mu\033[0m  unstaged\n'
  printf '  \033[36ms\033[0m  staged\n'
  if command -v gh >/dev/null 2>&1; then
    printf '  \033[36mp\033[0m  pr        \033[2mthe open pull request\033[0m\n'
  fi
  printf '\n'

  n=0
  while IFS= read -r line; do
    n=$((n + 1))
    sha="${line%% *}"; subj="${line#* }"
    printf '  \033[36m%2d\033[0m  \033[33m%s\033[0m  %s\n' "$n" "$sha" "$subj"
    [ "$n" -ge 25 ] && { printf '      \033[2m… %s more\033[0m\n' "$((count - 25))"; break; }
  done < <(commit_list)

  printf '\n  \033[2mnumber, or a-b for a range, or a letter. Enter to cancel.\033[0m\n'
  printf '  pick: '
  read -r choice
  [ -n "${choice:-}" ] || exit 0

  case "$choice" in
    t) show_turn ;;
    b) dispatch branch ;;
    u) dispatch unstaged ;;
    s) dispatch staged ;;
    p) dispatch pr ;;
    *-*)
      local a b sa sb
      a="${choice%%-*}"; b="${choice##*-}"
      sa="$(commit_at "$a")"; sb="$(commit_at "$b")"
      # The list is newest-first, so a higher index is an older commit.
      [ -n "$sa" ] && [ -n "$sb" ] || { echo "crew-diff: bad range '$choice'" >&2; exit 1; }
      show_range "$sb~..$sa" "$(subject_of "$sb") … $(subject_of "$sa")"
      ;;
    ''|*[!0-9]*) echo "crew-diff: '$choice' is not a choice" >&2; exit 1 ;;
    *)
      sha="$(commit_at "$choice")"
      [ -n "$sha" ] || { echo "crew-diff: no commit $choice" >&2; exit 1; }
      show_commit "$sha"
      ;;
  esac
}

# ---------------------------------------------------------------- dispatch ---
dispatch() {
  case "${1:-}" in
    turn|t)      show_turn ;;
    branch|b)
      local b; b="$(base_ref "${2:-}")"
      guard_nonempty "on $BRANCH that $b does not have" "$b...HEAD"
      # The merge base to HEAD: committed work only, as cmux diff --branch
      # showed. Uncommitted work is unstaged and staged.
      show_range "$b...HEAD" "$BRANCH vs $b" ;;
    unstaged|u)
      guard_nonempty "unstaged"
      git diff | show_patch unstaged "unstaged · $BRANCH" ;;
    staged|s)
      guard_nonempty "staged" --cached
      git diff --cached | show_patch staged "staged · $BRANCH" ;;
    pr)
      command -v gh >/dev/null 2>&1 || { echo "crew-diff: gh not installed" >&2; exit 1; }
      local num; num="$(gh pr view --json number --jq .number 2>/dev/null || true)"
      [ -n "$num" ] || { echo "crew-diff: no open PR for $BRANCH" >&2; exit 1; }
      gh pr diff "$num" | show_patch "pr-$num" "PR #$num · $BRANCH"
      ;;
    commit|c)
      [ -n "${2:-}" ] || { echo "crew-diff commit <ref>" >&2; exit 1; }
      need_ref "$2"
      show_commit "$(git rev-parse "$2^{commit}")"
      ;;
    range|r)
      [ -n "${3:-}" ] || { echo "crew-diff range <from> <to>" >&2; exit 1; }
      need_ref "$2"; need_ref "$3"
      show_range "$2..$3" "$(subject_of "$2") … $(subject_of "$3")"
      ;;
    ''|pick)     picker ;;
    -h|--help)   sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
    *[!0-9]*)    echo "crew-diff: unknown '$1' (try --help)" >&2; exit 1 ;;
    *)
      local sha; sha="$(commit_at "$1")"
      [ -n "$sha" ] || { echo "crew-diff: no commit $1" >&2; exit 1; }
      show_commit "$sha"
      ;;
  esac
}

# cmux actions can only run a command in `currentTerminal` (which would type it
# into whatever is running there — Claude's prompt) or `newTabInCurrentPane`.
# There is no headless target, so an action always spawns a host tab. For
# fire-and-forget commands that tab is litter, so the action sets
# CREW_EPHEMERAL=1 and we close it once the work is done.
#
# Gated on the env var, never unconditional: run by hand from your own terminal,
# CREW_EPHEMERAL is unset and this does nothing. Reached only when dispatch
# succeeded — some failures return rather than exit, so the status is checked —
# and a failure leaves the tab up with the error in it.
ephemeral_close() {
  [ "${CREW_EPHEMERAL:-}" = "1" ] || return 0
  [ -n "${CMUX_SURFACE_ID:-}" ] && [ -n "$CMUX" ] || return 0
  "$CMUX" close-surface --surface "$CMUX_SURFACE_ID" >/dev/null 2>&1 || true
}

dispatch "$@" || exit $?
ephemeral_close
