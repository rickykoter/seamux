#!/usr/bin/env python3
"""crew-resume — find a workspace, live or not, and get back into it.

    crew-resume              finder, this repo first
    crew-resume --all        finder, every project
    crew-resume <query>      finder, pre-filtered
    crew-resume --reindex    force a full rebuild of the transcript cache
    crew-resume --rows-json  the finder's rows as JSON, in the order it would
                             show them for the query and scope, then exit;
                             live_known is false when cmux did not answer
    crew-resume --family-ok  ^A may archive what deep-plan protects, after a
                             y/N naming the family

One row per workspace, keyed by its directory, in one of four states:

    ●  live       open in cmux now                       ⏎ jumps to it
    ◒  archived   closed by crew's archive, remembered   ⏎ restores it as it was
    ○  past       the directory exists, nothing is open   ⏎ resumes its latest session
    ✕  gone       the directory was removed               ⏎ prints the transcript path

→ opens a row's sessions, where ⏎ resumes one in a new workspace and ^T resumes
it here — what this picker did for every row before it was a finder. ^A
archives a live row, ^X forgets an archived one. ^A refuses a workspace whose
directory holds live plan or family work (ADR 0031) and says whose; under
--family-ok it asks first instead, below the finder, and logs a yes.

Claude Code keeps one JSONL transcript per session under ~/.claude/projects;
there are hundreds of them here, and a dozen workspaces is what you are looking
for among them. The index and the archive live in crew/hooks/workspaces.py,
the one reader the sweep and the board share. Search is a fuzzy score per term
(subsequence, with bonuses for consecutive and word-start letters), then
state, then recency. Nothing here touches the network: Jev ranks the sweep,
never a keystroke (ADR 0023).

This is a TUI rather than part of the crew board because the custom-sidebar
interpreter has no @State and therefore no TextField. See FINDINGS.md.
"""

import curses
import json
import os
import shutil
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "hooks"))
import workspaces as W  # noqa: E402

CMUX = W.CMUX
STATES = ("live", "archived", "past", "gone")
MARK = {"live": "●", "archived": "◒", "past": "○", "gone": "✕"}
# curses colour pair per state: green, magenta, default, red.
TINT = {"live": 2, "archived": 5, "past": 7, "gone": 1}
WORD_START = " /-_.:#"


# --- pure: rows and the scorer (the probe imports these) -------------------------

def ago(ts):
    d = time.time() - ts
    if d < 3600:
        return f"{int(d // 60)}m"
    if d < 86400:
        return f"{int(d // 3600)}h"
    if d < 86400 * 14:
        return f"{int(d // 86400)}d"
    return time.strftime("%b %-d", time.localtime(ts))


label = W.label


def repo_of(cwd):
    return os.path.basename(cwd.rstrip("/")) if cwd else "?"


def short_branch(b):
    """Drop the owner prefix — every branch here starts dev/ or claude/."""
    if not b or b == "HEAD":
        return ""
    return b.split("/", 1)[1] if "/" in b else b


def build_rows(sessions, live, archived, isdir=os.path.isdir):
    """One row per directory: every live workspace, archive record and session cwd.

    State is decided in that order — live beats archived (a restored record that
    a crash left behind), archived beats past — and `gone` is a past whose
    directory no longer exists.
    """
    by_cwd = {}
    for s in sessions:
        if s.get("cwd"):
            by_cwd.setdefault(s["cwd"], []).append(s)
    for ss in by_cwd.values():
        ss.sort(key=lambda s: s.get("mtime") or 0, reverse=True)
    open_at = {}
    for w in live or []:
        if w.get("cwd"):
            open_at.setdefault(w["cwd"], w)

    rows = []
    for cwd in set(by_cwd) | set(open_at) | set(archived or {}):
        ss = by_cwd.get(cwd, [])
        ws, rec = open_at.get(cwd), (archived or {}).get(cwd)
        state = ("live" if ws else "archived" if rec else
                 "past" if isdir(cwd) else "gone")
        latest = ss[0] if ss else None
        when = max([(latest or {}).get("mtime") or 0, (rec or {}).get("archived_at") or 0])
        rows.append({
            "cwd": cwd,
            "state": state,
            "ws": ws,
            "rec": rec,
            "sessions": ss,
            "title": ((ws or {}).get("title") or (rec or {}).get("title") or repo_of(cwd)),
            "latest": label(latest) if latest else "",
            "branch": (latest or {}).get("branch") or (rec or {}).get("branch") or "",
            "when": when,
            "exists": state != "gone" and (state != "archived" or isdir(cwd)),
        })
    return rows


def fuzzy(term, text):
    """How well `term` reads as a subsequence of `text`; None when it does not.

    Every start position for the first letter is tried, and from each one the
    rest of the term is placed greedily at its leftmost spot; the best of those
    runs is kept, so "org" in "xo-organization" scores the word start, not the
    stray o. A letter scores 1, +3 when it follows the previous match directly,
    +2 at a word start.
    """
    term, low = term.lower(), text.lower()
    if not term:
        return 0
    best = None
    start = low.find(term[0])
    while start != -1:
        score, prev, i = 0, -2, start
        for ch in term:
            i = low.find(ch, i)
            if i == -1:
                score = None
                break
            score += 1 + (3 if i == prev + 1 else 0) + \
                (2 if i == 0 or low[i - 1] in WORD_START else 0)
            prev, i = i, i + 1
        if score is None:
            break                 # a later start cannot match what this one could not
        best = score if best is None else max(best, score)
        start = low.find(term[0], start + 1)
    return best


def score(terms, row):
    """Sum of each term's best field; None unless every term matches somewhere.

    Per field, not over one joined string: a subsequence across the seam of two
    fields is a match nobody meant. Only the short fields — the name, the
    directory's basename, the branch — are matched as subsequences. The latest
    session's title and the full path are prose and /Users/<name>/code/..., in
    which nearly any three letters appear in order, so those need the term as
    written. A session id prefix of four or more characters finds its row, as
    it always has.
    """
    short = (row["title"], repo_of(row["cwd"]), short_branch(row["branch"]))
    prose = (row["latest"].lower(), row["cwd"].lower())
    ids = [s.get("id") or "" for s in row.get("sessions") or []]
    total = 0
    for t in terms:
        hits = [s for s in (fuzzy(t, f) for f in short if f) if s is not None]
        hits += [len(t) for f in prose if t in f]
        if len(t) >= 4 and any(i.startswith(t) for i in ids):
            hits.append(6 * len(t))
        if not hits:
            return None
        total += max(hits)
    return total


def order(rows, terms):
    """The rows that match, by score, then state, then recency."""
    scored = []
    for r in rows:
        s = score(terms, r) if terms else 0
        if s is not None:
            scored.append((s, r))
    scored.sort(key=lambda p: (-p[0], STATES.index(p[1]["state"]), -p[1]["when"]))
    return [r for _, r in scored]


def rows_json(rows, query, scope_root):
    """What the picker would list first, for scripts and the probe: the same
    scope filter and order, the fields a row is judged by, no curses."""
    pool = [r for r in rows if r["cwd"].startswith(scope_root)] if scope_root else rows
    shown = order(pool, [t for t in query.lower().split() if t])
    return {"scope": scope_root, "total": len(rows), "rows": [
        {"cwd": r["cwd"], "state": r["state"], "title": r["title"], "latest": r["latest"],
         "branch": r["branch"], "when": r["when"], "exists": r["exists"],
         "ws": (r["ws"] or {}).get("id") or "",
         "sessions": [s.get("id") or "" for s in r["sessions"]]}
        for r in shown]}


def scope_of(cwd):
    """The repo family a directory belongs to: a worktree scopes to its
    siblings and the primary checkout."""
    try:
        top = subprocess.check_output(["git", "-C", cwd, "rev-parse", "--show-toplevel"],
                                      stderr=subprocess.DEVNULL, text=True).strip()
    except Exception:
        return ""
    return top.split(".worktrees")[0].split("/.claude/worktrees")[0] if top else ""


# --- the picker ---------------------------------------------------------------------

def _draw_list(stdscr, ui, rows, total, scope_root):
    h, w = stdscr.getmaxyx()
    body = h - 4
    ui["sel"] = max(0, min(ui["sel"], len(rows) - 1))
    if ui["sel"] < ui["top"]:
        ui["top"] = ui["sel"]
    elif ui["sel"] >= ui["top"] + body:
        ui["top"] = ui["sel"] - body + 1

    stdscr.erase()
    scoped = ui["scoped"] and scope_root
    scope_txt = f"this repo ({repo_of(scope_root)})" if scoped else "all projects"
    stdscr.addnstr(0, 0, "  crew resume", w - 1, curses.A_BOLD)
    stdscr.addnstr(0, 15, f"{len(rows)}/{total} workspaces · {scope_txt}", max(0, w - 16),
                   curses.color_pair(7))
    stdscr.addnstr(1, 0, "  search: " + ui["query"], w - 1, curses.A_BOLD)
    stdscr.addnstr(1, min(w - 2, 10 + len(ui["query"])), "▏", 1, curses.color_pair(6))
    if ui.get("flash"):
        stdscr.addnstr(2, 2, ui["flash"][: w - 3], w - 3, curses.color_pair(3))

    for i, r in enumerate(rows[ui["top"]:ui["top"] + body]):
        y = i + 3
        attr = curses.A_REVERSE if (ui["top"] + i) == ui["sel"] else 0
        stdscr.addnstr(y, 0, " " * (w - 1), w - 1, attr)
        stdscr.addnstr(y, 2, MARK[r["state"]], 1, attr | curses.color_pair(TINT[r["state"]]))
        stdscr.addnstr(y, 4, (ago(r["when"]) if r["when"] else "").rjust(6), 6,
                       attr | curses.color_pair(7))
        # A worktree's directory name and its branch are usually the same
        # string. Inside one repo the branch is the useful half; across repos
        # the directory is.
        loc = (short_branch(r["branch"]) or repo_of(r["cwd"])) if scoped else repo_of(r["cwd"])
        stdscr.addnstr(y, 12, loc[:26].ljust(26), 26,
                       attr | curses.color_pair(1 if not r["exists"] else 4))
        text = r["title"] if r["title"] != loc else ""
        if r["latest"]:
            text = (text + " — " if text else "") + r["latest"]
        tw = max(0, w - 41)
        stdscr.addnstr(y, 40, text[:tw], tw, attr)

    keys = {"live": "⏎ jump · ^A archive", "archived": "⏎ restore · ^X forget",
            "past": "⏎ resume latest", "gone": "⏎ transcript"}
    here = keys[rows[ui["sel"]]["state"]] if rows else ""
    hint = f"  ↑↓ · {here} · ^T resume here · → sessions · ⇥ scope · ^R reindex · esc"
    stdscr.addnstr(h - 1, 0, hint[: w - 1], w - 1, curses.color_pair(7))
    stdscr.refresh()
    return body


def _draw_sessions(stdscr, row, sel):
    h, w = stdscr.getmaxyx()
    body = h - 4
    ss = row["sessions"]
    top = max(0, sel - body + 1)
    stdscr.erase()
    stdscr.addnstr(0, 0, "  " + row["title"], w - 1, curses.A_BOLD)
    stdscr.addnstr(1, 2, f"{len(ss)} session(s) · {row['cwd']}", w - 3, curses.color_pair(7))
    for i, s in enumerate(ss[top:top + body]):
        y = i + 3
        attr = curses.A_REVERSE if (top + i) == sel else 0
        stdscr.addnstr(y, 0, " " * (w - 1), w - 1, attr)
        stdscr.addnstr(y, 2, ago(s["mtime"]).rjust(6), 6, attr | curses.color_pair(7))
        stdscr.addnstr(y, 10, s["id"][:8], 8, attr | curses.color_pair(4))
        tw = max(0, w - 21)
        stdscr.addnstr(y, 20, label(s)[:tw], tw, attr)
    hint = "  ↑↓ · ⏎ resume in new workspace · ^T resume here · ← back"
    stdscr.addnstr(h - 1, 0, hint[: w - 1], w - 1, curses.color_pair(7))
    stdscr.refresh()


def sessions_view(stdscr, row):
    sel = 0
    while True:
        _draw_sessions(stdscr, row, sel)
        try:
            ch = stdscr.get_wch()
        except (curses.error, KeyboardInterrupt):
            return None
        if ch in ("\x1b", curses.KEY_LEFT):
            return None
        if ch in (curses.KEY_UP, "\x10"):
            sel = max(0, sel - 1)
        elif ch in (curses.KEY_DOWN, "\x0e"):
            sel = min(len(row["sessions"]) - 1, sel + 1)
        elif ch in ("\n", "\r", curses.KEY_ENTER):
            return ("workspace", row["sessions"][sel])
        elif ch == "\x14":                       # ^T
            return ("here", row["sessions"][sel])


def picker(stdscr, rows, ui, scope_root):
    curses.use_default_colors()
    for i in range(1, 8):
        curses.init_pair(i, i, -1)
    curses.curs_set(0)
    stdscr.keypad(True)

    while True:
        pool = [r for r in rows if r["cwd"].startswith(scope_root)] \
            if (ui["scoped"] and scope_root) else rows
        shown = order(pool, [t for t in ui["query"].lower().split() if t])
        body = _draw_list(stdscr, ui, shown, len(rows), scope_root)
        try:
            ch = stdscr.get_wch()
        except (curses.error, KeyboardInterrupt):
            return None
        cur = shown[ui["sel"]] if shown else None
        if ch != "\x12":
            ui["flash"] = ""

        if ch == "\x1b":
            return None
        if ch in (curses.KEY_UP, "\x10"):
            ui["sel"] -= 1
        elif ch in (curses.KEY_DOWN, "\x0e"):
            ui["sel"] += 1
        elif ch == curses.KEY_NPAGE:
            ui["sel"] += body
        elif ch == curses.KEY_PPAGE:
            ui["sel"] -= body
        elif ch == "\t":
            ui.update(scoped=not ui["scoped"], sel=0, top=0)
        elif ch == "\x12":                       # ^R
            return ("reindex", None)
        elif ch == curses.KEY_RIGHT:
            if cur and cur["sessions"]:
                picked = sessions_view(stdscr, cur)
                if picked:
                    return picked
            elif cur:
                ui["flash"] = "no Claude sessions recorded for " + cur["title"]
        elif ch in ("\n", "\r", curses.KEY_ENTER):
            if cur:
                return ("open", cur)
        elif ch == "\x14":                       # ^T: the latest session, here
            if cur and cur["sessions"]:
                return ("here", cur["sessions"][0])
            if cur:
                ui["flash"] = "no Claude sessions recorded for " + cur["title"]
        elif ch == "\x01":                       # ^A
            if cur and cur["state"] == "live":
                return ("archive", cur)
            if cur:
                ui["flash"] = "only a live workspace can be archived"
        elif ch == "\x18":                       # ^X
            if cur and cur["state"] == "archived":
                return ("forget", cur)
            if cur:
                ui["flash"] = "only an archived record can be forgotten"
        elif ch in ("\x7f", curses.KEY_BACKSPACE, "\b"):
            ui.update(query=ui["query"][:-1], sel=0)
        elif isinstance(ch, str) and ch.isprintable():
            ui.update(query=ui["query"] + ch, sel=0)
        ui["sel"] = max(0, ui["sel"])


# --- what a pick does ----------------------------------------------------------------

def close_ephemeral():
    """A cmux action has no headless target, so it spawned a tab to host this
    picker. Once the pick lives in its own workspace that tab is litter. Only
    when the action set the flag — run by hand, this would be closing the
    terminal you typed in."""
    surface = os.environ.get("CMUX_SURFACE_ID")
    if os.environ.get("CREW_EPHEMERAL") == "1" and surface:
        subprocess.call([CMUX, "close-surface", "--surface", surface],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def resume(mode, s):
    cwd = s.get("cwd") or ""
    if not os.path.isdir(cwd):
        # Worktrees get removed and the session outlives them. Don't guess at a
        # substitute cwd: Claude keys sessions by project directory, so resuming
        # from elsewhere is not reliably the same session. The project directory
        # name cannot be decoded back to a path either — the encoding replaces
        # "/" with "-" and real names contain hyphens — so print it verbatim.
        print(f"crew-resume: {cwd or '(unknown cwd)'} no longer exists —"
              " that worktree was removed.", file=sys.stderr)
        print(f"  transcript: {s['path']}", file=sys.stderr)
        print(f"  to read it anyway:  claude --resume {s['id']}"
              "   (from a checkout of the same repo)", file=sys.stderr)
        return 1

    cmd = f"claude --resume {s['id']}"
    if mode == "here":
        print(f"→ {cwd}")
        print(f"→ {cmd}")
        os.chdir(cwd)
        return subprocess.call(["claude", "--resume", s["id"]])

    # A native session (cmux local-tmux, which the seamux app draws too), as
    # every new session starts; cmux's own terminal when seamux is missing or
    # opened no workspace.
    seamux = shutil.which("seamux")
    rc = 1
    if seamux:
        rc = subprocess.call([seamux, "crew-native", "workspace", "--cwd", cwd,
                              "--command", cmd, "--focus"],
                             stdout=subprocess.DEVNULL,
                             env=dict(os.environ, **({"CMUX_BIN": CMUX} if CMUX else {})))
    if rc != 0:
        rc = subprocess.call([
            CMUX, "new-workspace", "--cwd", cwd, "--command", cmd, "--focus", "true"
        ], stdout=subprocess.DEVNULL, env=dict(os.environ, CMUX_QUIET="1"))
    if rc == 0:
        print(f"✓ resumed {s['id'][:8]} in a new workspace — {label(s)[:60]}")
        close_ephemeral()      # ("here" never closes: Claude has taken this very tab)
    return rc


def open_row(r):
    """⏎ on a workspace row, by its state."""
    if r["state"] == "live":
        if not W.select(r["ws"]["id"]):
            print(f"crew-resume: cmux would not switch to {r['title']}", file=sys.stderr)
            return 1
        print(f"✓ {r['title']}")
        close_ephemeral()
        return 0
    if r["state"] == "archived":
        ok, msg = W.restore(r["cwd"])
        print(("✓ " if ok else "crew-resume: ") + msg, file=sys.stdout if ok else sys.stderr)
        if ok:
            close_ephemeral()
        return 0 if ok else 1
    if not r["sessions"]:
        print(f"crew-resume: no Claude session recorded at {r['cwd']}", file=sys.stderr)
        return 1
    return resume("workspace", r["sessions"][0])


def main():
    args = sys.argv[1:]
    force = "--reindex" in args
    show_all = "--all" in args
    family_ok = "--family-ok" in args
    query = " ".join(a for a in args if not a.startswith("--"))

    if not os.path.isdir(W.PROJECTS):
        print("crew-resume: no ~/.claude/projects", file=sys.stderr)
        return 1
    scope_root = "" if show_all else scope_of(os.getcwd())
    ui = {"query": query, "scoped": True, "sel": 0, "top": 0, "flash": ""}

    while True:
        t0 = time.time()
        sessions, seen = W.build_index(force)
        if force:
            # On stderr under --rows-json, where stdout is the JSON alone.
            print(f"indexed {seen} transcripts in {time.time() - t0:.1f}s",
                  file=sys.stderr if "--rows-json" in args else sys.stdout)
        force = False
        live = W.live_workspaces()
        if live is None:
            # "Could not tell" is not "nothing is open": say so, or a live
            # workspace reads as past and ⏎ opens a second one on it.
            ui["flash"] = ui.get("flash") or \
                "✗ cmux did not list its workspaces — open ones show as past or archived"
        rows = build_rows(sessions, live or [], W.load_archive())

        if "--rows-json" in args:
            print(json.dumps(dict(rows_json(rows, query, scope_root), live_known=live is not None),
                             indent=1))
            return 0

        result = curses.wrapper(picker, rows, ui, scope_root)
        if result is None:
            return 0
        mode, r = result
        if mode == "reindex":
            force = True
        elif mode == "archive":
            if r["ws"]["id"] == os.environ.get("CMUX_WORKSPACE_ID"):
                ui["flash"] = "that is this terminal's workspace — archive it from elsewhere"
            else:
                ok, msg = W.archive(r["ws"]["id"], family_ok=family_ok)
                ui["flash"] = ("✓ " if ok else "✗ ") + msg
        elif mode == "forget":
            W.forget(r["cwd"])
            ui["flash"] = "✓ forgot " + r["title"]
        elif mode == "open":
            return open_row(r)
        else:
            return resume(mode, r)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
